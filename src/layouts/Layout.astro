---
import HeaderNav from '../components/HeaderNav.astro';
import Sidebar from '../components/Sidebar.astro';
import ProfileModal from '../components/ProfileModal.astro';
import GuestLoginPrompt from '../components/GuestLoginPrompt.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
  activePage?: string;
  hideSidebar?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogImageAlt?: string;
  canonicalUrl?: string;
}

const defaultKeywords = "free youtube courses, best free youtube courses with certificate, youtube learning roadmap, free curated youtube courses, youtube course directory, best youtube channels to learn tech skills, learn prompt engineering youtube free, best youtube course for machine learning, free python ai course youtube, llm developer roadmap youtube, best youtube channel for artificial intelligence tutorial, davinci resolve full course youtube free, best youtube course to learn premiere pro, capcut desktop full editing tutorial youtube, best youtube channel to learn color grading, free motion graphics roadmap youtube, best youtube course for web development, python full course for beginners youtube roadmap, learn full stack development on youtube free, javascript tutorial playlist for beginners, best youtube channel to learn react js";

const { 
  title = "Free YouTube Courses & Structured Learning Roadmaps | FreeYTCourses", 
  description = "Discover the best free YouTube courses for AI engineering, video editing, and coding. Explore curated YouTube courses, detailed syllabi, and structured free online learning roadmaps—100% free.",
  keywords = defaultKeywords,
  ogImage = "/og-banner.jpg",
  ogType = "website",
  activePage = 'home',
  hideSidebar = false,
  ogTitle,
  ogDescription,
  ogImageAlt = "FreeYTCourses homepage showing curated free YouTube courses and learning roadmaps.",
  canonicalUrl
} = Astro.props;

const isAdmin = activePage === 'admin';
const siteUrl = Astro.url.origin;
const fullCanonicalUrl = canonicalUrl || Astro.url.href;
const pageTitle = title.includes("FreeYTCourses") ? title : `${title} | FreeYTCourses`;
const finalOgTitle = ogTitle || pageTitle;
const finalOgDescription = ogDescription || description;
const finalOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const finalKeywords = keywords;
---
<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={finalKeywords} />
		<link rel="canonical" href={fullCanonicalUrl} />

		<!-- Open Graph (OG) & Social Sharing Metadata -->
		<meta property="og:title" content={finalOgTitle} />
		<meta property="og:description" content={finalOgDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={fullCanonicalUrl} />
		<meta property="og:site_name" content="FreeYTCourses" />
		<meta property="og:image" content={finalOgImage} />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter Card Metadata -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={finalOgTitle} />
		<meta name="twitter:description" content={finalOgDescription} />
		<meta name="twitter:image" content={finalOgImage} />

		<!-- JSON-LD Structured Data Schema -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "FreeYTCourses",
			"url": siteUrl,
			"description": description,
			"potentialAction": {
				"@type": "SearchAction",
				"target": `${siteUrl}/courses?q={search_term_string}`,
				"query-input": "required name=search_term_string"
			}
		})} />

		<!-- Google Fonts Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Instant inline script to restore theme and sidebar toggle state without FOUC -->
    <script is:inline>
      (function() {
        var savedTheme = localStorage.getItem('freeyt_theme') || 'dark';
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
        var savedState = localStorage.getItem('freeyt_sidebar_state');
        var isDesktop = window.innerWidth >= 768;
        var state = savedState || (isDesktop ? 'expanded' : 'collapsed');
        document.documentElement.setAttribute('data-sidebar-state', state);
        document.documentElement.setAttribute('data-sidebar-mobile', 'closed');
      })();
    </script>
	</head>
	<body class="bg-canvas text-ink font-sans selection:bg-primary/30 selection:text-primary min-h-screen flex flex-col">
    <!-- Top YouTube Header Navbar -->
    <HeaderNav activePage={activePage} hideSidebarToggle={hideSidebar} />
    
    <!-- Collapsible YouTube Left Sidebar -->
    {!hideSidebar && <Sidebar activePage={activePage} />}

    <!-- Main Page Content Wrapper with Responsive Margin Shift -->
    <div class={`page-main-layout flex-1 pt-[60px] flex flex-col justify-between transition-all duration-200 ease-in-out ${hideSidebar ? 'no-sidebar !pl-0' : ''}`}>
      <div class="flex-1">
        <slot />
      </div>
      <Footer activePage={activePage} />
    </div>

    <!-- Global User Profile Modal & Guest Login Prompt (Only on learner pages) -->
    {!isAdmin && <ProfileModal />}
    {!isAdmin && <GuestLoginPrompt activePage={activePage} />}
	</body>
</html>
