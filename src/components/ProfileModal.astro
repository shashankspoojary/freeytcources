---
---

<!-- YouTube-Style User Accounts Modal Component -->
<div 
  id="user-profile-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 hidden"
>
  <div id="user-profile-card" class="bg-canvas border border-hairline rounded-md p-5 max-w-sm w-full mx-4 shadow-2xl space-y-4 transform scale-95 transition-all duration-300">
    
    <!-- Modal Header: YouTube Style ← Accounts -->
    <div class="flex items-center justify-between border-b border-hairline/80 pb-3">
      <div class="flex items-center gap-2.5">
        <button 
          id="close-profile-modal-btn" 
          type="button" 
          class="text-ink hover:text-primary transition-colors p-1 rounded-sm cursor-pointer border-none bg-transparent"
          aria-label="Close Accounts Modal"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </button>
        <h2 class="text-base font-bold text-ink-strong tracking-wide font-sans">
          Accounts
        </h2>
      </div>
    </div>

    <!-- Accounts List Container (Populated dynamically) -->
    <div id="accounts-list-container" class="space-y-2 max-h-64 overflow-y-auto scrollbar-thin pr-1">
      <!-- Active & Saved Accounts rendered here -->
    </div>

    <!-- Edit Display Name (Collapsible) -->
    <div class="pt-2 border-t border-hairline/60 space-y-2">
      <div class="flex justify-between items-center text-xs font-mono">
        <span class="text-mute font-semibold">Display Name</span>
        <button id="toggle-edit-name-btn" type="button" class="text-primary hover:underline text-[11px] cursor-pointer bg-transparent border-none">Edit Name</button>
      </div>
      <div id="edit-name-form-row" class="hidden flex gap-2">
        <input 
          type="text" 
          id="profile-name-input" 
          class="flex-1 bg-canvas border border-hairline text-ink rounded-sm px-3 py-1.5 text-xs font-mono focus:outline-none focus:border-primary" 
          placeholder="Enter new display name..."
        />
        <button id="save-name-btn" type="button" class="bg-primary text-on-primary font-mono text-xs font-bold px-3 py-1.5 rounded-sm hover:bg-primary-soft cursor-pointer">Save</button>
      </div>
    </div>

    <!-- YouTube-Style Actions Footer: Add Account & Sign Out -->
    <div class="border-t border-hairline/80 pt-2 space-y-0.5">
      <button 
        id="profile-add-account-btn" 
        type="button" 
        class="w-full flex items-center gap-3.5 px-3 py-2.5 rounded-md text-xs font-mono text-ink hover:bg-canvas-soft transition-colors cursor-pointer border-none bg-transparent group"
      >
        <svg class="h-5 w-5 text-mute group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        <span class="font-medium text-body group-hover:text-ink">Add account</span>
      </button>

      <button 
        id="profile-logout-btn" 
        type="button" 
        class="w-full flex items-center gap-3.5 px-3 py-2.5 rounded-md text-xs font-mono text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer border-none bg-transparent group"
      >
        <svg class="h-5 w-5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span class="font-medium">Sign out</span>
      </button>
    </div>

  </div>
</div>

<script>
  function initProfileModal() {
    const modal = document.getElementById('user-profile-modal');
    const card = document.getElementById('user-profile-card');
    const closeBtn = document.getElementById('close-profile-modal-btn');
    const logoutBtn = document.getElementById('profile-logout-btn');
    const addAccountBtn = document.getElementById('profile-add-account-btn');
    const accountsContainer = document.getElementById('accounts-list-container');

    const toggleEditBtn = document.getElementById('toggle-edit-name-btn');
    const editRow = document.getElementById('edit-name-form-row');
    const nameInput = document.getElementById('profile-name-input') as HTMLInputElement;
    const saveNameBtn = document.getElementById('save-name-btn');

    function getUserSession() {
      try {
        const raw = localStorage.getItem('freeyt_user_auth');
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function getSavedAccounts() {
      try {
        const raw = localStorage.getItem('freeyt_saved_accounts');
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function renderAccountsList() {
      if (!accountsContainer) return;
      accountsContainer.innerHTML = '';

      const activeUser = getUserSession();
      let saved = getSavedAccounts();
      if (!Array.isArray(saved)) saved = [];

      // Ensure active user is included in saved accounts
      if (activeUser) {
        const exists = saved.some((a: any) => a.email === activeUser.email || a.uid === activeUser.uid);
        if (!exists) {
          saved.push(activeUser);
          localStorage.setItem('freeyt_saved_accounts', JSON.stringify(saved));
        }
      }

      if (saved.length === 0 && activeUser) {
        saved = [activeUser];
      }

      saved.forEach((acc: any) => {
        const isActive = activeUser && (acc.email === activeUser.email || acc.uid === activeUser.uid);
        const displayName = acc.displayName || acc.email?.split('@')[0] || 'Learner';
        const email = acc.email || 'user@example.com';
        const initial = displayName.charAt(0).toUpperCase();

        const item = document.createElement('div');
        item.className = `account-item flex items-center justify-between p-3 rounded-md border transition-all cursor-pointer ${
          isActive 
            ? 'bg-canvas-soft border-primary/50 text-ink' 
            : 'bg-canvas border-hairline/60 hover:border-primary/40 hover:bg-canvas-soft/60 text-body'
        }`;

        item.innerHTML = `
          <div class="flex items-center gap-3 overflow-hidden">
            <div class="h-10 w-10 rounded-full bg-primary/15 border border-primary/30 text-primary font-bold text-sm flex items-center justify-center shrink-0 overflow-hidden">
              ${acc.photoURL ? `<img src="${acc.photoURL}" class="h-full w-full object-cover" onerror="this.parentElement.innerHTML = '<span>${initial}</span>';" />` : `<span>${initial}</span>`}
            </div>
            <div class="truncate">
              <h3 class="text-xs font-bold text-ink-strong truncate">${displayName}</h3>
              <p class="text-[11px] font-mono text-mute truncate">${email}</p>
            </div>
          </div>
          ${isActive ? `
            <svg class="h-5 w-5 text-primary shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          ` : ''}
        `;

        if (!isActive) {
          item.addEventListener('click', () => {
            localStorage.setItem('freeyt_user_auth', JSON.stringify(acc));
            window.dispatchEvent(new CustomEvent('userAuthChanged', { detail: acc }));
            closeModal();
            window.location.reload();
          });
        }

        accountsContainer.appendChild(item);
      });
    }

    function openModal() {
      const user = getUserSession();
      if (!user) {
        window.location.href = '/login';
        return;
      }

      if (nameInput) nameInput.value = user.displayName || '';
      renderAccountsList();

      if (modal && card) {
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.add('opacity-100', 'pointer-events-auto');
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }, 50);
      }
    }

    function closeModal() {
      if (!modal || !card) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        if (editRow) editRow.classList.add('hidden');
      }, 300);
    }

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    toggleEditBtn?.addEventListener('click', () => {
      if (editRow) editRow.classList.toggle('hidden');
    });

    saveNameBtn?.addEventListener('click', () => {
      const newName = nameInput?.value.trim();
      if (!newName) return;
      const user = getUserSession();
      if (user) {
        user.displayName = newName;
        localStorage.setItem('freeyt_user_auth', JSON.stringify(user));
        
        let saved = getSavedAccounts();
        const idx = saved.findIndex((a: any) => a.email === user.email || a.uid === user.uid);
        if (idx >= 0) {
          saved[idx].displayName = newName;
          localStorage.setItem('freeyt_saved_accounts', JSON.stringify(saved));
        }

        renderAccountsList();
        if (editRow) editRow.classList.add('hidden');
        window.dispatchEvent(new CustomEvent('userAuthChanged', { detail: user }));
      }
    });

    addAccountBtn?.addEventListener('click', () => {
      localStorage.removeItem('freeyt_user_auth');
      window.dispatchEvent(new CustomEvent('userAuthChanged', { detail: null }));
      closeModal();
      window.location.href = '/login';
    });

    logoutBtn?.addEventListener('click', () => {
      localStorage.removeItem('freeyt_user_auth');
      window.dispatchEvent(new CustomEvent('userAuthChanged', { detail: null }));
      closeModal();
      window.location.reload();
    });

    // Handle any elements triggering profile open
    document.querySelectorAll('[data-open-profile="true"]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    window.addEventListener('openUserProfileModal', openModal);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProfileModal);
  } else {
    initProfileModal();
  }
</script>
