---
import Layout from '../layouts/Layout.astro';
import { getAllCourses, getYoutubeThumbnail, getCreatorSlug } from '../lib/firebase.js';
import { scoreCourse } from '../lib/searchEngine.js';

// 1. Query Parameter Extraction
const searchQuery = Astro.url.searchParams.get('search_query') || Astro.url.searchParams.get('q') || '';

// 2. Fetch and Score Courses
const allCourses = await getAllCourses();

function calculateCourseRank(course: any): number {
  if (!course) return 0;
  const siteViews = 10; // Placeholder or use dynamic
  const featuredBonus = course.featured ? 25 : 0;
  const siteViewsScore = Math.min((siteViews || 0) * 10, 50);
  const year = typeof course.publishedYear === 'number' 
    ? course.publishedYear 
    : (course.publishDate ? new Date(course.publishDate).getFullYear() : 0);
  const recencyScore = year >= 2025 ? 25 : 15;
  return featuredBonus + siteViewsScore + recencyScore;
}

let scoredMatches: any[] = [];

if (searchQuery.trim().length > 0) {
  scoredMatches = allCourses
    .filter(course => course.isEmbeddable !== false)
    .map(c => {
      const score = scoreCourse(c, searchQuery, calculateCourseRank);
      return { course: c, score: score };
    })
    .filter(item => item.score > 0)
    .sort((a, b) => b.score - a.score)
    .map(item => item.course);
}

// Dynamic SEO
const title = `"${searchQuery}" - FreeYTCourses Search`;
const description = `Search results for ${searchQuery} on FreeYTCourses. Find the best YouTube tutorials and courses.`;
---

<Layout title={title} description={description} activePage="results">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 md:py-8 min-h-screen">
    
    <!-- YouTube-style Filter Button and Panel -->
    <div class="mb-6">
      <button type="button" id="filter-toggle-btn" class="inline-flex items-center gap-2 bg-canvas hover:bg-canvas-soft text-ink-strong px-4 py-2 rounded-full border border-hairline transition-colors text-sm font-semibold cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary group shadow-sm">
        Filters
        <svg class="h-4 w-4 text-mute group-hover:text-ink-strong transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
      </button>

      <div id="filter-panel" class="hidden border-t border-hairline pt-6 mt-6">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
          
          <!-- Category -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Category</h4>
            <div class="flex flex-col gap-3" id="category-filter-list">
              <button type="button" class="filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none" data-filter="all">All Results</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter="ai">AI & ML</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter="web">Web Development</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter="video">Video Editing</button>
            </div>
          </div>

          <!-- Features -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Features</h4>
            <div class="flex flex-col gap-3" id="features-filter-list">
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter="top-rated">⭐ Top Rated</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter="playlists">Playlists Only</button>
            </div>
          </div>
          
        </div>
      </div>
    </div>

    <!-- Results Container -->
    <div id="results-container" class="flex flex-col gap-6 w-full max-w-4xl mx-auto">
      {scoredMatches.length > 0 ? (
        scoredMatches.map((course) => (
          <article 
            class="result-card group flex flex-col md:flex-row gap-4 mb-4 relative cursor-pointer items-start" 
            data-slug={course.slug}
            data-category={course.category}
            data-rating={course.rating || 0}
            data-module-type={course.chapters?.length > 1 ? 'multi' : 'single'}
          >
            <!-- Left Column: Thumbnail Container -->
            <div class="thumb-container relative aspect-video overflow-hidden rounded-xl bg-canvas-soft">
              <img 
                src={course.thumbnail || getYoutubeThumbnail(course.sampleVideoId)} 
                alt={course.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                loading="lazy" 
              />
              
              <!-- Play overlay on hover -->
              <div class="absolute inset-0 bg-ink/30 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity duration-300">
                <div class="bg-primary/90 text-on-primary rounded-full p-3 shadow-lg transform scale-90 group-hover:scale-100 transition-transform duration-300">
                  <svg class="h-6 w-6 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  </svg>
                </div>
              </div>
              <!-- Duration Badge and Progress Bar -->
              <div class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded text-white font-bold tracking-wide z-10 pointer-events-none shadow" style="background-color: rgba(0, 0, 0, 0.85); font-size: 11px; line-height: 1.2;">
                {course.duration || '4:15:20'}
              </div>
              <!-- Simulated Youtube Red Progress Bar -->
              {Math.random() > 0.5 && (
                <div class="absolute bottom-0 left-0 w-full h-1 bg-white/20">
                  <div class="h-full bg-red-600" style={`width: ${Math.floor(Math.random() * 80) + 10}%`}></div>
                </div>
              )}
            </div>

            <!-- Right Column: Course Details -->
            <div class="flex-1 flex flex-col justify-start min-w-0 py-1">
              <h3 class="text-lg sm:text-xl font-normal text-ink leading-tight mb-1 group-hover:text-primary transition-colors" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{course.title}</h3>
              
              <!-- Meta Line -->
              <div class="flex items-center text-xs text-mute mb-3">
                <span>{(course.views || 0).toLocaleString()} views</span>
                <span class="mx-1.5">&bull;</span>
                <span>{course.publishedYear || new Date(course.publishDate || Date.now()).getFullYear()}</span>
              </div>

              <!-- Creator Info -->
              <a href={`/creators/${getCreatorSlug(course.creatorName)}`} class="flex items-center gap-2 hover:text-ink transition-colors w-max mb-3 relative z-10" onclick="event.stopPropagation();">
                <img src={course.creatorLogo} alt={course.creatorName} class="h-6 w-6 rounded-full object-cover shrink-0 bg-canvas-soft" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=random&color=fff';" />
                <span class="text-xs text-mute font-medium flex items-center gap-1 hover:text-ink transition-colors">
                  {course.creatorName}
                  <svg class="h-3.5 w-3.5 text-mute" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                </span>
              </a>

              <!-- Snippet / Summary -->
              <p class="text-xs text-mute leading-relaxed mb-3 hidden sm:block" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{course.overview || course.description}</p>

              <!-- Tool Tags / Badges -->
              <div class="flex flex-wrap gap-1.5 mb-2">
                <span class="text-[10px] bg-canvas-soft text-mute px-1.5 py-0.5 rounded-sm font-medium">CC</span>
                {Array.isArray(course.tools) && course.tools.slice(0, 3).map((tool: string) => (
                  <span class="text-[10px] bg-canvas-soft text-mute px-1.5 py-0.5 rounded-sm font-medium">{tool}</span>
                ))}
              </div>

              <!-- Chapters Box (if applicable) -->
              {course.chapters?.length > 1 && (
                <div class="mt-auto bg-canvas-soft/60 hover:bg-canvas-soft rounded-full py-1.5 px-3 flex items-center gap-2 text-xs text-mute relative z-10 w-fit transition-colors cursor-pointer group/chapter">
                  <span class="font-semibold text-ink group-hover/chapter:text-primary transition-colors whitespace-nowrap">{course.chapters.length} chapters</span>
                  <span class="line-clamp-1">{course.chapters[0]?.title || course.title}</span>
                  <svg class="h-4 w-4 ml-auto shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </div>
              )}
              
              <!-- Hidden link to make whole card clickable safely -->
              <a href={`/courses/${course.slug}`} class="absolute inset-0 z-0 opacity-0"><span class="sr-only">View Course</span></a>
            </div>
          </article>
        ))
      ) : (
        <div class="py-16 md:py-24 text-center px-4">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-canvas-soft border border-hairline/60 mb-6">
            <svg class="h-10 w-10 text-mute/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-ink mb-3">No results found for "{searchQuery}"</h2>
          <p class="text-mute max-w-md mx-auto mb-8 text-sm sm:text-base leading-relaxed">
            Try searching for different keywords, software tools (e.g., Python, DaVinci Resolve, React), or creator names.
          </p>
          <div class="flex flex-wrap justify-center gap-3 max-w-2xl mx-auto">
            <span class="text-xs font-mono uppercase text-mute/80 w-full mb-2">Trending Searches</span>
            <a href="/results?search_query=react" class="text-sm bg-canvas-soft hover:bg-hairline/50 text-ink px-4 py-2 rounded-full border border-hairline transition-colors">React</a>
            <a href="/results?search_query=python" class="text-sm bg-canvas-soft hover:bg-hairline/50 text-ink px-4 py-2 rounded-full border border-hairline transition-colors">Python</a>
            <a href="/results?search_query=ai" class="text-sm bg-canvas-soft hover:bg-hairline/50 text-ink px-4 py-2 rounded-full border border-hairline transition-colors">AI Engineering</a>
            <a href="/results?search_query=video+editing" class="text-sm bg-canvas-soft hover:bg-hairline/50 text-ink px-4 py-2 rounded-full border border-hairline transition-colors">Video Editing</a>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .thumb-container {
    width: 100%;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .thumb-container {
      width: 360px;
      min-width: 360px;
      max-width: 360px;
    }
  }
</style>
<script>
  // Client-side filtering logic for the panel
  function initResultsFilter() {
    const filterPanel = document.getElementById('filter-panel');
    const filterToggleBtn = document.getElementById('filter-toggle-btn');
    const cards = document.querySelectorAll('.result-card');
    const container = document.getElementById('results-container');
    let activeFilter = 'all';

    filterToggleBtn?.addEventListener('click', () => {
      filterPanel?.classList.toggle('hidden');
    });

    filterPanel?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-option');
      if (!btn) return;
      
      const filterValue = btn.getAttribute('data-filter');
      if (!filterValue) return;

      // Update active state in UI
      const buttons = filterPanel.querySelectorAll('.filter-option');
      buttons.forEach(b => {
        b.className = 'filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none';
      });
      btn.className = 'filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none';

      activeFilter = filterValue;
      let visibleCount = 0;
      
      cards.forEach(card => {
        const el = card as HTMLElement;
        const category = (el.getAttribute('data-category') || '').toLowerCase();
        const moduleType = el.getAttribute('data-module-type');
        const ratingStr = el.getAttribute('data-rating');
        const rating = parseFloat(ratingStr || '0');

        let show = false;
        if (activeFilter === 'all') show = true;
        else if (activeFilter === 'ai' && category.includes('ai')) show = true;
        else if (activeFilter === 'web' && (category.includes('web') || category.includes('coding'))) show = true;
        else if (activeFilter === 'video' && category.includes('video')) show = true;
        else if (activeFilter === 'top-rated' && rating >= 4.8) show = true;
        else if (activeFilter === 'playlists' && moduleType === 'multi') show = true;

        if (show) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      // Hide/Show logic for Empty State if filtering hides all matches
      const existingEmptyState = container?.querySelector('.empty-filter-state');
      if (visibleCount === 0 && cards.length > 0) {
        if (!existingEmptyState) {
          const emptyDiv = document.createElement('div');
          emptyDiv.className = 'empty-filter-state py-12 text-center text-mute';
          emptyDiv.textContent = 'No courses match this specific filter.';
          container?.appendChild(emptyDiv);
        }
      } else {
        if (existingEmptyState) {
          existingEmptyState.remove();
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initResultsFilter);
</script>
