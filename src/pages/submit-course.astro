---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submit Your Course | FreeYTCourses" description="Submit your YouTube course or playlist for review.">
  <main class="max-w-3xl mx-auto px-6 py-24">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-light text-ink-strong tracking-[-0.65px] mb-4">Creator Course Submission Portal</h1>
      <p class="text-body font-light max-w-xl mx-auto">Submit your free YouTube courses or playlists to be featured on our site. We manually review all submissions within 48 hours.</p>
    </div>

    <div class="bg-canvas border border-hairline rounded-md p-8 shadow-sm">
      <form id="submission-form" class="space-y-6">
        <div>
          <label for="url" class="block text-sm font-semibold text-ink-strong mb-1">YouTube Video / Playlist URL</label>
          <input type="url" id="url" required class="w-full bg-canvas-soft border-2 border-hairline hover:border-primary/40 focus:border-primary text-ink rounded-md px-4 py-2.5 text-sm focus:outline-none transition-all placeholder-mute/60 font-sans" placeholder="https://www.youtube.com/watch?v=..." />
          <div id="duplicate-alert" class="hidden mt-2 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-md items-start gap-2">
            <svg class="h-5 w-5 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span>This course is already listed on our website. We cannot accept duplicate submissions.</span>
          </div>
        </div>

        <div>
          <label for="category" class="block text-sm font-semibold text-ink-strong mb-1">Custom Category</label>
          <input type="text" id="category" required class="w-full bg-canvas-soft border-2 border-hairline hover:border-primary/40 focus:border-primary text-ink rounded-md px-4 py-2.5 text-sm focus:outline-none transition-all placeholder-mute/60 font-sans" placeholder="e.g. Next.js Architecture, Advanced Prompt Engineering" />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-ink-strong mb-1">Creator Name / Contact Email</label>
          <input type="email" id="email" required class="w-full bg-canvas-soft border-2 border-hairline hover:border-primary/40 focus:border-primary text-ink rounded-md px-4 py-2.5 text-sm focus:outline-none transition-all placeholder-mute/60 font-sans" placeholder="your@email.com" />
          <div id="email-alert" class="hidden mt-2 p-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-md items-start gap-2">
            <svg class="h-5 w-5 shrink-0 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span>Please provide a real email address. Fake or temporary emails are not allowed.</span>
          </div>
        </div>

        <div class="pt-2">
          <label class="flex items-start gap-3 cursor-pointer select-none bg-canvas-soft border border-hairline p-3 rounded-md hover:border-primary/40 transition-colors">
            <input 
              type="checkbox" 
              id="request-showcase" 
              class="mt-0.5 h-4 w-4 rounded border-hairline text-primary focus:ring-primary bg-canvas cursor-pointer" 
            />
            <div class="flex flex-col">
              <span class="text-xs font-mono uppercase tracking-wider text-ink font-semibold">I am the creator &amp; I want to be featured</span>
              <span class="text-[11px] font-sans text-mute mt-0.5">Check this box to request placement in the Community Creator Showcase on the homepage.</span>
            </div>
          </label>
        </div>

        <button type="submit" id="submit-btn" class="w-full bg-primary text-on-primary font-mono text-xs uppercase font-bold tracking-wider rounded-md hover:bg-primary-soft transition-all cursor-pointer shadow-md py-3 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
          <span>Submit Course</span>
          <svg id="loading-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        </button>
      </form>

      <div id="success-message" class="hidden mt-6 p-6 bg-green-50 border border-green-200 text-green-800 rounded-md text-center">
        <svg class="h-10 w-10 mx-auto text-green-500 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-bold mb-1">Thank you!</h3>
        <p>Your course submission has been received. We will review your link and update you within 48 hours.</p>
        <button type="button" id="submit-another-btn" class="mt-4 text-green-700 underline text-sm hover:text-green-900 font-medium cursor-pointer">Submit another course</button>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { db } from '../lib/firebase.js';
  import { collection, addDoc, serverTimestamp } from 'firebase/firestore';

  const form = document.getElementById('submission-form') as HTMLFormElement;
  const urlInput = document.getElementById('url') as HTMLInputElement;
  const categoryInput = document.getElementById('category') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const duplicateAlert = document.getElementById('duplicate-alert') as HTMLDivElement;
  const emailAlert = document.getElementById('email-alert') as HTMLDivElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  const loadingSpinner = document.getElementById('loading-spinner') as HTMLElement;
  const submitAnotherBtn = document.getElementById('submit-another-btn') as HTMLButtonElement;
  const requestShowcaseCheckbox = document.getElementById('request-showcase') as HTMLInputElement;

  let isChecking = false;

  const checkDuplicate = async () => {
    const url = urlInput.value.trim();
    if (!url) {
      duplicateAlert.classList.add('hidden');
      duplicateAlert.classList.remove('flex');
      submitBtn.disabled = false;
      return;
    }

    if (!url.includes('youtube.com') && !url.includes('youtu.be')) return;

    isChecking = true;
    submitBtn.disabled = true;
    try {
      const res = await fetch('/api/check-duplicate-course', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });
      if (!res.ok) throw new Error('API Error');
      const data = await res.json();
      if (data.isDuplicate) {
        duplicateAlert.classList.remove('hidden');
        duplicateAlert.classList.add('flex');
        submitBtn.disabled = true;
      } else {
        duplicateAlert.classList.add('hidden');
        duplicateAlert.classList.remove('flex');
        submitBtn.disabled = false;
      }
    } catch (e) {
      console.error(e);
      submitBtn.disabled = false;
    } finally {
      isChecking = false;
    }
  };

  urlInput.addEventListener('blur', checkDuplicate);
  urlInput.addEventListener('change', checkDuplicate);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isChecking || submitBtn.disabled) return;

    emailAlert.classList.add('hidden');
    emailAlert.classList.remove('flex');

    const email = emailInput.value.trim();
    const isTestEmail = /^(test|fake|dummy|nobody|noreply|example|asdf|qwerty).*@.*/i.test(email);
    const isTempEmail = /.*@(mailinator\.com|temp-mail\.org|10minutemail\.com|yopmail\.com)/i.test(email);

    if (isTestEmail || isTempEmail) {
      emailAlert.classList.remove('hidden');
      emailAlert.classList.add('flex');
      return;
    }

    submitBtn.disabled = true;
    loadingSpinner.classList.remove('hidden');

    try {
      if (!db) throw new Error('Firestore not initialized');
      
      let targetId = null;
      const url = urlInput.value.trim();
      const isPlaylist = url.includes('list=');
      if (isPlaylist) {
        const match = url.match(/[?&]list=([^&]+)/);
        if (match) targetId = match[1];
      } else {
        const match = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/);
        if (match) targetId = match[1];
      }

      await addDoc(collection(db, 'courseSubmissions'), {
        url: url,
        youtubeId: targetId,
        typedCategory: categoryInput.value.trim(),
        creatorEmail: emailInput.value.trim(),
        requestsShowcase: requestShowcaseCheckbox?.checked || false,
        submittedAt: serverTimestamp(),
        status: 'pending'
      });

      form.classList.add('hidden');
      successMessage.classList.remove('hidden');
    } catch (err) {
      console.error('Error submitting course', err);
      alert('An error occurred while submitting your course. Please try again.');
    } finally {
      submitBtn.disabled = false;
      loadingSpinner.classList.add('hidden');
    }
  });

  submitAnotherBtn.addEventListener('click', () => {
    form.reset();
    form.classList.remove('hidden');
    successMessage.classList.add('hidden');
    duplicateAlert.classList.add('hidden');
    duplicateAlert.classList.remove('flex');
    emailAlert.classList.add('hidden');
    emailAlert.classList.remove('flex');
    submitBtn.disabled = false;
  });
</script>
