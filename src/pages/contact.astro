---
import Layout from '../layouts/Layout.astro';

const title = "Contact Us - FreeYTCourses";
const description = "We're a small team and we read every message. Reach out using the form below.";
---

<Layout title={title} description={description} activePage="contact">
  <main class="max-w-3xl mx-auto px-6 py-10 md:py-16 text-slate-200">
    <!-- Top Back Link -->
    <div class="mb-6">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors font-sans"
      >
        <span>&larr;</span> Back to Home
      </a>
    </div>

    <!-- Page Header -->
    <header class="mb-8 space-y-3">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight">
        Contact Us
      </h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl font-normal">
        We're a small team and we read every message. Whether you've found a bug, have a feature request, or just want to say hello &mdash; reach out using the form below.
      </p>
    </header>

    <!-- Contact Form -->
    <form id="contact-form" class="max-w-xl space-y-6">
      <!-- Hidden Honeypot for spam protection -->
      <input type="text" name="_honey" style="display:none" />
      <input type="hidden" name="_captcha" value="false" />

      <!-- Name Field -->
      <div class="space-y-2">
        <label for="contact-name" class="block text-sm font-medium text-slate-200">
          Name
        </label>
        <input 
          type="text" 
          id="contact-name" 
          name="name"
          required 
          placeholder="Your name"
          class="w-full bg-[#18181b] border border-stone-800 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-all"
        />
      </div>

      <!-- Email Field -->
      <div class="space-y-2">
        <label for="contact-email" class="block text-sm font-medium text-slate-200">
          Email
        </label>
        <input 
          type="email" 
          id="contact-email" 
          name="email"
          required 
          placeholder="you@example.com"
          class="w-full bg-[#18181b] border border-stone-800 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-all"
        />
      </div>

      <!-- Subject Field -->
      <div class="space-y-2">
        <label for="contact-subject" class="block text-sm font-medium text-slate-200">
          Subject
        </label>
        <div class="relative">
          <select 
            id="contact-subject" 
            name="subject"
            required 
            class="w-full bg-[#18181b] border border-stone-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-all appearance-none cursor-pointer pr-10"
          >
            <option value="" disabled selected class="text-slate-500">Select a topic...</option>
            <option value="General Inquiry" class="bg-[#18181b] text-white">General Inquiry / Say Hello</option>
            <option value="Bug Report" class="bg-[#18181b] text-white">Found a Bug or Broken Link</option>
            <option value="Feature Request" class="bg-[#18181b] text-white">Feature Request</option>
            <option value="Course Recommendation" class="bg-[#18181b] text-white">Suggest a Free YouTube Course</option>
            <option value="Creator Partnership" class="bg-[#18181b] text-white">Creator / Channel Submission</option>
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Message Field -->
      <div class="space-y-2">
        <label for="contact-message" class="block text-sm font-medium text-slate-200">
          Message
        </label>
        <textarea 
          id="contact-message" 
          name="message"
          rows="6" 
          required 
          placeholder="Describe your issue or question..."
          class="w-full bg-[#18181b] border border-stone-800 rounded-lg px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 transition-all resize-y"
        ></textarea>
      </div>

      <!-- Feedback / Status Container -->
      <div id="contact-status" class="hidden p-4 rounded-lg text-sm transition-all"></div>

      <!-- Submit Button -->
      <div>
        <button 
          type="submit" 
          id="contact-submit-btn"
          class="bg-white text-black hover:bg-slate-200 font-medium px-6 py-2.5 rounded-full text-sm transition-all cursor-pointer inline-flex items-center justify-center min-w-[140px] shadow-sm active:scale-95"
        >
          Send message
        </button>
      </div>
    </form>
  </main>

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement;
    const contactStatus = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (contactForm && contactStatus && submitBtn) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const nameInput = (document.getElementById('contact-name') as HTMLInputElement).value;
        const emailInput = (document.getElementById('contact-email') as HTMLInputElement).value;
        const subjectInput = (document.getElementById('contact-subject') as HTMLSelectElement).value;
        const messageInput = (document.getElementById('contact-message') as HTMLTextAreaElement).value;

        // UI Loading State
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        submitBtn.textContent = 'Sending...';

        contactStatus.className = 'p-4 rounded-lg text-sm bg-stone-900 border border-stone-800 text-slate-300 block';
        contactStatus.textContent = 'Sending your message...';

        try {
          // Send form data to FormSubmit AJAX endpoint for contactytcourses@gmail.com
          const response = await fetch('https://formsubmit.co/ajax/contactytcourses@gmail.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              name: nameInput,
              email: emailInput,
              subject: subjectInput || 'General Inquiry',
              message: messageInput,
              _subject: `FreeYTCourses Contact: ${subjectInput || 'New Message'}`
            })
          });

          const result = await response.json();

          if (response.ok || result.success === "true" || result.success === true) {
            contactStatus.className = 'p-4 rounded-lg text-sm bg-emerald-950/60 border border-emerald-800/80 text-emerald-300 block';
            contactStatus.innerHTML = `<strong>Thank you!</strong> Your message has been sent successfully. We will get back to you shortly.`;
            contactForm.reset();
          } else {
            throw new Error(result.message || 'Submission failed');
          }
        } catch (err) {
          console.error('Contact Form Error:', err);
          const mailtoUrl = `mailto:contactytcourses@gmail.com?subject=${encodeURIComponent(subjectInput || 'Contact Form Inquiry')}&body=${encodeURIComponent(`Name: ${nameInput}\nEmail: ${emailInput}\n\nMessage:\n${messageInput}`)}`;
          
          contactStatus.className = 'p-4 rounded-lg text-sm bg-amber-950/60 border border-amber-800/80 text-amber-300 block';
          contactStatus.innerHTML = `Something went wrong sending automatically. You can <a href="${mailtoUrl}" class="underline font-bold text-white hover:text-primary">click here to send via email client</a>.`;
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          submitBtn.textContent = 'Send message';
        }
      });
    }
  </script>
</Layout>
