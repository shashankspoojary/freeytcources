---
import Layout from '../../layouts/Layout.astro';
import { getAllPlaylists, getAllCourses, getYoutubeThumbnail } from '../../lib/firebase.js';

const allPlaylists = await getAllPlaylists();
const allCourses = await getAllCourses();

const title = "Playlists Directory - FreeYTcourses";
const description = "Browse curated playlists of high-quality YouTube courses.";

const playlistsWithDetails = allPlaylists.map(playlist => {
  const videoCount = playlist.modules ? playlist.modules.length : 0;
  
  let thumbnail = '/favicon.svg';
  
  if (videoCount > 0) {
    const firstVideo = playlist.modules[0];
    if (firstVideo && firstVideo.videoId) {
      thumbnail = getYoutubeThumbnail(firstVideo.videoId);
    }
  }

  return {
    ...playlist,
    videoCount,
    thumbnail
  };
});
---

<Layout title={title} description={description} activePage="playlists">
  <main class="max-w-6xl mx-auto px-6 py-8 md:py-12">
    <!-- Top Header -->
    <div class="mb-8 pb-4 border-b border-hairline flex flex-col justify-between items-start gap-4">
      <h1 class="text-2xl font-light text-ink-strong tracking-tight flex items-center gap-3">
        Playlists Directory
      </h1>
      <p class="text-xs font-mono text-mute mt-1">Explore carefully curated collections of courses.</p>
    </div>

    <!-- Playlists Grid -->
    {playlistsWithDetails.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {playlistsWithDetails.map((playlist) => (
          <article class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer">
            
            <a href={`/courses/${playlist.id}`} class="absolute inset-0 z-10"><span class="sr-only">View Playlist</span></a>
            
            <!-- Prominent Thumbnail & Promo Badge -->
            <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
              <img 
                src={playlist.thumbnail} 
                alt={`${playlist.name} thumbnail`} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                onerror="this.src='/favicon.svg'"
              />
              
              <!-- Modules Count Overlay Badge -->
              <div class="absolute bottom-2.5 right-2.5 z-20 bg-canvas/90 backdrop-blur-sm text-ink-strong border border-hairline px-2 py-0.5 rounded-sm text-[10px] font-mono flex items-center gap-1.5 shadow-md">
                <svg class="h-3 w-3 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>{playlist.videoCount} Videos</span>
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex flex-col justify-between flex-grow">
              <div>
                <h2 class="text-lg font-semibold text-ink-strong mb-2.5 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                  {playlist.name}
                </h2>

                <div class="flex items-center gap-2 shrink-0 relative z-30 pointer-events-none">
                  <img 
                    src={playlist.logo || '/favicon.svg'} 
                    alt={playlist.name} 
                    class="h-6 w-6 rounded-full object-cover border border-hairline shrink-0"
                    onerror="this.src='/favicon.svg';"
                  />
                  <div class="flex flex-col">
                    <span class="text-[10px] font-mono text-mute leading-none">{playlist.author || 'FreeYTcourses'}</span>
                  </div>
                </div>
              </div>

              <div>
                <!-- Card Footer with Watch Now Action Button -->
                <div class="pt-3.5 border-t border-hairline flex justify-end items-center text-[11px] font-mono text-mute mt-4 relative z-20">
                  <span class="inline-flex items-center gap-1.5 bg-primary/10 hover:bg-primary border border-primary/30 hover:border-primary text-primary hover:text-on-primary px-3.5 py-1.5 rounded-sm text-xs font-mono font-bold uppercase transition-all duration-200 cursor-pointer shadow-sm group/btn pointer-events-none">
                    <span>View Courses</span>
                    <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (

      <div class="text-center p-8 sm:p-12 bg-canvas-soft border border-hairline border-dashed rounded-md my-12 max-w-xl mx-auto">
        <svg class="mx-auto h-12 w-12 text-mute mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-lg font-semibold text-ink mb-1 font-mono uppercase tracking-wider">No Playlists Found</h3>
        <p class="text-sm text-body mb-6 font-light">No playlists have been curated yet.</p>
      </div>
    )}
  </main>
</Layout>
