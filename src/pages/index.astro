              "@type": "Answer",
              "text": "FreeYTCourses focuses on top-paying modern skills, including: AI & Machine Learning (Prompt engineering, Python automation, LLMs, and PyTorch), Video Editing & Post-Production (DaVinci Resolve color grading, Premiere Pro, After Effects), and Software Development (Full-stack web dev, JavaScript, React, Python, database architecture)."
            }
          }
        ]
      })} />

      <!-- Call to Action Banner -->
      <div class="bg-[#121824] border-2 border-primary/50 rounded-xl p-8 text-center space-y-4 shadow-2xl mt-10 relative overflow-hidden">
        <div class="absolute -top-12 -left-12 w-32 h-32 bg-primary/10 rounded-full blur-2xl pointer-events-none"></div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
          Start Learning with Free YouTube Courses Today
        </h2>
        <p class="text-slate-300 text-sm md:text-base leading-relaxed font-light max-w-2xl mx-auto">
          Empower your technical career without expensive tuition fees. Explore our curated categories above, search for specific tools or creators, and take advantage of the world's <strong class="text-white font-medium">best free youtube courses</strong> today.
        </p>
        <div class="pt-2">
          <a 
            href="#courses-section" 
            class="inline-block bg-primary text-on-primary font-mono text-xs uppercase font-bold tracking-wider py-3.5 px-8 rounded-sm hover:bg-primary-soft transition-all cursor-pointer shadow-[0_0_20px_rgba(0,217,146,0.3)]"
          >
            Browse All Free Courses &rarr;
          </a>
        </div>
      </div>

    </article>
  </section>

  <!-- Client-Side Filter, Search, Sort & History Script -->
  <script>
    import { getSubscriptions, getWatchLater, setWatchLater, getWatchHistory, setWatchHistory, getUserStorageKey, getCourseSiteViews, recordCourseSiteView } from '../lib/userStorage.js';

    // Dropdown Filter Elements
    const skillSelect = document.getElementById('skill-filter-select') as HTMLSelectElement;
    const languageSelect = document.getElementById('language-filter-select') as HTMLSelectElement;
    const sortSelect = document.getElementById('sort-filter-select') as HTMLSelectElement;

    const filterCards = document.querySelectorAll('.filter-card');
    const courseGrid = document.getElementById('course-grid');
    const emptyState = document.getElementById('empty-state');
    
    // Subscription Elements
    const navSubBadge = document.getElementById('nav-sub-badge');
    
    // Search Elements (HeaderNav & Hero Input)
    const searchContainer = document.getElementById('search-container');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const heroSearchInput = document.getElementById('hero-search-input') as HTMLInputElement;
    const heroClearBtn = document.getElementById('hero-clear-search-btn');
    const dropdown = document.getElementById('search-suggestions-dropdown');
    
    let activeFilter = 'All';
    let activeLanguage = 'All';
    let activeModuleType = 'All';
    let activeSort = 'shuffled';

    // Retrieve courses from data block
    const coursesDataEl = document.getElementById('courses-data');
    const allCourses = JSON.parse(coursesDataEl?.getAttribute('data-courses') || '[]');

    // Generate random shuffle seed map per session/page load
    const cardShuffleSeedMap = new Map<string, number>();
    allCourses.forEach((c: any) => {
      cardShuffleSeedMap.set(c.slug, Math.random());
    });

    /**
     * 1. Search Query Tokenization & Normalization
     * Converts search input into lower-case tokens, stripping special characters & extra whitespace.
     */
    function tokenize(text: string): string[] {
      if (!text) return [];
      return String(text)
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, ' ')
        .trim()
        .split(/\s+/)
        .filter(Boolean);
    }

    /**
     * Base Course Rank Function
     * Calculates internal ranking score driven by internal site watch/views on our platform:
     * - Featured Bonus: course.featured ? 25 : 0
     * - Site Watch Score: Math.min((siteViews || 0) * 10, 50)
     * - Recency Score: course.publishedYear >= 2025 ? 25 : 15
     */
    function calculateCourseRank(course: any): number {
      if (!course) return 0;
      const siteViews = getCourseSiteViews(course.slug);
      const featuredBonus = course.featured ? 25 : 0;
      const siteViewsScore = Math.min((siteViews || 0) * 10, 50);
      const year = typeof course.publishedYear === 'number' 
        ? course.publishedYear 
        : (course.publishDate ? new Date(course.publishDate).getFullYear() : 0);
      const recencyScore = year >= 2025 ? 25 : 15;
      return featuredBonus + siteViewsScore + recencyScore;
    }

    /**
     * Multi-Field Weighted Relevance Scoring Algorithm
     * - Title token match: +10 pts per token
     * - Tags token match: +8 pts per token
     * - Creator token match: +7 pts per token
     * - Category token match: +6 pts per token
     * - Tools token match: +5 pts per token
     */
    function calculateRelevanceScore(course: any, rawQuery: string): { relevanceScore: number; allTokensMatch: boolean } {
      const queryTokens = tokenize(rawQuery);
      if (queryTokens.length === 0) return { relevanceScore: 0, allTokensMatch: false };

      const titleStr = String(course.title || '').toLowerCase();
      const creatorStr = String(course.creatorName || course.creator || course.author || '').toLowerCase();
      const categoryStr = String(course.category || '').toLowerCase();
      const tagsArr: string[] = Array.isArray(course.tags) ? course.tags : (course.tags ? [course.tags] : []);
      const toolsArr: string[] = Array.isArray(course.tools) ? course.tools : (course.tools ? [course.tools] : []);

      let score = 0;
      let allTokensMatch = true;

      for (const token of queryTokens) {
        const titleMatch = titleStr.includes(token);
        const tagsMatch = tagsArr.some(t => String(t).toLowerCase().includes(token));
        const creatorMatch = creatorStr.includes(token);
        const categoryMatch = categoryStr.includes(token);
        const toolsMatch = toolsArr.some(t => String(t).toLowerCase().includes(token));

        if (!(titleMatch || tagsMatch || creatorMatch || categoryMatch || toolsMatch)) {
          allTokensMatch = false;
        }

        if (titleMatch) score += 10;
        if (tagsMatch) score += 8;
        if (creatorMatch) score += 7;
        if (categoryMatch) score += 6;
        if (toolsMatch) score += 5;
      }

      return { relevanceScore: score, allTokensMatch };
    }

    // Populate skill/category dropdown dynamically from stored categories
    function populateCategoryOptions() {
      if (!skillSelect) return;
      try {
        const raw = localStorage.getItem('freeyt_categories');
        const cats = raw ? JSON.parse(raw) : ["AI Engineering", "Video Editing", "Coding Skills"];
        const cur = activeFilter;

        skillSelect.innerHTML = '<option value="All">All Courses</option>';
        cats.forEach((cat: string) => {
          const opt = document.createElement('option');
          opt.value = cat;
          opt.textContent = cat;
          if (cat === cur) opt.selected = true;
          skillSelect.appendChild(opt);
        });
        if (cats.includes(cur) || cur === 'All') {
          skillSelect.value = cur;
        } else {
          skillSelect.value = 'All';
          activeFilter = 'All';
        }
      } catch (e) {}
    }

    skillSelect?.addEventListener('change', () => {
      activeFilter = skillSelect.value;
      
      // Sync hero grid cards visual active state
      filterCards.forEach((card) => {
        const cardVal = card.getAttribute('data-filter-value');
        if (cardVal === activeFilter) {
          card.classList.add('border-primary');
          card.classList.remove('border-hairline');
        } else {
          card.classList.remove('border-primary');
          card.classList.add('border-hairline');
        }
      });

      applyFiltersAndSort();
    });

    languageSelect?.addEventListener('change', () => {
      activeLanguage = languageSelect.value;
      applyFiltersAndSort();
    });

    sortSelect?.addEventListener('change', () => {
      activeSort = sortSelect.value;
      applyFiltersAndSort();
    });

    window.addEventListener('categoriesChanged', () => {
      populateCategoryOptions();
      applyFiltersAndSort();
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'freeyt_categories') {
        populateCategoryOptions();
        applyFiltersAndSort();
      }
    });

    // Event listeners for visual filter cards (Hero grid)
    filterCards.forEach((card) => {
      card.addEventListener('click', () => {
        const val = card.getAttribute('data-filter-value');
        if (val) {
          setFilter(val);
          document.getElementById('courses-section')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Real-Time Search Debounce (150ms) and Synchronization
    let searchDebounceTimer: any = null;
    function triggerSearchSync(q: string) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        const url = new URL(window.location.href);
        if (q.trim()) {
          url.searchParams.set('q', q.trim());
        } else {
          url.searchParams.delete('q');
        }
        window.history.replaceState({}, '', url.toString());

        window.dispatchEvent(new CustomEvent('course-search', { detail: q }));
        window.dispatchEvent(new CustomEvent('globalSearchInput', { detail: q }));
      }, 150);
    }

    // Hero Search Bar input listeners
    heroSearchInput?.addEventListener('input', () => {
      const q = heroSearchInput.value;
      if (q.trim()) {
        heroClearBtn?.classList.remove('hidden');
      } else {
        heroClearBtn?.classList.add('hidden');
      }
      triggerSearchSync(q);
    });

    heroClearBtn?.addEventListener('click', () => {
      if (heroSearchInput) {
        heroSearchInput.value = '';
        heroClearBtn.classList.add('hidden');
        heroSearchInput.focus();
        triggerSearchSync('');
      }
    });

    // Header Search Bar input listeners
    searchInput?.addEventListener('input', () => {
      const q = searchInput.value;
      if (q.trim()) {
        clearSearchBtn?.classList.remove('hidden');
        renderSuggestions(q);
      } else {
        clearSearchBtn?.classList.add('hidden');
        if (dropdown) dropdown.classList.add('hidden');
      }
      triggerSearchSync(q);
    });

    searchInput?.addEventListener('focus', () => {
      const q = searchInput.value;
      if (q.trim() && dropdown) {
        renderSuggestions(q);
      }
    });

    // Dismiss search dropdown when clicking outside
    document.addEventListener('click', (e) => {
      if (searchContainer && !searchContainer.contains(e.target as Node)) {
        dropdown?.classList.add('hidden');
      }
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        if (dropdown) dropdown.classList.add('hidden');
        triggerSearchSync('');
        searchInput.focus();
      }
    });

    // Handle incoming search sync events from external elements
    function handleSearchEvent(e: Event) {
      const customEvt = e as CustomEvent;
      const q = typeof customEvt.detail === 'string' ? customEvt.detail : customEvt.detail?.query || '';

      if (heroSearchInput && heroSearchInput.value !== q) {
        heroSearchInput.value = q;
        if (q.trim()) heroClearBtn?.classList.remove('hidden');
        else heroClearBtn?.classList.add('hidden');
      }

      if (searchInput && searchInput.value !== q) {
        searchInput.value = q;
        if (q.trim()) clearSearchBtn?.classList.remove('hidden');
        else clearSearchBtn?.classList.add('hidden');
      }

      applyFiltersAndSort();
    }

    window.addEventListener('course-search', handleSearchEvent as EventListener);
    window.addEventListener('globalSearchInput', handleSearchEvent as EventListener);

    // Pre-fill from URL ?q= param
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery) {
      if (searchInput) {
        searchInput.value = initialQuery;
        clearSearchBtn?.classList.remove('hidden');
      }
      if (heroSearchInput) {
        heroSearchInput.value = initialQuery;
        heroClearBtn?.classList.remove('hidden');
      }
    }

    function highlightText(text: string, query: string): string {
      if (!query.trim()) return text;
      const tokens = tokenize(query);
      if (tokens.length === 0) return text;
      const escaped = tokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(regex, '<span class="text-primary font-bold">$1</span>');
    }

    function getCreatorSlug(name: string) {
      if (!name) return "";
      return name.toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');
    }

    function renderSuggestions(query: string) {
      if (!dropdown) return;
      const qTokens = tokenize(query);
      if (qTokens.length === 0) {
        dropdown.classList.add('hidden');
        return;
      }

      const scoredMatches = allCourses
        .map((c: any) => {
          const { relevanceScore, allTokensMatch } = calculateRelevanceScore(c, query);
          if (relevanceScore === 0 || !allTokensMatch) return { course: c, score: 0 };
          const baseRank = calculateCourseRank(c);
          return { course: c, score: relevanceScore + (baseRank * 0.2) };
        })
        .filter((item: any) => item.score > 0)
        .sort((a: any, b: any) => b.score - a.score)
        .map((item: any) => item.course);

      const normQuery = query.toLowerCase().trim();
      const matchingCreators: any[] = [];
      const seenCreators = new Set();

      allCourses.forEach((c: any) => {
        const creatorName = c.creatorName || c.creator || '';
        const creatorSlug = getCreatorSlug(creatorName);
        if (!seenCreators.has(creatorSlug) && creatorName.toLowerCase().includes(normQuery)) {
          seenCreators.add(creatorSlug);
          const count = allCourses.filter((course: any) => getCreatorSlug(course.creatorName || course.creator) === creatorSlug).length;
          matchingCreators.push({
            name: creatorName,
            slug: creatorSlug,
            logo: c.creatorLogo,
            count: count
          });
        }
      });

      if (scoredMatches.length === 0 && matchingCreators.length === 0) {
        dropdown.innerHTML = `
          <div class="p-3 text-xs text-mute font-mono">
            No courses found matching "${query}"
          </div>
        `;
        dropdown.classList.remove('hidden');
        return;
      }

      dropdown.innerHTML = '';

      matchingCreators.slice(0, 2).forEach((creator: any) => {
        const item = document.createElement('a');
        item.href = `/creators/${creator.slug}`;
        item.className = "flex items-center gap-3 p-3.5 hover:bg-canvas-soft border-b border-hairline/25 transition-colors text-left group cursor-pointer focus:outline-none focus:bg-canvas-soft";
        
        item.innerHTML = `
          <div class="relative h-9 w-9 shrink-0">
            <img src="${creator.logo}" class="h-full w-full object-cover rounded-full border border-hairline group-hover:border-primary transition-all" />
            <span class="absolute -bottom-1 -right-1 bg-primary text-on-primary text-[7px] font-mono uppercase px-1 rounded-sm">Creator</span>
          </div>
          <div class="overflow-hidden">
            <h4 class="text-xs font-semibold text-ink-strong group-hover:text-primary transition-colors line-clamp-1 leading-snug">
              ${highlightText(creator.name, query)}
            </h4>
            <span class="text-[10px] font-mono text-mute">
              Channel • ${creator.count} course${creator.count > 1 ? 's' : ''}
            </span>
          </div>
        `;
        
        dropdown.appendChild(item);
      });

      scoredMatches.slice(0, 5).forEach((course: any) => {
        const videoId = course.sampleVideoId;
        const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
        
        const item = document.createElement('a');
        item.href = `/courses/${course.slug}`;
        item.className = "flex items-center gap-3 p-3.5 hover:bg-canvas-soft transition-colors text-left group cursor-pointer focus:outline-none focus:bg-canvas-soft";
        
        item.innerHTML = `
          <img src="${thumbnailUrl}" class="h-9 w-14 object-cover rounded-sm border border-hairline shrink-0" />
          <div class="overflow-hidden">
            <h4 class="text-xs font-semibold text-ink-strong group-hover:text-primary transition-colors line-clamp-1 leading-snug">
              ${highlightText(course.title, query)}
            </h4>
            <span class="text-[10px] font-mono text-mute">
              by ${highlightText(course.creatorName || course.creator, query)}
            </span>
          </div>
        `;

        item.addEventListener('click', () => {
          addToHistory(course.slug);
        });

        dropdown.appendChild(item);
      });

      const footerAction = document.createElement('div');
      footerAction.className = "p-2 bg-canvas-soft/40 text-[10px] font-mono text-mute text-right border-t border-hairline/25";
      footerAction.textContent = "Press Enter to filter results below";
      dropdown.appendChild(footerAction);

      dropdown.classList.remove('hidden');
    }

    const heroSearchForm = document.getElementById('hero-search-form') as HTMLFormElement;
    heroSearchForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = heroSearchInput?.value || '';
      triggerSearchSync(q);
      dropdown?.classList.add('hidden');
      heroSearchInput?.blur();
      document.getElementById('courses-section')?.scrollIntoView({ behavior: 'smooth' });
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        applyFiltersAndSort();
        dropdown?.classList.add('hidden');
        searchInput.blur();
        document.getElementById('courses-section')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    heroSearchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        applyFiltersAndSort();
        heroSearchInput.blur();
        document.getElementById('courses-section')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    function updateSubscriptionsUI() {
      const subs = getSubscriptions();
      if (navSubBadge) {
        if (subs.length > 0) {
          navSubBadge.textContent = String(subs.length);
          navSubBadge.classList.remove('hidden');
        } else {
          navSubBadge.classList.add('hidden');
        }
      }
    }

    function setFilter(category: string) {
      activeFilter = category;
      if (skillSelect) skillSelect.value = category;
      
      filterCards.forEach((card) => {
        const cardVal = card.getAttribute('data-filter-value');
        if (cardVal === category) {
          card.classList.add('border-primary');
          card.classList.remove('border-hairline');
        } else {
          card.classList.remove('border-primary');
          card.classList.add('border-hairline');
        }
      });

      applyFiltersAndSort();
    }

    function setSort(sortType: string) {
      activeSort = sortType;
      if (sortSelect) sortSelect.value = sortType;
      applyFiltersAndSort();
    }

    function setLanguage(lang: string) {
      activeLanguage = lang;
      if (languageSelect) languageSelect.value = lang;
      applyFiltersAndSort();
    }

    function setModuleType(modType: string) {
      activeModuleType = modType;
      const moduleSelect = document.getElementById('module-filter-select') as HTMLSelectElement;
      if (moduleSelect) moduleSelect.value = modType;
      applyFiltersAndSort();
    }

    const moduleSelect = document.getElementById('module-filter-select') as HTMLSelectElement;
    moduleSelect?.addEventListener('change', (e) => {
      setModuleType((e.target as HTMLSelectElement).value);
    });

    (window as any).setFilter = setFilter;
    (window as any).setSort = setSort;
    (window as any).setLanguage = setLanguage;
    (window as any).setModuleType = setModuleType;

    function applyFiltersAndSort() {
      if (!courseGrid) return;
      const cards = Array.from(courseGrid.getElementsByClassName('course-card')) as HTMLElement[];
      const currentQuery = (searchInput?.value || heroSearchInput?.value || '').trim();

      const scoredCards: { card: HTMLElement; score: number }[] = [];
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const lang = card.getAttribute('data-language') || 'English';
        const modType = card.getAttribute('data-module-type') || 'multi';
        const slug = card.getAttribute('data-slug');
        const course = allCourses.find((c: any) => c.slug === slug);

        const matchesCategory = activeFilter === 'All' || cat === activeFilter;
        const matchesLanguage = activeLanguage === 'All' || lang === activeLanguage;
        const matchesModuleType = activeModuleType === 'All' || modType === activeModuleType;

        let score = 0;
        let matchesSearch = true;

        if (currentQuery.length > 0 && course) {
          const { relevanceScore, allTokensMatch } = calculateRelevanceScore(course, currentQuery);
          if (relevanceScore === 0 || !allTokensMatch) {
            matchesSearch = false;
          } else {
            const baseRank = calculateCourseRank(course);
            score = relevanceScore + (baseRank * 0.2);
          }
        } else if (course) {
          score = calculateCourseRank(course);
        }

        if (matchesCategory && matchesLanguage && matchesModuleType && matchesSearch) {
          card.classList.remove('hidden');
          scoredCards.push({ card, score });
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const emptyTitleEl = document.getElementById('empty-state-title');
      const emptyTextEl = document.getElementById('empty-state-text');

      if (visibleCount === 0) {
        if (emptyState) {
          emptyState.classList.remove('hidden');
          if (currentQuery) {
            if (emptyTitleEl) emptyTitleEl.textContent = `No courses found matching "${currentQuery}"`;
            if (emptyTextEl) emptyTextEl.textContent = `No curated courses matched all of your search terms. Try searching by creator, tool, or broad category.`;
          } else {
            if (emptyTitleEl) emptyTitleEl.textContent = `No Courses Found`;
            if (emptyTextEl) emptyTextEl.textContent = `No curated courses match the selected search parameters or skill categories.`;
          }
        }
        courseGrid.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        courseGrid.classList.remove('hidden');
      }

      scoredCards.sort((a, b) => {
        if (currentQuery.length > 0) {
          if (b.score !== a.score) {
            return b.score - a.score;
          }
        } else {
          if (activeSort === 'shuffled') {
            const slugA = a.card.getAttribute('data-slug') || '';
            const slugB = b.card.getAttribute('data-slug') || '';
            const seedA = cardShuffleSeedMap.get(slugA) || 0;
            const seedB = cardShuffleSeedMap.get(slugB) || 0;
            return seedA - seedB;
          } else if (activeSort === 'latest') {
            const cardA = a.card;
            const cardB = b.card;
            const dateA = new Date(cardA.getAttribute('data-date') || '');
            const dateB = new Date(cardB.getAttribute('data-date') || '');
            return dateB.getTime() - dateA.getTime();
          } else if (activeSort === 'most-watched') {
            if (b.score !== a.score) {
              return b.score - a.score;
            }
          }
        }
        return b.score - a.score;
      });

      const HOMEPAGE_LIMIT = 18;
      let renderedCount = 0;

      scoredCards.forEach((item) => {
        if (activeSort === 'shuffled' && currentQuery === '' && activeFilter === 'All' && activeLanguage === 'All' && activeModuleType === 'All') {
          if (renderedCount < HOMEPAGE_LIMIT) {
            item.card.classList.remove('hidden');
            courseGrid.appendChild(item.card);
            renderedCount++;
          } else {
            item.card.classList.add('hidden');
          }
        } else {
          item.card.classList.remove('hidden');
          courseGrid.appendChild(item.card);
        }
      });
    }

    // User Retention: Isolated Watch History Engine
    function addToHistory(slug: string) {
      let history: string[] = getWatchHistory();

      // Prepend to history & remove duplicates
      history = history.filter(item => item !== slug);
      history.unshift(slug);

      // Keep only top 4 items
      if (history.length > 4) {
        history = history.slice(0, 4);
      }

      setWatchHistory(history);
    }

    function renderContinueLearning() {
      const container = document.getElementById('continue-learning-section');
      const grid = document.getElementById('continue-learning-grid');
      if (!container || !grid) return;

      let history: string[] = getWatchHistory();

      if (!Array.isArray(history) || history.length === 0) {
        container.classList.add('hidden');
        return;
      }

      grid.innerHTML = '';
      let count = 0;

      history.forEach((slug) => {
        const course = allCourses.find((c: any) => c.slug === slug);
        if (course) {
          count++;
          const thumbnailUrl = `https://img.youtube.com/vi/${course.sampleVideoId}/maxresdefault.jpg`;
          
          const progressKey = getUserStorageKey(`freeyt_progress_${course.slug}`);
          let progressPercent = 0;
          let progressLabel = '';
          try {
            const rawProgress = localStorage.getItem(progressKey);
            if (rawProgress) {
              const progressState = JSON.parse(rawProgress);
              const totalCh = course.chapters ? course.chapters.length : 5;
              const completedCh = Array.isArray(progressState.completedChapters) ? progressState.completedChapters.length : 0;
              progressPercent = totalCh > 0 ? Math.round((completedCh / totalCh) * 100) : 0;
              
              if (completedCh > 0 || Object.keys(progressState.chapterPositions || {}).length > 0) {
                const activeIdx = typeof progressState.lastActiveIndex === 'number' ? progressState.lastActiveIndex : 0;
                const chTitle = course.chapters && course.chapters[activeIdx] ? course.chapters[activeIdx].title : `Lesson ${activeIdx+1}`;
                progressLabel = `${completedCh}/${totalCh} done • Resume: ${chTitle.split(':')[0]}`;
              }
            }
          } catch (err) {
            console.error(err);
          }

          const progressBarHtml = progressPercent > 0 ? `
            <div class="mt-2 space-y-1 overflow-hidden">
              <div class="w-full h-1 bg-canvas border border-hairline rounded-sm overflow-hidden">
                <div class="h-full bg-primary" style="width: ${progressPercent}%"></div>
              </div>
              <div class="flex justify-between items-center text-[9px] font-mono text-mute gap-2">
                <span class="text-primary font-semibold">${progressPercent}% done</span>
                <span class="truncate text-right" title="${progressLabel}">${progressLabel.split('•')[1] || ''}</span>
              </div>
            </div>
          ` : `
            <div class="flex items-center gap-1.5 mt-2">
              <img src="${course.creatorLogo}" class="h-4 w-4 rounded-full border border-hairline object-cover shrink-0" alt="${course.creatorName}" />
              <span class="text-[10px] font-mono text-mute line-clamp-1">${course.creatorName}</span>
            </div>
          `;

          const cardHtml = `
            <div class="group bg-canvas-soft border border-hairline rounded-md p-4 flex gap-4 hover:border-primary/45 transition-all duration-300 relative overflow-hidden">
              <a href="/courses/${course.slug}" class="flex gap-4 flex-grow overflow-hidden">
                <img src="${thumbnailUrl}" class="h-16 w-24 object-cover rounded-sm shrink-0 border border-hairline" alt="${course.title} thumbnail" />
                <div class="flex flex-col justify-between overflow-hidden flex-grow">
                  <div>
                    <span class="text-[9px] font-mono uppercase text-primary tracking-wider">${course.category}</span>
                    <h3 class="text-xs font-semibold text-ink-strong group-hover:text-primary transition-colors line-clamp-1 mt-0.5">${course.title}</h3>
                  </div>
                  ${progressBarHtml}
                </div>
              </a>
              <button 
                type="button" 
                class="cl-remove-btn absolute top-2 right-2 p-1 rounded-sm bg-canvas/80 hover:bg-red-500 text-mute hover:text-white transition-all opacity-0 group-hover:opacity-100 cursor-pointer z-10"
                data-slug="${course.slug}"
                title="Remove from Continue Learning"
              >
                <svg class="h-3 w-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          `;
          grid.insertAdjacentHTML('beforeend', cardHtml);
        }
      });

      // Attach remove button listeners
      grid.querySelectorAll('.cl-remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const slug = btn.getAttribute('data-slug');
          if (!slug) return;

          let hist: string[] = getWatchHistory();
          hist = hist.filter(s => s !== slug);
          setWatchHistory(hist);
          renderContinueLearning();
        });
      });

      if (count > 0) {
        container.classList.remove('hidden');
      } else {
        container.classList.add('hidden');
      }
    }

    function renderCourseGridProgress() {
      document.querySelectorAll('.course-card').forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;
        
        const progressKey = getUserStorageKey(`freeyt_progress_${slug}`);
        try {
          const rawProgress = localStorage.getItem(progressKey);
          if (rawProgress) {
            const progressState = JSON.parse(rawProgress);
            const course = allCourses.find((c: any) => c.slug === slug);
            if (!course) return;
            const totalCh = course.chapters ? course.chapters.length : 5;
            const completedCh = Array.isArray(progressState.completedChapters) ? progressState.completedChapters.length : 0;
            const progressPercent = totalCh > 0 ? Math.round((completedCh / totalCh) * 100) : 0;
            
            if (completedCh > 0 || Object.keys(progressState.chapterPositions || {}).length > 0) {
              const imgContainer = card.querySelector('.aspect-video');
              if (imgContainer && !card.querySelector('.card-progress-bar-container')) {
                const progressOverlay = document.createElement('div');
                progressOverlay.className = 'card-progress-bar-container absolute bottom-0 left-0 right-0 h-1.5 bg-canvas border-t border-hairline overflow-hidden z-20';
                progressOverlay.innerHTML = `<div class="h-full bg-primary" style="width: ${progressPercent}%"></div>`;
                imgContainer.appendChild(progressOverlay);
                
                const durationEl = card.querySelector('.text-xs.font-mono.text-mute');
                if (durationEl) {
                  durationEl.innerHTML = `<span class="text-primary font-semibold">${progressPercent}% done</span> <span class="mx-1 text-hairline">|</span> ${durationEl.textContent}`;
                }
              }
            }
          }
        } catch (e) {
          console.error("Failed to parse course card progress", e);
        }
      });
    }

    // Attach click listeners to cards to record visits
    document.querySelectorAll('.course-card').forEach((card) => {
      card.addEventListener('click', () => {
        const slug = card.getAttribute('data-slug');
        if (slug) {
          addToHistory(slug);
        }
      });
    });

    // Toast Notification Helper
    function showToast(message: string, actionText = '', actionUrl = '') {
      let container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'fixed bottom-6 left-6 z-50 flex flex-col gap-2 pointer-events-none';
        document.body.appendChild(container);
      }

      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-canvas-soft border border-primary/50 text-ink px-4 py-3 rounded-md shadow-2xl flex items-center gap-4 text-xs font-mono transition-all duration-300';
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>${message}</span>
        </div>
        ${actionText && actionUrl ? `<a href="${actionUrl}" class="text-primary font-bold hover:underline shrink-0">${actionText} &rarr;</a>` : ''}
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Watch Later Toggle Button Logic
    function updateWatchLaterButtons() {
      const wl = getWatchLater();

      document.querySelectorAll('.watch-later-toggle-btn').forEach(btn => {
        const slug = btn.getAttribute('data-slug');
        const label = btn.querySelector('.wl-label');
        if (slug && Array.isArray(wl) && wl.includes(slug)) {
          btn.className = "watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-primary text-on-primary font-bold px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-primary flex items-center gap-1.5 text-[11px] font-mono";
          if (label) label.textContent = "Saved";
          btn.setAttribute('title', 'Saved to Watch Later (Click to remove)');
        } else {
          btn.className = "watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-hairline hover:border-primary flex items-center gap-1.5 text-[11px] font-mono";
          if (label) label.textContent = "Watch later";
          btn.setAttribute('title', 'Save to Watch Later');
        }
      });
    }

    document.querySelectorAll('.watch-later-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        if (!slug) return;

        let wl = getWatchLater();
        const isSaved = wl.includes(slug);
        if (isSaved) {
          wl = wl.filter(s => s !== slug);
          showToast('Removed from Watch Later');
        } else {
          wl.push(slug);
          showToast('Saved to Watch Later', 'View Playlist', '/watch-later');
        }

        setWatchLater(wl);
        updateWatchLaterButtons();
      });
    });

    document.querySelectorAll('.course-card').forEach((card) => {
      card.addEventListener('click', () => {
        const slug = card.getAttribute('data-slug');
        if (slug) {
          recordCourseSiteView(slug);
          addToHistory(slug);
        }
      });
    });

    window.addEventListener('siteViewsChanged', () => {
      applyFiltersAndSort();
    });

    // YouTube-style Chip Navigation Logic
    const chipBtns = document.querySelectorAll('.chip-btn');
    const feedContainer = document.getElementById('home-feed-container');
    
    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        if (!target) return;

        // Reset all chips to inactive state
        chipBtns.forEach(c => {
          c.classList.remove('active', 'bg-ink', 'text-canvas', 'hover:bg-ink-strong');
          c.classList.add('bg-canvas-soft', 'hover:bg-hairline/50', 'text-ink');
        });

        // Set clicked chip to active state
        btn.classList.remove('bg-canvas-soft', 'hover:bg-hairline/50', 'text-ink');
        btn.classList.add('active', 'bg-ink', 'text-canvas', 'hover:bg-ink-strong');

        // Filter sections
        const sections = ['trending-section', 'editors-picks-section', 'recently-added-section', 'most-popular-section'];
        
        sections.forEach(id => {
          const sec = document.getElementById(id);
          if (sec) {
            if (id === target) {
              sec.classList.remove('hidden');
            } else {
              sec.classList.add('hidden');
            }
          }
        });
        feedContainer?.classList.remove('space-y-16');
      });
    });

    // Dashboard Filter Cards Logic
    document.querySelectorAll('.filter-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const filterVal = btn.getAttribute('data-filter-value');
        if (filterVal) {
          window.location.href = `/courses?skill=${encodeURIComponent(filterVal)}`;
        }
      });
    });

    // Run on page load
    populateCategoryOptions();
    updateSubscriptionsUI();
    renderContinueLearning();
    renderCourseGridProgress();
    applyFiltersAndSort();
    updateWatchLaterButtons();
    window.addEventListener('watchLaterChanged', updateWatchLaterButtons);
  </script>
</Layout>
