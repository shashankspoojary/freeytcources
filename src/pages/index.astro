---
import Layout from '../layouts/Layout.astro';
import { getAllCourses, getYoutubeThumbnail, getCreatorSlug } from '../lib/firebase.js';

const allCourses = await getAllCourses();
// Randomly shuffle courses for initial SSR render
const courses = [...allCourses].sort(() => 0.5 - Math.random());

// 1. Trending Courses: High engagement & view velocity
const trendingCourses = [...allCourses]
  .sort((a, b) => (b.views || 0) - (a.views || 0))
  .slice(0, 4);

// 2. Recently Added: Newest release dates first
const recentlyAddedCourses = [...allCourses]
  .sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
  .slice(0, 4);

// 3. Editor's Picks: Handpicked featured courses
const editorsPicks = allCourses
  .filter(c => c.featured)
  .slice(0, 4);

// 4. Most Popular: Highest rated & views overall
const mostPopularCourses = [...allCourses]
  .sort((a, b) => (b.views || 0) * (b.rating || 4.5) - (a.views || 0) * (a.rating || 4.5))
  .slice(0, 4);

// Dynamically compute the set of unique languages present in all courses
const languages = Array.from(new Set(courses.map(c => c.language || "English").filter(Boolean)));

// Define SEO title and description
const title = "Free YouTube Courses & Structured Learning Roadmaps";
const description = "Discover the best free YouTube courses for AI engineering, video editing, and coding. Access curated playlists, detailed syllabi, and top creator tutorials—100% free.";
---

<Layout 
  title={`${title} | FreeYTCourses`} 
  description={description}
  ogImage="/og-banner.jpg"
  ogType="website"
  activePage="home"
>


  <!-- Hero Section (Section A - App Workspace Top) -->
  <header class="max-w-6xl mx-auto px-6 pt-16 pb-12 md:pt-24 md:pb-16 text-center">
    <div class="inline-block font-mono text-xs text-primary uppercase tracking-[2.52px] mb-4 bg-primary/10 px-3 py-1.5 rounded-pill border border-primary/20">
      Engineered Learning
    </div>
    <div class="text-3xl md:text-5xl lg:text-6xl font-light text-ink-strong tracking-[-0.65px] leading-tight max-w-4xl mx-auto mb-6">
      Free YouTube Courses & Curated Learning Roadmaps
    </div>
    <p class="text-base md:text-lg text-body max-w-2xl mx-auto mb-6 font-light leading-relaxed">
      No fluff, no paywalls. High-quality structured learning modules meticulously reviewed and organized by core developer tools.
    </p>

    <!-- Silent Subdued Inline Links Row in Hero -->
    <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 mb-8 text-[11px] font-sans text-slate-500/70">
      <a href="/about" class="hover:text-slate-400 transition-colors">About Us</a>
      <span class="text-slate-700/50 select-none">•</span>
      <a href="/contact" class="hover:text-slate-400 transition-colors">Contact</a>
      <span class="text-slate-700/50 select-none">•</span>
      <a href="/privacy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
      <span class="text-slate-700/50 select-none">•</span>
      <a href="/terms" class="hover:text-slate-400 transition-colors">Terms &amp; Conditions</a>
    </nav>

    <!-- Homepage Hero Search Bar -->
    <form id="hero-search-form" class="max-w-xl mx-auto mb-12 relative z-20" action="/courses" method="GET">
      <div class="relative flex items-center">
        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-mute pointer-events-none">
          <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input 
          type="text" 
          id="hero-search-input" 
          name="q"
          placeholder="Search by topic, creator, tool, or keyword (e.g. Traversy, React, DaVinci)..." 
          class="w-full bg-canvas-soft border-2 border-hairline hover:border-primary/40 focus:border-primary text-ink rounded-md pl-12 pr-24 py-3.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all placeholder-mute/60 shadow-lg font-sans"
          autocomplete="off"
        />
        <button 
          id="hero-clear-search-btn" 
          type="button" 
          class="absolute right-20 inset-y-0 flex items-center pr-1 text-mute hover:text-ink hidden cursor-pointer bg-transparent border-none focus:outline-none"
          title="Clear Search"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <button 
          type="submit" 
          id="hero-search-submit-btn" 
          aria-label="Search" 
          class="absolute inset-y-0 right-0 flex items-center px-4 bg-primary text-on-primary font-mono text-xs uppercase font-bold tracking-wider rounded-r-md hover:bg-primary-soft transition-all cursor-pointer shadow-md"
        >
          Search
        </button>
      </div>
    </form>

    <!-- Visual Dashboard Grid / Filter Navigation Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16 text-left">
      <!-- AI Engineering -->
      <button 
        id="filter-card-ai" 
        data-filter-value="AI Engineering" 
        class="filter-card group text-left p-6 bg-canvas border border-hairline rounded-md hover:border-primary/50 transition-all duration-300 relative overflow-hidden focus:outline-none focus:ring-1 focus:ring-primary"
      >
        <div class="flex justify-between items-start mb-4">
          <div class="h-10 w-10 rounded-sm bg-canvas-soft border border-hairline flex items-center justify-center text-primary group-hover:bg-primary/10 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <span class="font-mono text-xs text-mute group-hover:text-primary transition-colors">MODULE_01</span>
        </div>
        <h3 class="text-lg font-semibold text-ink mb-1 group-hover:text-primary transition-colors">AI Engineering</h3>
        <p class="text-sm text-body line-clamp-2">LangChain, PyTorch, Vector DBs, and agentic workflows.</p>
        <div class="mt-4 pt-4 border-t border-hairline flex items-center gap-1.5 text-xs font-mono text-mute">
          <span>Active courses:</span>
          <span class="text-ink font-semibold">2</span>
        </div>
      </button>

      <!-- Video Editing -->
      <button 
        id="filter-card-video" 
        data-filter-value="Video Editing" 
        class="filter-card group text-left p-6 bg-canvas border border-hairline rounded-md hover:border-primary/50 transition-all duration-300 relative overflow-hidden focus:outline-none focus:ring-1 focus:ring-primary"
      >
        <div class="flex justify-between items-start mb-4">
          <div class="h-10 w-10 rounded-sm bg-canvas-soft border border-hairline flex items-center justify-center text-primary group-hover:bg-primary/10 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="font-mono text-xs text-mute group-hover:text-primary transition-colors">MODULE_02</span>
        </div>
        <h3 class="text-lg font-semibold text-ink mb-1 group-hover:text-primary transition-colors">Video Editing</h3>
        <p class="text-sm text-body line-clamp-2">DaVinci Resolve, Premiere Pro, motion graphics, and audio mastering.</p>
        <div class="mt-4 pt-4 border-t border-hairline flex items-center gap-1.5 text-xs font-mono text-mute">
          <span>Active courses:</span>
          <span class="text-ink font-semibold">2</span>
        </div>
      </button>

      <!-- Coding Skills -->
      <button 
        id="filter-card-coding" 
        data-filter-value="Coding Skills" 
        class="filter-card group text-left p-6 bg-canvas border border-hairline rounded-md hover:border-primary/50 transition-all duration-300 relative overflow-hidden focus:outline-none focus:ring-1 focus:ring-primary"
      >
        <div class="flex justify-between items-start mb-4">
          <div class="h-10 w-10 rounded-sm bg-canvas-soft border border-hairline flex items-center justify-center text-primary group-hover:bg-primary/10 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <span class="font-mono text-xs text-mute group-hover:text-primary transition-colors">MODULE_03</span>
        </div>
        <h3 class="text-lg font-semibold text-ink mb-1 group-hover:text-primary transition-colors">Coding Skills</h3>
        <p class="text-sm text-body line-clamp-2">Python design patterns, concurrent programming, Vite, and Tailwind v4.</p>
        <div class="mt-4 pt-4 border-t border-hairline flex items-center gap-1.5 text-xs font-mono text-mute">
          <span>Active courses:</span>
          <span class="text-ink font-semibold">2</span>
        </div>
      </button>
    </div>

    <!-- Dashed Divider -->
    <div class="border-rhythm max-w-5xl mx-auto my-4"></div>
  </header>

  <!-- Google AdSense Responsive Display Unit (Top Home Banner) -->
  <div class="max-w-6xl mx-auto px-6 mb-8">
    <div class="bg-canvas-soft/60 border border-hairline/60 rounded-md p-4 text-center">
      <div class="text-[10px] font-mono uppercase tracking-widest text-mute mb-2">Advertisement</div>
      <ins class="adsbygoogle block w-full overflow-hidden text-center min-h-[90px]"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="1234567890"
           data-ad-format="auto"
           data-full-width-responsive="true">
        <!-- Dev Placeholder Visual -->
        <div class="border border-dashed border-hairline rounded p-4 flex items-center justify-center gap-3 bg-canvas/40">
          <svg class="h-5 w-5 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-mono text-mute/80">Sponsored Learning Partners &amp; Community Announcements</span>
        </div>
      </ins>
    </div>
  </div>

  <!-- Courses Dashboard Area -->
  <main id="courses-section" class="max-w-6xl mx-auto px-6 pb-24 scroll-mt-24">
    
    <!-- YouTube-style Chip Navigation -->
    <nav id="home-feed-chips" class="flex gap-3 overflow-x-auto no-scrollbar pb-2 mb-8 -mx-6 px-6 md:mx-0 md:px-0 scroll-smooth">
      <button class="chip-btn active bg-ink text-canvas hover:bg-ink-strong px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-target="trending-section">Trending Courses</button>
      <button class="chip-btn bg-canvas-soft hover:bg-hairline/50 text-ink px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-target="editors-picks-section">Editor's Picks</button>
      <button class="chip-btn bg-canvas-soft hover:bg-hairline/50 text-ink px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-target="recently-added-section">Recently Added</button>
      <button class="chip-btn bg-canvas-soft hover:bg-hairline/50 text-ink px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-target="most-popular-section">Most Popular</button>
    </nav>

    <!-- Curated Home Highlights Grid Sections -->
    <div id="home-feed-container" class="space-y-16 mb-16">

      <!-- 1. Trending Courses Section -->
      <section id="trending-section" class="space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <h2 class="text-lg font-bold text-ink-strong font-mono uppercase tracking-wider">Trending Courses</h2>
            <span class="text-[10px] font-mono uppercase bg-canvas-soft text-body border border-hairline px-2.5 py-0.5 rounded-sm font-semibold">Active Feed</span>
          </div>
          <a href="/courses" class="text-xs font-mono text-primary hover:underline flex items-center gap-1">Explore Directory &rarr;</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {trendingCourses.map((course) => (
            <article class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer" data-slug={course.slug}>
              <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
                <img src={getYoutubeThumbnail(course.sampleVideoId)} alt={course.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                <button type="button" class="watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2 py-0.5 rounded-sm transition-all shadow-md text-[10px] font-mono border border-hairline flex items-center gap-1" data-slug={course.slug} title="Save to Watch Later">
                  <svg class="h-3 w-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span class="wl-label pointer-events-none">Watch later</span>
                </button>
                <span class={`absolute top-2.5 right-2.5 text-[9px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-sm font-semibold shadow-md ${course.type === 'paid' ? 'bg-amber-400 text-on-primary border border-amber-500/20' : 'bg-primary text-on-primary border border-primary-soft/20'}`}>{course.type || 'free'}</span>
                <div class="absolute bottom-2 right-2 z-20 bg-canvas/90 backdrop-blur-sm text-ink-strong border border-hairline px-2 py-0.5 rounded-sm text-[10px] font-mono flex items-center gap-1 shadow-md">
                  <span>{course.chapters?.length || 1} Modules</span>
                </div>
              </div>
              <div class="p-4 flex flex-col justify-between flex-grow">
                <div>
                  <div class="flex items-center gap-1.5 mb-2 flex-wrap">
                    <span class="text-[9px] font-mono uppercase bg-canvas border border-hairline px-2 py-0.5 rounded text-body">{course.category}</span>
                    <span class="text-[9px] font-mono uppercase bg-canvas border border-hairline/85 px-1.5 py-0.5 rounded text-mute">{course.language || 'English'}</span>
                  </div>
                  <h3 class="text-sm font-semibold text-ink-strong mb-2 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                    <a href={`/courses/${course.slug}`} class="focus:outline-none after:absolute after:inset-0">{course.title}</a>
                  </h3>
                  <a href={`/creators/${getCreatorSlug(course.creatorName)}`} class="flex items-center gap-1.5 hover:text-primary transition-colors group/creator shrink-0 relative z-30">
                    <img src={course.creatorLogo} alt={course.creatorName} class="h-5 w-5 rounded-full object-cover border border-hairline shrink-0" />
                    <span class="text-[11px] font-mono text-mute group-hover/creator:text-primary transition-colors leading-none">{course.creatorName}</span>
                  </a>
                </div>
                <div class="pt-3 border-t border-hairline flex justify-between items-center text-[10px] font-mono text-mute mt-3">
                  <span class="text-[10px] font-mono text-mute">Curated Course</span>
                  <a href={`/courses/${course.slug}`} class="inline-flex items-center gap-1 bg-primary/10 hover:bg-primary border border-primary/30 text-primary hover:text-on-primary px-2.5 py-1 rounded-sm text-[10px] font-mono font-bold uppercase transition-all relative z-30 shrink-0">
                    <span>Watch Now</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 2. Editor's Picks Section -->
      <section id="editors-picks-section" class="space-y-4 hidden">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <h2 class="text-lg font-bold text-ink-strong font-mono uppercase tracking-wider">Editor's Picks</h2>
            <span class="text-[10px] font-mono uppercase bg-canvas-soft text-body border border-hairline px-2.5 py-0.5 rounded-sm font-semibold">Curated</span>
          </div>
          <a href="/courses" class="text-xs font-mono text-primary hover:underline flex items-center gap-1">Explore Directory &rarr;</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {editorsPicks.map((course) => (
            <article class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer" data-slug={course.slug}>
              <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
                <img src={getYoutubeThumbnail(course.sampleVideoId)} alt={course.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                <button type="button" class="watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2 py-0.5 rounded-sm transition-all shadow-md text-[10px] font-mono border border-hairline flex items-center gap-1" data-slug={course.slug} title="Save to Watch Later">
                  <svg class="h-3 w-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span class="wl-label pointer-events-none">Watch later</span>
                </button>
                <span class={`absolute top-2.5 right-2.5 text-[9px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-sm font-semibold shadow-md ${course.type === 'paid' ? 'bg-amber-400 text-on-primary border border-amber-500/20' : 'bg-primary text-on-primary border border-primary-soft/20'}`}>{course.type || 'free'}</span>
                <div class="absolute bottom-2 right-2 z-20 bg-canvas/90 backdrop-blur-sm text-ink-strong border border-hairline px-2 py-0.5 rounded-sm text-[10px] font-mono flex items-center gap-1 shadow-md">
                  <span>{course.chapters?.length || 1} Modules</span>
                </div>
              </div>
              <div class="p-4 flex flex-col justify-between flex-grow">
                <div>
                  <div class="flex items-center gap-1.5 mb-2 flex-wrap">
                    <span class="text-[9px] font-mono uppercase bg-canvas border border-hairline px-2 py-0.5 rounded text-body">{course.category}</span>
                    <span class="text-[9px] font-mono uppercase bg-canvas border border-hairline/85 px-1.5 py-0.5 rounded text-mute">{course.language || 'English'}</span>
                  </div>
                  <h3 class="text-sm font-semibold text-ink-strong mb-2 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                    <a href={`/courses/${course.slug}`} class="focus:outline-none after:absolute after:inset-0">{course.title}</a>
                  </h3>
                  <a href={`/creators/${getCreatorSlug(course.creatorName)}`} class="flex items-center gap-1.5 hover:text-primary transition-colors group/creator shrink-0 relative z-30">
                    <img src={course.creatorLogo} alt={course.creatorName} class="h-5 w-5 rounded-full object-cover border border-hairline shrink-0" />
                    <span class="text-[11px] font-mono text-mute group-hover/creator:text-primary transition-colors leading-none">{course.creatorName}</span>
                  </a>
                </div>
                <div class="pt-3 border-t border-hairline flex justify-between items-center text-[10px] font-mono text-mute mt-3">
                  <span class="text-[10px] font-mono text-mute">Curated Course</span>
                  <a href={`/courses/${course.slug}`} class="inline-flex items-center gap-1 bg-primary/10 hover:bg-primary border border-primary/30 text-primary hover:text-on-primary px-2.5 py-1 rounded-sm text-[10px] font-mono font-bold uppercase transition-all relative z-30 shrink-0">
                    <span>Watch Now</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 3. Recently Added Section -->
      <section id="recently-added-section" class="space-y-4 hidden">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h2 class="text-lg font-bold text-ink-strong font-mono uppercase tracking-wider">Recently Added</h2>
            <span class="text-[10px] font-mono uppercase bg-canvas-soft text-body border border-hairline px-2.5 py-0.5 rounded-sm font-semibold">New Additions</span>
          </div>
          <a href="/courses" class="text-xs font-mono text-primary hover:underline flex items-center gap-1">Explore Directory &rarr;</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {recentlyAddedCourses.map((course) => (
            <article class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer" data-slug={course.slug}>
              <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
                <img src={getYoutubeThumbnail(course.sampleVideoId)} alt={course.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
