---
import Layout from '../layouts/Layout.astro';

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const isDev = import.meta.env.DEV;
---

<Layout title="500: Server Error | FreeYTCourses" description="An unexpected error occurred." hideSidebar={true}>
  <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4">
    <!-- Graphic / Icon -->
    <div class="relative mb-8">
      <div class="absolute inset-0 bg-red-500/20 blur-3xl rounded-full"></div>
      <div class="relative bg-canvas border border-hairline rounded-2xl p-6 shadow-xl">
        <svg class="h-16 w-16 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
    </div>
    
    <h1 class="text-6xl font-bold text-ink mb-4 font-mono">500</h1>
    <h2 class="text-2xl font-semibold text-ink mb-3">Internal Server Error</h2>
    <p class="text-mute max-w-md mx-auto mb-8 text-sm md:text-base leading-relaxed">
      Oops! Something went wrong on our end. Our servers are having a little hiccup. Please try again in a few moments.
    </p>

    {isDev && error instanceof Error && (
      <div class="mb-8 w-full max-w-2xl text-left bg-canvas/50 border border-red-500/30 rounded-md p-4 overflow-x-auto">
        <p class="text-red-400 font-mono text-xs mb-2">Development Error Details:</p>
        <pre class="text-mute font-mono text-[10px] leading-relaxed">{error.message}</pre>
        {error.stack && (
          <pre class="text-mute font-mono text-[10px] leading-relaxed mt-2 opacity-70">{error.stack}</pre>
        )}
      </div>
    )}
    
    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
      <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-content hover:bg-primary/90 font-medium rounded-sm transition-colors w-full sm:w-auto shadow-sm">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Return Home
      </a>
      <button onclick="window.location.reload()" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-canvas border border-hairline text-ink hover:border-hairline-soft font-medium rounded-sm transition-colors w-full sm:w-auto">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Try Again
      </button>
    </div>
  </div>
</Layout>
