---
import Layout from '../../layouts/Layout.astro';
import { getAllCourses, getYoutubeThumbnail, getCreatorSlug } from '../../lib/firebase.js';

const allCourses = await getAllCourses();
const courses = allCourses.filter(course => course.isEmbeddable !== false);
// Dynamically compute unique languages
const languages = Array.from(new Set(courses.map(c => c.language || "English").filter(Boolean)));

const title = "Courses Directory - Filter & Browse YouTube Courses";
const description = "Filter, search, and sort high-quality curated YouTube courses for AI Engineering, Video Editing, and Coding Skills.";
---

<Layout title={title} description={description} activePage="courses">
  <main id="courses-section" class="max-w-6xl mx-auto px-6 py-8 md:py-12">
    <!-- Top Header -->

    <div class="mb-8 pb-4 border-b border-hairline flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-2xl font-light text-ink-strong tracking-tight flex items-center gap-3">
          Courses Directory
        </h1>
        <p class="text-xs font-mono text-mute mt-1">Structured learning modules filtered by skills, language, and ratings.</p>
      </div>
    </div>

    <!-- Google AdSense Responsive Display Unit (Courses Directory Banner) -->
    <div class="mb-10 bg-canvas-soft/60 border border-hairline/60 rounded-md p-4 text-center">
      <div class="text-[10px] font-mono uppercase tracking-widest text-mute mb-2">Advertisement</div>
      <ins class="adsbygoogle block w-full overflow-hidden text-center min-h-[90px]"
           style="display:block"
           data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
           data-ad-slot="4567890123"
           data-ad-format="auto"
           data-full-width-responsive="true">
        <!-- Dev Placeholder Visual -->
        <div class="border border-dashed border-hairline rounded p-4 flex items-center justify-center gap-3 bg-canvas/40">
          <svg class="h-5 w-5 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-mono text-mute/80">Sponsored Learning Partners &amp; Community Announcements</span>
        </div>
      </ins>
    </div>

    <!-- User Retention: Continue Learning Section -->
    <section id="continue-learning-section" class="hidden mb-10 bg-canvas border border-hairline rounded-md p-6">
      <div class="flex items-center gap-2 mb-4">
        <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h2 class="text-xs font-mono uppercase tracking-[2.52px] text-ink-strong font-semibold">Continue Learning</h2>
      </div>
      <div id="continue-learning-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Dynamically populated -->
      </div>
    </section>

    <!-- Quick Filters (Pill Tags) -->
    <nav id="courses-feed-chips" class="flex gap-3 overflow-x-auto no-scrollbar pb-2 mb-6 -mx-6 px-6 md:mx-0 md:px-0 scroll-smooth">
      <button class="chip-btn bg-canvas-soft hover:bg-hairline/50 text-ink px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors" data-target="top-rated">⭐ Top Rated</button>
    </nav>

    <!-- YouTube-style Filter Button and Panel -->
    <div class="mb-8">
      <button type="button" id="filter-toggle-btn" class="inline-flex items-center gap-2 bg-canvas hover:bg-canvas-soft text-ink-strong px-4 py-2 rounded-full border border-hairline transition-colors text-sm font-semibold cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary group shadow-sm">
        Filters
        <svg class="h-4 w-4 text-mute group-hover:text-ink-strong transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
      </button>

      <div id="filter-panel" class="hidden border-t border-hairline pt-6 mt-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          
          <!-- Skill / Category -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Skill</h4>
            <div class="flex flex-col gap-3" id="skill-filter-list">
              <button type="button" class="filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none" data-filter-type="skill" data-value="All">All Courses</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="skill" data-value="AI Engineering">AI Engineering</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="skill" data-value="Video Editing">Video Editing</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="skill" data-value="Coding Skills">Coding Skills</button>
            </div>
          </div>

          <!-- Language -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Language</h4>
            <div class="flex flex-col gap-3" id="language-filter-list">
              <button type="button" class="filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none" data-filter-type="language" data-value="All">All Languages</button>
              {languages.map((lang) => (
                <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="language" data-value={lang}>{lang}</button>
              ))}
            </div>
          </div>

          <!-- Modules -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Modules</h4>
            <div class="flex flex-col gap-3" id="module-filter-list">
              <button type="button" class="filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none" data-filter-type="module" data-value="All">All Modules</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="module" data-value="single">Crashcourse (1)</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="module" data-value="multi">Playlist/Chapters (2+)</button>
            </div>
          </div>

          <!-- Sort By -->
          <div class="flex flex-col gap-4">
            <h4 class="text-[11px] font-mono uppercase tracking-[0.1em] text-ink-strong font-semibold border-b border-hairline pb-2">Prioritize</h4>
            <div class="flex flex-col gap-3" id="sort-filter-list">
              <button type="button" class="filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none" data-filter-type="sort" data-value="most-watched">Popularity</button>
              <button type="button" class="filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none" data-filter-type="sort" data-value="latest">Latest</button>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Course Cards Grid -->
    <div id="course-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {courses.map((course) => (
        <article 
          class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer"
          data-id={course.id}
          data-category={course.category}
          data-language={course.language || 'English'}
          data-views={course.views}
          data-votes={course.votes}
          data-rating={course.rating}
          data-date={course.publishDate}
          data-creator={course.creatorName}
          data-slug={course.slug}
          data-rating-count={(course as any).ratingCount || 1}
          data-module-type={course.moduleType || (course.chapters && course.chapters.length === 1 ? 'single' : 'multi')}
        >
          <!-- Prominent Thumbnail & Promo Badge -->
          <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
            <img 
              src={course.thumbnail || getYoutubeThumbnail(course.sampleVideoId)} 
              alt={`${course.title} thumbnail`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Always-Visible Watch Later Button -->
            <button 
              type="button" 
              class="watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-hairline hover:border-primary flex items-center gap-1.5 text-[11px] font-mono"
              data-slug={course.slug}
              title="Save to Watch Later"
            >
              <svg class="h-3.5 w-3.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="wl-label pointer-events-none">Watch later</span>
            </button>
            <span class={`absolute top-3 right-3 text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-sm font-semibold shadow-md ${course.type === 'paid' ? 'bg-amber-400 text-on-primary border border-amber-500/20' : 'bg-primary text-on-primary border border-primary-soft/20'}`}>
              {course.type}
            </span>
            <!-- Modules Count Overlay Badge -->
            <div class="absolute bottom-2.5 right-2.5 z-20 bg-canvas/90 backdrop-blur-sm text-ink-strong border border-hairline px-2 py-0.5 rounded-sm text-[10px] font-mono flex items-center gap-1.5 shadow-md">
              <svg class="h-3 w-3 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>{course.chapters?.length || 0} Modules</span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex flex-col justify-between flex-grow">
            <div>
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] font-mono uppercase bg-canvas border border-hairline px-2.5 py-0.5 rounded-pill text-body">
                    {course.category}
                  </span>
                  <span class="text-[10px] font-mono uppercase bg-canvas border border-hairline/85 px-2 py-0.5 rounded-sm text-mute">
                    {course.language || 'English'}
                  </span>
                </div>
                <span class="text-xs font-mono text-mute">{course.duration}</span>
              </div>

              <h2 class="text-lg font-semibold text-ink-strong mb-2.5 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                <a href={`/courses/${course.slug}`} class="focus:outline-none after:absolute after:inset-0">
                  {course.title}
                </a>
              </h2>

              <a href={`/creators/${getCreatorSlug(course.creatorName)}`} class="flex items-center gap-2 hover:text-primary transition-colors group/creator shrink-0 relative z-30">
                <img 
                  src={course.creatorLogo} 
                  alt={course.creatorName} 
                  class="h-6 w-6 rounded-full object-cover border border-hairline shrink-0 group-hover/creator:border-primary transition-colors"
                  onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=random&color=fff';"
                />
                <div class="flex flex-col">
                  <span class="text-xs font-mono text-mute group-hover/creator:text-primary transition-colors leading-none">{course.creatorName}</span>
                  <span class="text-[9px] font-mono text-mute/50 leading-none mt-1">{course.creatorSubscribers || "Verified Channel"}</span>
                </div>
              </a>
            </div>

            <div>
              <!-- Card Footer with Watch Now Action Button -->
              <div class="pt-3.5 border-t border-hairline flex justify-between items-center text-[11px] font-mono text-mute mt-4">
                <span class="text-xs text-mute font-mono">Curated Course</span>
                <a 
                  href={`/courses/${course.slug}`}
                  class="inline-flex items-center gap-1.5 bg-primary/10 hover:bg-primary border border-primary/30 hover:border-primary text-primary hover:text-on-primary px-3.5 py-1.5 rounded-sm text-xs font-mono font-bold uppercase transition-all duration-200 cursor-pointer relative z-30 shrink-0 shadow-sm group/btn"
                >
                  <span>Watch Now</span>
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state card -->
    <div id="empty-state" class="hidden text-center p-8 sm:p-12 bg-canvas-soft border border-hairline border-dashed rounded-md my-12 max-w-xl mx-auto">
      <svg class="mx-auto h-12 w-12 text-mute mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 id="empty-state-title" class="text-lg font-semibold text-ink mb-1 font-mono uppercase tracking-wider">No Courses Found</h3>
      <p id="empty-state-text" class="text-sm text-body mb-6 font-light">No curated courses match the selected search parameters or skill categories.</p>
      
      <!-- Category Shortcut Chips -->
      <div class="pt-4 border-t border-hairline/60">
        <span class="text-[11px] font-mono uppercase text-mute tracking-wider block mb-3 font-semibold">Explore Popular Categories:</span>
        <div class="flex flex-wrap justify-center gap-2">
          <button 
            type="button" 
            onclick="window.setFilter && window.setFilter('AI Engineering')" 
            class="text-xs font-mono bg-canvas border border-hairline hover:border-primary text-ink px-3 py-1.5 rounded-sm transition-all cursor-pointer hover:bg-primary/10"
          >
            AI Engineering
          </button>
          <button 
            type="button" 
            onclick="window.setFilter && window.setFilter('Video Editing')" 
            class="text-xs font-mono bg-canvas border border-hairline hover:border-primary text-ink px-3 py-1.5 rounded-sm transition-all cursor-pointer hover:bg-primary/10"
          >
            Video Editing
          </button>
          <button 
            type="button" 
            onclick="window.setFilter && window.setFilter('Coding Skills')" 
            class="text-xs font-mono bg-canvas border border-hairline hover:border-primary text-ink px-3 py-1.5 rounded-sm transition-all cursor-pointer hover:bg-primary/10"
          >
            Coding Skills
          </button>
          <button 
            type="button" 
            onclick="window.setFilter && window.setFilter('All')" 
            class="text-xs font-mono bg-primary text-on-primary font-bold px-3 py-1.5 rounded-sm transition-all cursor-pointer hover:bg-primary-soft"
          >
            View All Courses
          </button>
        </div>
      </div>
    </div>

    <div id="courses-data" data-courses={JSON.stringify(courses)} class="hidden"></div>
  </main>

  <script>
    import { getCourseSiteViews, recordCourseSiteView, getWatchLater, setWatchLater } from '../../lib/userStorage.js';

    // Filter Panel Elements
    const filterPanel = document.getElementById('filter-panel');
    const filterToggleBtn = document.getElementById('filter-toggle-btn');
    
    filterToggleBtn?.addEventListener('click', () => {
      filterPanel?.classList.toggle('hidden');
    });

    filterPanel?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-option');
      if (!btn) return;
      
      const filterType = btn.getAttribute('data-filter-type');
      const value = btn.getAttribute('data-value');
      
      if (filterType && value) {
        if (filterType === 'skill') setFilter(value);
        else if (filterType === 'language') setLanguage(value);
        else if (filterType === 'module') setModuleType(value);
        else if (filterType === 'sort') setSort(value);
      }
    });

    function updateFilterUI(type: string, value: string) {
      const listId = `${type}-filter-list`;
      const list = document.getElementById(listId);
      if (!list) return;
      
      const buttons = list.querySelectorAll('.filter-option');
      buttons.forEach(b => {
        if (b.getAttribute('data-value') === value) {
          b.className = 'filter-option text-sm text-left transition-colors font-semibold text-ink-strong focus:outline-none';
        } else {
          b.className = 'filter-option text-sm text-left hover:text-ink transition-colors text-body focus:outline-none';
        }
      });
    }

    const courseGrid = document.getElementById('course-grid');
    const emptyState = document.getElementById('empty-state');
    
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    let searchQuery = '';
    
    let activeFilter = 'All';
    let activeLanguage = 'All';
    let activeModuleType = 'All';
    let activeSort = 'most-watched';

    const coursesDataEl = document.getElementById('courses-data');
    const allCourses = JSON.parse(coursesDataEl?.getAttribute('data-courses') || '[]');

    // Populate skill/category filter options dynamically from stored categories
    function populateCategoryOptions() {
      const skillFilterList = document.getElementById('skill-filter-list');
      if (!skillFilterList) return;
      try {
        const raw = localStorage.getItem('freeyt_categories');
        const cats = raw ? JSON.parse(raw) : ["AI Engineering", "Video Editing", "Coding Skills"];
        const cur = activeFilter;

        let html = `<button type="button" class="filter-option text-sm text-left transition-colors ${cur === 'All' ? 'font-semibold text-ink-strong' : 'hover:text-ink text-body'} focus:outline-none" data-filter-type="skill" data-value="All">All Courses</button>`;
        cats.forEach((cat: string) => {
          const isActive = cat === cur;
          html += `<button type="button" class="filter-option text-sm text-left transition-colors ${isActive ? 'font-semibold text-ink-strong' : 'hover:text-ink text-body'} focus:outline-none" data-filter-type="skill" data-value="${cat}">${cat}</button>`;
        });
        skillFilterList.innerHTML = html;
        
        if (!cats.includes(cur) && cur !== 'All') {
           activeFilter = 'All';
           populateCategoryOptions(); // re-render to highlight 'All'
        }
      } catch (e) {}
    }

    import { scoreCourse } from '../../lib/searchEngine.js';

    function calculateCourseRank(course: any): number {
      if (!course) return 0;
      const siteViews = getCourseSiteViews(course.slug);
      const featuredBonus = course.featured ? 25 : 0;
      const siteViewsScore = Math.min((siteViews || 0) * 10, 50);
      const year = typeof course.publishedYear === 'number' 
        ? course.publishedYear 
        : (course.publishDate ? new Date(course.publishDate).getFullYear() : 0);
      const recencyScore = year >= 2025 ? 25 : 15;
      return featuredBonus + siteViewsScore + recencyScore;
    }

    // Read ?q= URL param on page load and pre-fill search input
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || '';
    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
      searchQuery = initialQuery;
    }
    
    const initialSkill = urlParams.get('skill');
    if (initialSkill) {
      activeFilter = initialSkill;
      updateFilterUI('skill', initialSkill);
    }

    // Listen for live search events
    function handleSearchEvent(e: Event) {
      const customEvt = e as CustomEvent;
      searchQuery = typeof customEvt.detail === 'string' ? customEvt.detail : customEvt.detail?.query || '';
      if (searchInput && searchInput.value !== searchQuery) {
        searchInput.value = searchQuery;
      }
      applyFiltersAndSort();
    }

    window.addEventListener('course-search', handleSearchEvent as EventListener);
    window.addEventListener('globalSearchInput', handleSearchEvent as EventListener);

    // Filter click handling is now consolidated in the filterPanel event delegation

    window.addEventListener('categoriesChanged', () => {
      populateCategoryOptions();
      applyFiltersAndSort();
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'freeyt_categories') {
        populateCategoryOptions();
        applyFiltersAndSort();
      }
    });

    function setFilter(category: string) {
      activeFilter = category;
      updateFilterUI('skill', category);
      applyFiltersAndSort();
    }

    function setSort(sortType: string) {
      activeSort = sortType;
      updateFilterUI('sort', sortType);
      applyFiltersAndSort();
    }

    function setLanguage(lang: string) {
      activeLanguage = lang;
      updateFilterUI('language', lang);
      applyFiltersAndSort();
    }

    function setModuleType(modType: string) {
      activeModuleType = modType;
      updateFilterUI('module', modType);
      applyFiltersAndSort();
    }

    (window as any).setFilter = setFilter;
    (window as any).setSort = setSort;
    (window as any).setLanguage = setLanguage;
    (window as any).setModuleType = setModuleType;

    let isTopRatedActive = false;
    document.getElementById('courses-feed-chips')?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.chip-btn');
      if (!target) return;
      const isTopRated = target.getAttribute('data-target') === 'top-rated';
      if (isTopRated) {
        isTopRatedActive = !isTopRatedActive;
        if (isTopRatedActive) {
          target.classList.remove('bg-canvas-soft', 'text-ink', 'hover:bg-hairline/50');
          target.classList.add('bg-ink', 'text-canvas', 'hover:bg-ink-strong', 'active');
        } else {
          target.classList.add('bg-canvas-soft', 'text-ink', 'hover:bg-hairline/50');
          target.classList.remove('bg-ink', 'text-canvas', 'hover:bg-ink-strong', 'active');
        }
        applyFiltersAndSort();
      }
    });

    function applyFiltersAndSort() {
      if (!courseGrid) return;
      const cards = Array.from(courseGrid.getElementsByClassName('course-card')) as HTMLElement[];
      const currentQuery = (searchQuery || searchInput?.value || '').trim();

      const scoredCards: { card: HTMLElement; score: number }[] = [];
      let visibleCount = 0;

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        const lang = card.getAttribute('data-language') || 'English';
        const modType = card.getAttribute('data-module-type') || 'multi';
        const slug = card.getAttribute('data-slug');
        const course = allCourses.find((c: any) => c.slug === slug);

        const matchesCategory = activeFilter === 'All' || cat === activeFilter;
        const matchesLanguage = activeLanguage === 'All' || lang === activeLanguage;
        const matchesModuleType = activeModuleType === 'All' || modType === activeModuleType;

        let score = 0;
        let matchesSearch = true;

        if (currentQuery.length > 0 && course) {
          const relevanceScore = scoreCourse(course, currentQuery, calculateCourseRank);
          if (relevanceScore === 0) {
            matchesSearch = false;
          } else {
            score = relevanceScore;
          }
        } else if (course) {
          score = calculateCourseRank(course);
        }

        if (matchesCategory && matchesLanguage && matchesModuleType && matchesSearch) {
          card.classList.remove('hidden');
          scoredCards.push({ card, score });
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const emptyTitleEl = document.getElementById('empty-state-title');
      const emptyTextEl = document.getElementById('empty-state-text');

      if (visibleCount === 0) {
        if (emptyState) {
          emptyState.classList.remove('hidden');
          if (currentQuery) {
            if (emptyTitleEl) emptyTitleEl.textContent = `No courses found matching "${currentQuery}"`;
            if (emptyTextEl) emptyTextEl.textContent = `No curated courses matched all of your search terms. Try searching by creator, tool, or broad category.`;
          } else {
            if (emptyTitleEl) emptyTitleEl.textContent = `No Courses Found`;
            if (emptyTextEl) emptyTextEl.textContent = `No curated courses match the selected search parameters or skill categories.`;
          }
        }
        courseGrid.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        courseGrid.classList.remove('hidden');
      }

      scoredCards.sort((a, b) => {
        if (isTopRatedActive) {
          const cardA = a.card;
          const cardB = b.card;
          const ratingA = parseFloat(cardA.getAttribute('data-rating') || '4.5');
          const ratingB = parseFloat(cardB.getAttribute('data-rating') || '4.5');
          if (ratingB !== ratingA) return ratingB - ratingA;
          const countA = parseInt(cardA.getAttribute('data-rating-count') || '1', 10);
          const countB = parseInt(cardB.getAttribute('data-rating-count') || '1', 10);
          return countB - countA;
        }

        if (currentQuery.length > 0) {
          if (b.score !== a.score) {
            return b.score - a.score;
          }
        } else {
          if (activeSort === 'latest') {
            const cardA = a.card;
            const cardB = b.card;
            const dateA = new Date(cardA.getAttribute('data-date') || '');
            const dateB = new Date(cardB.getAttribute('data-date') || '');
            return dateB.getTime() - dateA.getTime();
          } else {
            if (b.score !== a.score) {
              return b.score - a.score;
            }
          }
        }
        return b.score - a.score;
      });

      scoredCards.forEach((item) => {
        courseGrid.appendChild(item.card);
      });
    }

    function showToast(message: string, actionText = '', actionUrl = '') {
      let container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'fixed bottom-6 left-6 z-50 flex flex-col gap-2 pointer-events-none';
        document.body.appendChild(container);
      }

      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto bg-canvas-soft border border-primary/50 text-ink px-4 py-3 rounded-md shadow-2xl flex items-center gap-4 text-xs font-mono transition-all duration-300';
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>${message}</span>
        </div>
        ${actionText && actionUrl ? `<a href="${actionUrl}" class="text-primary font-bold hover:underline shrink-0">${actionText} &rarr;</a>` : ''}
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function updateWatchLaterButtons() {
      const wl = getWatchLater();

      document.querySelectorAll('.watch-later-toggle-btn').forEach(btn => {
        const slug = btn.getAttribute('data-slug');
        const label = btn.querySelector('.wl-label');
        if (slug && Array.isArray(wl) && wl.includes(slug)) {
          btn.className = "watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-primary text-on-primary font-bold px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-primary flex items-center gap-1.5 text-[11px] font-mono";
          if (label) label.textContent = "Saved";
          btn.setAttribute('title', 'Saved to Watch Later (Click to remove)');
        } else {
          btn.className = "watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-hairline hover:border-primary flex items-center gap-1.5 text-[11px] font-mono";
          if (label) label.textContent = "Watch later";
          btn.setAttribute('title', 'Save to Watch Later');
        }
      });
    }

    document.querySelectorAll('.watch-later-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = btn.getAttribute('data-slug');
        if (!slug) return;

        let wl = getWatchLater();

        const isSaved = wl.includes(slug);
        if (isSaved) {
          wl = wl.filter((s: string) => s !== slug);
          showToast('Removed from Watch Later');
        } else {
          wl.push(slug);
          showToast('Saved to Watch Later', 'View Playlist', '/watch-later');
        }

        setWatchLater(wl);
        updateWatchLaterButtons();
      });
    });

    document.querySelectorAll('.course-card').forEach((card) => {
      card.addEventListener('click', () => {
        const slug = card.getAttribute('data-slug');
        if (slug) {
          recordCourseSiteView(slug);
        }
      });
    });

    populateCategoryOptions();
    applyFiltersAndSort();
    updateWatchLaterButtons();
    window.addEventListener('watchLaterChanged', updateWatchLaterButtons);
  </script>
</Layout>
