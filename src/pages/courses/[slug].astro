---
import Layout from "../../layouts/Layout.astro";
import {
  getCourseBySlug,
  getCreatorSlug,
  getYoutubeThumbnail,
} from "../../lib/firebase.js";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const course = await getCourseBySlug(slug);

if (!course) {
  return Astro.redirect("/404");
}

const modules =
  course?.chapters && course.chapters.length > 0
    ? course.chapters
    : course?.modules && course.modules.length > 0
      ? course.modules
      : [
          {
            title: course?.title || "Full Course Video",
            videoId:
              course?.videoUrl ||
              course?.youtubeId ||
              course?.sampleVideoId ||
              "",
            creatorDescription: course?.creatorDescription || "",
          },
        ];
---

<Layout
  title={`${course.title} | FreeYTCourses`}
  description={course.description || course.overview}
  ogImage={course.thumbnail || getYoutubeThumbnail(course.sampleVideoId)}
  activePage="courses"
>
  <main class="max-w-6xl mx-auto px-6 py-12 md:py-20">
    <!-- Course Title & Category Eyebrow -->

    <header class="mb-12 border-b border-hairline pb-8">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span
          class="text-xs font-mono uppercase bg-primary/10 border border-primary/20 text-primary px-3 py-1 rounded-pill"
        >
          {course.category}
        </span>
        <span class="text-xs font-mono text-mute border-l border-hairline pl-3">
          Published {
            new Date(course.publishDate).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
            })
          }
        </span>
      </div>
      <h1
        class="text-3xl md:text-5xl font-light text-ink-strong tracking-tight leading-tight mb-4 break-words"
      >
        {course.title}
      </h1>
    </header>

    <!-- Content Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      <!-- Left Column: Editorial Overview & Chapter Outline (AdSense Focus) -->
      <section class="lg:col-span-2 space-y-12">
        <!-- Embedded Video Player Area -->
        <div id="video-player-wrapper" class="relative">
          <div
            id="video-player-container"
            class="border border-hairline bg-canvas rounded-md overflow-hidden relative shadow-2xl transition-all duration-300"
          >
            <div
              class="aspect-video w-full relative group overflow-hidden bg-black rounded-2xl"
            >
              <div id="youtube-player" class="absolute inset-0 w-full h-full">
              </div>
              <div
                id="video-poster-overlay"
                class="absolute inset-0 w-full h-full bg-cover bg-center flex flex-col items-center justify-center p-6 bg-canvas/80 text-center transition-opacity duration-300 z-10"
                style={`background-image: linear-gradient(rgba(16,16,16,0.85), rgba(16,16,16,0.85)), url(https://img.youtube.com/vi/${course.sampleVideoId}/hqdefault.jpg)`}
              >
                <div
                  class="h-16 w-16 rounded-full bg-primary/15 border border-primary/30 flex items-center justify-center text-primary mb-4 hover:bg-primary/20 hover:scale-110 transition-all duration-300 cursor-pointer shadow-lg shadow-primary/10"
                  id="start-video-btn"
                >
                  <svg
                    class="h-8 w-8 fill-current translate-x-0.5"
                    viewBox="0 0 24 24"
                  >
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
                <h3
                  id="poster-chapter-title"
                  class="text-lg font-semibold text-white tracking-tight max-w-md line-clamp-1 mb-1 font-mono uppercase"
                >
                  {modules[0]?.title || "Start Course"}
                </h3>
                <p
                  class="text-xs text-white/70 font-mono uppercase tracking-wider mb-4"
                >
                  Click to play course video on site
                </p>
                <div
                  id="resume-banner"
                  class="hidden text-xs bg-primary/20 border border-primary/30 rounded px-3 py-1.5 font-mono text-primary animate-pulse"
                >
                  Resume from <span id="resume-chapter-name">Chapter 1</span> at <span
                    id="resume-chapter-time">0:00</span
                  >
                </div>
              </div>

              <!-- Custom Control Bar -->
              <div
                id="custom-player-controls"
                class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-slate-950/90 to-transparent flex flex-col gap-2 transition-opacity duration-300 opacity-0 group-hover:opacity-100 focus-within:opacity-100 z-30 pointer-events-none"
              >
                <!-- Scrub Slider -->
                <input
                  type="range"
                  id="player-scrub"
                  class="w-full h-1 bg-white/30 rounded-lg appearance-none cursor-pointer hover:h-2 transition-all accent-primary pointer-events-auto"
                  min="0"
                  max="100"
                  value="0"
                  step="0.1"
                />

                <div
                  class="flex items-center justify-between text-white font-mono text-[10px] sm:text-xs pointer-events-auto"
                >
                  <div class="flex items-center gap-1 sm:gap-4">
                    <button
                      id="player-play-btn"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                    >
                      <svg
                        id="icon-play"
                        class="h-6 w-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
                      >
                      <svg
                        id="icon-pause"
                        class="h-6 w-6 hidden"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path></svg
                      >
                    </button>

                    <button
                      id="player-skip-back"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      title="Skip back 10s"
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path></svg
                      >
                    </button>
                    <button
                      id="player-skip-fwd"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      title="Skip forward 10s"
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg
                      >
                    </button>

                    <div class="flex items-center gap-1 sm:gap-2 group/vol">
                      <button
                        id="player-mute-btn"
                        class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      >
                        <svg
                          id="icon-vol-up"
                          class="h-4 w-4 sm:h-5 sm:w-5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                          ></path></svg
                        >
                        <svg
                          id="icon-vol-mute"
                          class="h-4 w-4 sm:h-5 sm:w-5 hidden"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"
                          ></path></svg
                        >
                      </button>
                      <input
                        type="range"
                        id="player-volume"
                        class="hidden sm:block w-16 h-1 bg-white/30 rounded-lg appearance-none cursor-pointer accent-primary opacity-0 group-hover/vol:opacity-100 transition-opacity"
                        min="0"
                        max="100"
                        value="100"
                      />
                    </div>
                    <span
                      id="player-time-display"
                      class="ml-1 sm:ml-2 opacity-80 shrink-0">0:00 / 0:00</span
                    >
                  </div>
                  <div class="flex items-center gap-1 sm:gap-4">
                    <button
                      id="pip-toggle-btn"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1 hidden sm:block"
                      title="Picture in Picture"
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
                        ></rect><rect
                          x="11"
                          y="10"
                          width="9"
                          height="6"
                          rx="1"
                          ry="1"
                          fill="currentColor"
                          opacity="0.3"></rect></svg
                      >
                    </button>
                    <button
                      id="hero-watch-later-btn"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      title="Watch Later"
                      data-slug={course.slug}
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                      </svg>
                    </button>
                    <button
                      id="mark-complete-btn"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      title="Mark Completed"
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 13l4 4L19 7"></path></svg
                      >
                    </button>

                    <button
                      id="player-rate-btn"
                      class="hover:text-primary transition-colors focus:outline-none font-bold cursor-pointer hidden sm:block"
                      title="Playback Speed">1x</button
                    >
                    <button
                      id="player-fullscreen-btn"
                      class="hover:text-primary transition-colors focus:outline-none cursor-pointer p-1"
                      title="Fullscreen"
                    >
                      <svg
                        class="h-4 w-4 sm:h-5 sm:w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                        ></path></svg
                      >
                    </button>
                  </div>
                </div>
              </div>

              <!-- Smart End Screen Overlay -->
              <div
                id="smart-end-screen"
                class="absolute inset-0 w-full h-full bg-slate-950/95 flex flex-col items-center justify-center p-6 text-center transition-opacity duration-300 z-40 hidden"
              >
                <div
                  id="end-screen-next"
                  class="hidden flex-col items-center gap-4"
                >
                  <p
                    class="text-xs font-mono text-primary uppercase tracking-wider"
                  >
                    Up Next
                  </p>
                  <h3
                    id="next-lesson-title"
                    class="text-xl font-semibold text-white tracking-tight max-w-md line-clamp-2 font-mono"
                  >
                    Next Lesson
                  </h3>

                  <div
                    class="w-48 h-1.5 bg-white/20 rounded-full overflow-hidden my-2"
                  >
                    <div
                      id="auto-advance-progress"
                      class="h-full bg-primary w-0 transition-all duration-100 ease-linear"
                    >
                    </div>
                  </div>

                  <div class="flex gap-4 mt-2">
                    <button
                      id="play-next-btn"
                      class="px-6 py-2 bg-primary text-on-primary font-mono text-sm uppercase rounded-sm hover:bg-primary/90 transition-all font-bold cursor-pointer shadow-lg shadow-primary/20"
                      >Play Next Now</button
                    >
                    <button
                      id="cancel-next-btn"
                      class="px-6 py-2 bg-transparent border border-white/20 text-white hover:bg-white/10 font-mono text-sm uppercase rounded-sm transition-all cursor-pointer"
                      >Cancel</button
                    >
                  </div>
                </div>

                <div
                  id="end-screen-done"
                  class="hidden flex-col items-center gap-4"
                >
                  <h3
                    class="text-2xl font-bold text-white tracking-tight font-mono"
                  >
                    🎉 Course Completed!
                  </h3>
                  <p class="text-sm text-slate-300 font-light max-w-md">
                    You've reached the end of this course. Great job!
                  </p>
                  <div class="flex gap-4 mt-4">
                    <button
                      id="replay-course-btn"
                      class="px-6 py-2 bg-transparent border border-white/20 text-white hover:bg-white/10 font-mono text-sm uppercase rounded-sm transition-all cursor-pointer flex items-center gap-2"
                    >
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                        ></path></svg
                      >
                      Replay Lesson
                    </button>
                    <a
                      href="/courses"
                      class="px-6 py-2 bg-primary text-on-primary font-mono text-sm uppercase rounded-sm hover:bg-primary/90 transition-all font-bold cursor-pointer shadow-lg shadow-primary/20"
                      >Explore More</a
                    >
                  </div>
                </div>
              </div>
              <!-- Double Tap Zones for Skiping & Center Click for Play/Pause -->
              <div
                id="zone-skip-back"
                class="absolute inset-y-0 left-0 w-1/3 z-20 cursor-pointer"
                title="Double tap to skip back"
              >
              </div>
              <div
                id="zone-play-pause"
                class="absolute inset-y-0 left-1/3 right-1/3 z-20 cursor-pointer"
              >
              </div>
              <div
                id="zone-skip-fwd"
                class="absolute inset-y-0 right-0 w-1/3 z-20 cursor-pointer"
                title="Double tap to skip forward"
              >
              </div>
            </div>
          </div>

          <!-- Placeholder shown when video is in PiP mode -->
          <div
            id="video-pip-placeholder"
            class="hidden border border-hairline border-dashed rounded-md bg-canvas-soft p-12 text-center flex flex-col items-center justify-center gap-3 min-h-[300px]"
          >
            <div
              class="h-12 w-12 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center text-primary"
            >
              <svg
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <rect
                  x="11"
                  y="10"
                  width="9"
                  height="6"
                  rx="1"
                  ry="1"
                  fill="currentColor"
                  opacity="0.4"></rect>
              </svg>
            </div>
            <p class="text-sm font-mono text-ink font-semibold">
              Video is playing in Picture-in-Picture
            </p>
            <p class="text-xs font-mono text-mute max-w-sm">
              The floating window stays on top of other applications. Close the
              PiP window to return the video here.
            </p>
          </div>
        </div>

        <!-- Module Details Tabbed Panel (Description, Assets, Syllabus) -->
        <div
          class="mt-8 border border-hairline rounded-md bg-canvas-soft overflow-hidden"
          id="module-details-container"
        >
          <div
            class="flex border-b border-hairline bg-canvas overflow-x-auto scrollbar-none"
          >
            <button
              type="button"
              id="tab-desc-btn"
              class="flex-1 py-3 px-2 sm:px-4 text-[10px] sm:text-xs font-mono uppercase tracking-wider text-mute hover:text-ink font-semibold border-b-2 border-transparent hover:bg-canvas-soft transition-colors focus:outline-none cursor-pointer whitespace-nowrap"
            >
              Creator Description
            </button>

            <button
              type="button"
              id="tab-syllabus-btn"
              class="flex-1 py-3 px-2 sm:px-4 text-[10px] sm:text-xs font-mono uppercase tracking-wider text-mute hover:text-ink font-semibold border-b-2 border-transparent hover:bg-canvas-soft transition-colors focus:outline-none cursor-pointer whitespace-nowrap"
            >
              Syllabus
            </button>
          </div>

          <div class="p-0">
            <!-- Creator Description Content -->
            <div
              id="module-description-content"
              class="p-6 text-sm text-body font-light whitespace-pre-line leading-relaxed hidden"
            >
              {
                modules[0]?.creatorDescription ||
                  course?.creatorDescription ||
                  "ℹ️ No description provided by creator for this lesson."
              }
            </div>

            <!-- Syllabus Content -->
            <div id="module-syllabus-content" class="hidden">
              <div class="bg-canvas divide-y divide-hairline">
                {
                  modules.map((chapter: any, index: number) => (
                    <button
                      type="button"
                      class="chapter-row w-full text-left p-4 flex justify-between items-center hover:bg-canvas-soft border-none bg-transparent cursor-pointer transition-all focus:outline-none border-b border-hairline last:border-b-0"
                      data-index={index}
                      data-video-id={chapter.videoId || course.sampleVideoId}
                      data-title={chapter.title}
                    >
                      <div class="flex items-center gap-4">
                        <div class="chapter-status-icon shrink-0">
                          <span class="font-mono text-xs text-primary bg-primary/10 border border-primary/20 h-6 w-6 rounded-full flex items-center justify-center font-bold">
                            {index + 1}
                          </span>
                        </div>
                        <div class="flex flex-col text-left">
                          <span class="text-sm text-ink font-medium transition-colors chapter-title-text">
                            {chapter.title}
                          </span>
                          <span class="chapter-progress-lbl text-[10px] text-mute font-mono mt-0.5 hidden">
                            0% watched
                          </span>
                        </div>
                      </div>
                      <div class="flex items-center gap-3">
                        <div class="w-16 h-1 bg-canvas border border-hairline rounded-sm overflow-hidden hidden sm:block chapter-progress-bar-container invisible">
                          <div
                            class="chapter-progress-bar-fill h-full bg-primary"
                            style="width: 0%"
                          />
                        </div>
                        <span class="font-mono text-xs text-mute shrink-0">
                          {chapter.duration}
                        </span>
                      </div>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- AdSense-Compliant Course Overview & Review Section -->
        <article
          class="p-6 md:p-8 bg-canvas-soft border border-hairline rounded-md"
        >
          <div class="flex items-center gap-2 mb-6">
            <svg
              class="h-5 w-5 text-primary"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            <h2
              class="text-lg font-mono uppercase tracking-wider text-ink-strong font-semibold"
            >
              Course Overview & Review
            </h2>
          </div>

          <!-- Detailed text critique (>200 words) -->
          <div
            class="text-body text-sm md:text-base leading-relaxed space-y-4 font-light"
          >
            <p class="whitespace-pre-wrap" id="course-overview-text">
              {course.overview}
            </p>
            <p
              class="border-t border-hairline/50 pt-4 mt-4 text-xs text-mute font-mono"
            >
              VERIFICATION STATUS: Curated curriculum meets our quality
              threshold. Free access validated. No hidden costs detected.
            </p>
          </div>
        </article>
      </section>

      <!-- Right Column: Sidebar Actions & Technical Specs -->
      <aside class="space-y-6 lg:sticky lg:top-24">
        <!-- Main Actions Card -->
        <div
          class="bg-canvas-soft border border-hairline rounded-md p-6 space-y-6"
        >
          <!-- CTA Action Button -->
          <button
            id="main-cta-btn"
            class="w-full text-center block bg-primary text-on-primary font-mono uppercase text-sm font-bold tracking-wider py-3.5 px-4 rounded-sm hover:bg-primary-soft transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-canvas cursor-pointer"
          >
            Start Course
          </button>

          <!-- Course Progress Panel -->
          <div
            id="course-progress-panel"
            class="hidden border border-hairline bg-canvas p-4 rounded-sm space-y-3"
          >
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-mute">COURSE COMPLETED:</span>
              <span id="course-progress-percent" class="text-primary font-bold"
                >0%</span
              >
            </div>
            <div
              class="w-full h-2 bg-canvas-soft border border-hairline rounded-sm overflow-hidden"
            >
              <div
                id="course-progress-bar"
                class="h-full bg-primary transition-all duration-300"
                style="width: 0%"
              >
              </div>
            </div>
            <div
              class="flex justify-between items-center text-[10px] font-mono text-mute"
            >
              <span id="course-progress-status">0 of 5 modules completed</span>
              <button
                id="reset-course-btn"
                class="hover:text-red-400 transition-colors bg-transparent border-none cursor-pointer focus:outline-none"
                >Reset</button
              >
            </div>
          </div>

          <a
            href={course.youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center text-[10px] font-mono text-mute hover:text-primary transition-colors mt-2"
          >
            Watch on YouTube directly ↗
          </a>

          <!-- Quick Stats Monospace Grid -->
          <div
            class="border-t border-hairline pt-6 grid grid-cols-2 gap-4 text-left"
          >
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase"
                >Duration</span
              >
              <span class="text-sm font-mono text-ink font-semibold"
                >{course.duration}</span
              >
            </div>
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase"
                >Author</span
              >
              <a
                href={`/creators/${getCreatorSlug(course.creatorName)}`}
                class="text-sm font-mono text-ink font-semibold line-clamp-1 hover:text-primary transition-colors duration-200"
              >
                {course.creatorName || course.author}
              </a>
              <a
                href={course.channelId
                  ? `https://www.youtube.com/channel/${course.channelId}`
                  : `https://www.youtube.com/results?search_query=${encodeURIComponent(course.creatorName || course.author)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[10px] font-mono text-primary hover:underline mt-1 block"
                title="View original YouTube Channel"
              >
                YouTube Channel ↗
              </a>
              <span class="block text-[9px] font-mono text-mute/50 mt-0.5"
                >{course.creatorSubscribers || "Verified Channel"}</span
              >
            </div>
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase"
                >Category</span
              >
              <span class="text-sm font-mono text-ink font-semibold"
                >{course.category}</span
              >
            </div>
            <div>
              <span class="block text-[10px] font-mono text-mute uppercase"
                >Modules</span
              >
              <span class="text-sm font-mono text-ink font-semibold"
                >{course.chapters?.length || 0} Modules</span
              >
            </div>
          </div>

          <!-- Required Tool Tags Block -->
          <div class="border-t border-hairline pt-6">
            <span class="block text-[10px] font-mono text-mute uppercase mb-3"
              >Required Tools & Stack</span
            >
            <div class="flex flex-wrap gap-1.5">
              {
                (course.tools || []).map((tool) => (
                  <span class="text-xs font-mono bg-canvas text-canvas-text-soft border border-hairline px-3 py-1 rounded-sm">
                    {tool}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        <!-- AdSense Placement Notice Block (Safe, compliant style) -->
        <div
          class="bg-canvas border border-hairline border-dashed rounded-md p-4 text-center"
        >
          <span
            class="font-mono text-[10px] text-mute uppercase tracking-widest block mb-2"
            >Advertisement</span
          >
          <div
            class="h-32 border border-hairline/50 rounded flex items-center justify-center bg-canvas-soft/30 text-mute text-xs font-mono"
          >
            Placeholder for AdSense Unit
          </div>
        </div>
      </aside>
    </div>
  </main>

  <!-- Dashed border accent between bands -->
  <div class="border-rhythm max-w-6xl mx-auto my-12"></div>

  <!-- Related Content / Notice -->
  <section class="max-w-6xl mx-auto px-6 pb-24 text-left">
    <div class="max-w-4xl">
      <h3
        class="text-lg font-mono uppercase tracking-wider text-ink-strong mb-4 font-semibold"
      >
        AdSense Text Quality Assurance Notice
      </h3>
      <p class="text-sm text-body leading-relaxed mb-4">
        To maintain absolute adherence to search engine quality guidelines, this
        curriculum details the structure, length, and review comments for the
        specific YouTube course shown. This prevents search engine spiders from
        categorizing the directory template as a 'Thin Content' layout or link
        gateway.
      </p>
      <p class="text-sm text-body leading-relaxed">
        All outbound resources lead to verified educational series. No scraping
        or automated summarization tools have been used to generate this page.
      </p>
    </div>
  </section>

  <div
    id="course-page-data"
    data-slug={course.slug}
    data-video-id={course.sampleVideoId}
    data-chapters={JSON.stringify(modules)}
    data-course-desc={course.creatorDescription || ""}
    class="hidden"
  >
  </div>

  <!-- Watch History & Playback Progress Engine -->
  <script>
    import {
      getWatchLater,
      setWatchLater,
      getWatchHistory,
      setWatchHistory,
      getUserStorageKey,
      recordCourseSiteView,
    } from "../../lib/userStorage.js";

    declare global {
      interface Window {
        YT: any;
        onYouTubeIframeAPIReady: any;
        getPlaybackProgress: any;
      }
    }

    interface ProgressState {
      completedChapters: number[];
      chapterPositions: Record<number, number>;
      chapterDurations: Record<number, number>;
      chapterPercentages: Record<number, number>;
      lastActiveIndex: number;
    }

    const dataEl = document.getElementById("course-page-data");
    const courseSlug = dataEl?.getAttribute("data-slug") || "";
    const courseVideoId = dataEl?.getAttribute("data-video-id") || "";
    let chaptersData: any[] = [];
    try {
      chaptersData = JSON.parse(dataEl?.getAttribute("data-chapters") || "[]");
    } catch (e) {
      chaptersData = [];
    }

    let player: any = null;
    let progressInterval: any = null;
    let apiPromise: Promise<any> | null = null;

    function getYoutubeId(url: string) {
      if (!url) return "";
      if (url.length === 11 && !url.includes("http")) return url;
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : url;
    }

    // 1. Record site view & history tracking logic
    if (courseSlug) {
      recordCourseSiteView(courseSlug);
      let history = getWatchHistory();
      history = history.filter((item: string) => item !== courseSlug);
      history.unshift(courseSlug);
      if (history.length > 4) {
        history = history.slice(0, 4);
      }
      setWatchHistory(history);
    }

    // 2. Video Player & Progress Tracking Logic
    const PROGRESS_KEY = getUserStorageKey(`freeyt_progress_${courseSlug}`);

    // Load state
    let progressState: ProgressState = {
      completedChapters: [],
      chapterPositions: {},
      chapterDurations: {},
      chapterPercentages: {},
      lastActiveIndex: 0,
    };

    try {
      const rawProgress = localStorage.getItem(PROGRESS_KEY);
      if (rawProgress) {
        progressState = JSON.parse(rawProgress);
      }
    } catch (e) {
      console.error("Failed to parse progress from localStorage", e);
    }

    // Ensure state integrity
    if (!Array.isArray(progressState.completedChapters))
      progressState.completedChapters = [];
    if (
      !progressState.chapterPositions ||
      typeof progressState.chapterPositions !== "object"
    )
      progressState.chapterPositions = {};
    if (
      !progressState.chapterDurations ||
      typeof progressState.chapterDurations !== "object"
    )
      progressState.chapterDurations = {};
    if (
      !progressState.chapterPercentages ||
      typeof progressState.chapterPercentages !== "object"
    )
      progressState.chapterPercentages = {};
    if (typeof progressState.lastActiveIndex !== "number")
      progressState.lastActiveIndex = 0;

    let activeChapterIndex = progressState.lastActiveIndex;

    // Load Youtube Iframe API Promise Wrapper
    function loadYoutubeAPI(): Promise<any> {
      if (apiPromise) return apiPromise;
      apiPromise = new Promise((resolve) => {
        if (window.YT && window.YT.Player) {
          resolve(window.YT);
          return;
        }

        const tag = document.createElement("script");
        tag.src = "https://www.youtube.com/iframe_api";
        const firstScriptTag = document.getElementsByTagName("script")[0];
        if (firstScriptTag && firstScriptTag.parentNode) {
          firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
        } else {
          document.head.appendChild(tag);
        }

        window.onYouTubeIframeAPIReady = () => {
          resolve(window.YT);
        };
      });
      return apiPromise;
    }

    async function initPlayer(videoId: string, startSeconds = 0): Promise<any> {
      const YT = await loadYoutubeAPI();
      return new Promise((resolve) => {
        player = new YT.Player("youtube-player", {
          height: "100%",
          width: "100%",
          videoId: videoId,
          playerVars: {
            autoplay: 1,
            playsinline: 1,
            rel: 0,
            modestbranding: 1,
            controls: 0,
            iv_load_policy: 3,
            enablejsapi: 1,
            start: Math.floor(startSeconds),
          },
          events: {
            onReady: () => {
              resolve(player);
            },
            onStateChange: (event: any) => {
              const iconPlay = document.getElementById("icon-play");
              const iconPause = document.getElementById("icon-pause");

              if (event.data === YT.PlayerState.PLAYING) {
                startProgressTracking();
                iconPlay?.classList.add("hidden");
                iconPause?.classList.remove("hidden");
              } else {
                stopProgressTracking();
                iconPlay?.classList.remove("hidden");
                iconPause?.classList.add("hidden");
              }

              if (event.data === YT.PlayerState.ENDED) {
                markActiveChapterCompleted();
                autoAdvanceToNextChapter();
              }
            },
            onError: async (event: any) => {
              if (event.data === 101 || event.data === 150) {
                console.warn(
                  "Video cannot be embedded. Auto-migrating to external directory...",
                );
                try {
                  await fetch("/api/update-embed", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      slug: courseSlug,
                      isEmbeddable: false,
                    }),
                  });
                } catch (e) {
                  console.error("Failed to update embed status:", e);
                }
                alert("This roadmap has been moved to our External directory.");
                window.location.href = "/external";
              }
            },
          },
        });
      });
    }

    function saveProgressToStorage() {
      localStorage.setItem(PROGRESS_KEY, JSON.stringify(progressState));
    }

    function startProgressTracking() {
      if (progressInterval) clearInterval(progressInterval);
      progressInterval = setInterval(() => {
        if (!player || typeof player.getCurrentTime !== "function") return;
        const currentTime = player.getCurrentTime();
        const duration = player.getDuration();
        if (!duration || duration <= 0) return;

        progressState.chapterPositions[activeChapterIndex] = currentTime;
        progressState.chapterDurations[activeChapterIndex] = duration;

        const percent = Math.floor((currentTime / duration) * 100);
        progressState.chapterPercentages[activeChapterIndex] = percent;

        // Auto complete if watched > 90%
        if (
          percent >= 90 &&
          !progressState.completedChapters.includes(activeChapterIndex)
        ) {
          progressState.completedChapters.push(activeChapterIndex);
        }

        saveProgressToStorage();
        updateUI();
      }, 1000);
    }

    // Export progress metrics dynamically to window object for other components
    window.getPlaybackProgress = function () {
      return progressState;
    };

    function stopProgressTracking() {
      if (progressInterval) {
        clearInterval(progressInterval);
        progressInterval = null;
      }
    }

    function markActiveChapterCompleted() {
      if (!progressState.completedChapters.includes(activeChapterIndex)) {
        progressState.completedChapters.push(activeChapterIndex);
        progressState.chapterPercentages[activeChapterIndex] = 100;
        saveProgressToStorage();
        updateUI();
      }
    }

    let endScreenInterval: any = null;

    function autoAdvanceToNextChapter() {
      const nextIndex = activeChapterIndex + 1;
      const endScreen = document.getElementById("smart-end-screen");
      const endNext = document.getElementById("end-screen-next");
      const endDone = document.getElementById("end-screen-done");
      const nextTitle = document.getElementById("next-lesson-title");
      const progressBar = document.getElementById("auto-advance-progress");

      if (!endScreen || !endNext || !endDone) return;

      endScreen.classList.remove("hidden");

      if (nextIndex < chaptersData.length) {
        // Has next lesson
        endNext.classList.remove("hidden");
        endNext.classList.add("flex");
        endDone.classList.add("hidden");
        endDone.classList.remove("flex");

        if (nextTitle)
          nextTitle.textContent =
            chaptersData[nextIndex]?.title || `Lesson ${nextIndex + 1}`;

        // Start 5 second countdown
        if (progressBar) {
          progressBar.style.transitionDuration = "0ms";
          progressBar.style.width = "0%";
          void progressBar.offsetWidth; // trigger reflow
          progressBar.style.transitionDuration = "5000ms";
          progressBar.style.width = "100%";
        }

        if (endScreenInterval) clearTimeout(endScreenInterval);
        endScreenInterval = setTimeout(() => {
          endScreen.classList.add("hidden");
          endNext.classList.add("hidden");
          endNext.classList.remove("flex");
          if (progressBar) progressBar.style.width = "0%";
          playChapter(nextIndex);
        }, 5000);
      } else {
        // Last lesson
        endDone.classList.remove("hidden");
        endDone.classList.add("flex");
        endNext.classList.add("hidden");
        endNext.classList.remove("flex");
      }
    }

    function playChapter(index: number, forceStartTime?: number) {
      activeChapterIndex = index;
      progressState.lastActiveIndex = index;
      saveProgressToStorage();

      const chapter = chaptersData[index];
      if (!chapter) return;
      const rawVideoId = chapter.videoId || courseVideoId;
      const videoId = getYoutubeId(rawVideoId);

      // Hide poster overlay
      const overlay = document.getElementById("video-poster-overlay");
      if (overlay) overlay.classList.add("hidden");

      // Hide smart end screen
      const endScreen = document.getElementById("smart-end-screen");
      if (endScreen) endScreen.classList.add("hidden");
      if (typeof endScreenInterval !== "undefined" && endScreenInterval)
        clearTimeout(endScreenInterval);

      // Update Sub-Bar title
      const activeTitleDisplay = document.getElementById(
        "active-chapter-title-display",
      );
      if (activeTitleDisplay) activeTitleDisplay.textContent = chapter.title;

      let savedTime =
        forceStartTime !== undefined
          ? forceStartTime
          : progressState.chapterPositions[index] || 0;
      const duration = progressState.chapterDurations[index] || 0;
      const percent = progressState.chapterPercentages[index] || 0;

      if (
        forceStartTime === undefined &&
        (percent === 100 || (duration > 0 && savedTime >= duration - 2))
      ) {
        savedTime = 0;
      }

      updateActiveChapterRowHighlight();
      updateModuleDetailsUI(index);

      if (!player) {
        initPlayer(videoId, savedTime);
      } else {
        player.loadVideoById({
          videoId: videoId,
          startSeconds: Math.floor(savedTime),
        });
      }

      updateUI();
    }

    const globalDesc =
      dataEl?.getAttribute("data-course-desc") ||
      "ℹ️ No description provided by creator for this lesson.";
    let globalAssets: any[] = [];
    try {
      globalAssets = JSON.parse(
        dataEl?.getAttribute("data-course-assets") || "[]",
      );
    } catch (e) {}

    function escapeHtml(unsafe: string) {
      return (unsafe || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function enrichText(text: string): string {
      const safeText = escapeHtml(text);
      const combinedRegex =
        /(https?:\/\/[^\s]+)|(\b(?:[0-9]+:)?(?:[0-5]?[0-9]):(?:[0-5][0-9])\b)/g;
      return safeText.replace(combinedRegex, (match, urlGroup, timeGroup) => {
        if (urlGroup) {
          return `<a href="${urlGroup}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline break-all inline-flex items-center gap-1">${urlGroup} <svg class="h-3 w-3 inline shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg></a>`;
        }
        if (timeGroup) {
          const parts = timeGroup.split(":");
          let totalSeconds = 0;
          if (parts.length === 3) {
            totalSeconds =
              parseInt(parts[0], 10) * 3600 +
              parseInt(parts[1], 10) * 60 +
              parseInt(parts[2], 10);
          } else if (parts.length === 2) {
            totalSeconds = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
          }
          return `<button type="button" class="timestamp-link font-mono text-primary hover:underline bg-primary/10 px-1 rounded-sm cursor-pointer border-none inline-flex items-center" data-time="${totalSeconds}">▶ ${match}</button>`;
        }
        return match;
      });
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const tsBtn = target.closest(".timestamp-link") as HTMLElement;
      if (tsBtn) {
        e.preventDefault();
        const time = parseInt(tsBtn.getAttribute("data-time") || "0", 10);

        const playerContainer = document.getElementById(
          "video-player-container",
        );
        if (playerContainer) {
          playerContainer.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
        }

        if (!player) {
          playChapter(activeChapterIndex, time);
        } else {
          player.seekTo(time, true);
          player.playVideo();
        }
      }
    });

    // Parse overview text on load
    const overviewTextEl = document.getElementById("course-overview-text");
    if (overviewTextEl) {
      const text = overviewTextEl.textContent || "";
      overviewTextEl.innerHTML = enrichText(text);
    }

    function updateModuleDetailsUI(index: number) {
      const chapter = chaptersData[index];
      if (!chapter) return;

      const descContainer = document.getElementById(
        "module-description-content",
      );
      if (descContainer) {
        descContainer.innerHTML = enrichText(
          chapter.creatorDescription || globalDesc,
        );
      }
    }

    function updateActiveChapterRowHighlight() {
      document.querySelectorAll(".chapter-row").forEach((row) => {
        const idx = parseInt(row.getAttribute("data-index") || "0", 10);
        const titleText = row.querySelector(".chapter-title-text");

        if (idx === activeChapterIndex) {
          row.classList.add("border-primary/30", "bg-canvas-soft/80");
          row.classList.remove("hover:bg-canvas-soft");
          if (titleText) {
            titleText.classList.add("text-primary");
            titleText.classList.remove("text-ink");
          }
        } else {
          row.classList.remove("border-primary/30", "bg-canvas-soft/80");
          row.classList.add("hover:bg-canvas-soft");
          if (titleText) {
            titleText.classList.remove("text-primary");
            titleText.classList.add("text-ink");
          }
        }
      });
    }

    function updateUI() {
      document.querySelectorAll(".chapter-row").forEach((row) => {
        const idx = parseInt(row.getAttribute("data-index") || "0", 10);
        const completed = progressState.completedChapters.includes(idx);
        const percent = progressState.chapterPercentages[idx] || 0;

        const statusIconEl = row.querySelector(".chapter-status-icon");
        const progressLabelEl = row.querySelector(".chapter-progress-lbl");
        const progressBarContainer = row.querySelector(
          ".chapter-progress-bar-container",
        );
        const progressBarFill = row.querySelector(
          ".chapter-progress-bar-fill",
        ) as HTMLElement;

        if (statusIconEl) {
          if (completed) {
            statusIconEl.innerHTML = `
              <span class="h-6 w-6 rounded-full bg-primary/10 border border-primary/30 flex items-center justify-center text-primary font-bold">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            `;
          } else if (idx === activeChapterIndex && progressInterval) {
            statusIconEl.innerHTML = `
              <span class="h-6 w-6 rounded-full bg-primary/10 border border-primary/30 flex items-center justify-center text-primary font-bold animate-pulse">
                <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            `;
          } else {
            statusIconEl.innerHTML = `
              <span class="font-mono text-xs text-mute bg-canvas border border-hairline h-6 w-6 rounded-full flex items-center justify-center font-bold">
                ${idx + 1}
              </span>
            `;
          }
        }

        if (percent > 0 && !completed) {
          if (progressLabelEl) {
            progressLabelEl.textContent = `${percent}% watched`;
            progressLabelEl.classList.remove("hidden");
          }
          if (progressBarContainer) {
            progressBarContainer.classList.remove("invisible");
          }
          if (progressBarFill) {
            progressBarFill.style.width = `${percent}%`;
          }
        } else if (completed) {
          if (progressLabelEl) {
            progressLabelEl.textContent = `Completed`;
            progressLabelEl.classList.remove("hidden");
            progressLabelEl.classList.add("text-primary");
            progressLabelEl.classList.remove("text-mute");
          }
          if (progressBarContainer) {
            progressBarContainer.classList.add("invisible");
          }
        } else {
          if (progressLabelEl) {
            progressLabelEl.classList.add("hidden");
          }
          if (progressBarContainer) {
            progressBarContainer.classList.add("invisible");
          }
        }
      });

      const totalChapters = chaptersData.length;
      const completedCount = progressState.completedChapters.length;
      let coursePercent = 0;
      let progressStatusText = "";

      if (totalChapters > 1) {
        coursePercent = Math.round((completedCount / totalChapters) * 100);
        progressStatusText = `${completedCount} of ${totalChapters} modules completed`;
      } else {
        coursePercent = Math.round(progressState.chapterPercentages[0] || 0);
        const watchedSecs = progressState.chapterPositions[0] || 0;
        const totalSecs = progressState.chapterDurations[0] || 0;

        if (totalSecs > 0) {
          const formatTime = (secs: number) => {
            const h = Math.floor(secs / 3600);
            const m = Math.floor((secs % 3600) / 60)
              .toString()
              .padStart(2, "0");
            const s = Math.floor(secs % 60)
              .toString()
              .padStart(2, "0");
            if (h > 0) return `${h}:${m}:${s}`;
            return `${m}:${s}`;
          };
          progressStatusText = `${formatTime(watchedSecs)} of ${formatTime(totalSecs)} watched`;
        } else {
          progressStatusText = `${coursePercent}% watched`;
        }
      }

      const progressPanel = document.getElementById("course-progress-panel");
      const progressPercentDisplay = document.getElementById(
        "course-progress-percent",
      );
      const progressBarDisplay = document.getElementById("course-progress-bar");
      const progressStatusDisplay = document.getElementById(
        "course-progress-status",
      );
      const mainCtaBtn = document.getElementById("main-cta-btn");

      const hasHistory =
        completedCount > 0 ||
        Object.keys(progressState.chapterPositions).length > 0;

      if (hasHistory) {
        if (progressPanel) progressPanel.classList.remove("hidden");
        if (progressPercentDisplay)
          progressPercentDisplay.textContent = `${coursePercent}%`;
        if (progressBarDisplay)
          progressBarDisplay.style.width = `${coursePercent}%`;
        if (progressStatusDisplay)
          progressStatusDisplay.textContent = progressStatusText;

        if (mainCtaBtn) {
          const activeChTitle = chaptersData[activeChapterIndex]?.title || "";
          mainCtaBtn.textContent = `Resume: ${activeChTitle.split(":")[0] || "Learning"}`;
        }
      } else {
        if (progressPanel) progressPanel.classList.add("hidden");
        if (mainCtaBtn) mainCtaBtn.textContent = "Start Course";
      }

      const markCompleteBtn = document.getElementById("mark-complete-btn");
      if (markCompleteBtn) {
        const activeCompleted =
          progressState.completedChapters.includes(activeChapterIndex);
        if (activeCompleted) {
          markCompleteBtn.classList.add(
            "border-primary/20",
            "bg-primary/10",
            "text-primary",
          );
          markCompleteBtn.classList.remove("text-mute", "border-hairline");
          const span = markCompleteBtn.querySelector("span");
          if (span) span.textContent = "Completed";
        } else {
          markCompleteBtn.classList.remove(
            "border-primary/20",
            "bg-primary/10",
            "text-primary",
          );
          markCompleteBtn.classList.add("text-mute", "border-hairline");
          const span = markCompleteBtn.querySelector("span");
          if (span) span.textContent = "Mark Completed";
        }
      }
    }

    function showResumeBannerOnPoster() {
      const resumeBanner = document.getElementById("resume-banner");
      const resumeChName = document.getElementById("resume-chapter-name");
      const resumeChTime = document.getElementById("resume-chapter-time");

      const lastIdx = progressState.lastActiveIndex;
      const lastTime = progressState.chapterPositions[lastIdx] || 0;

      if (lastTime > 2 && resumeBanner && resumeChName && resumeChTime) {
        resumeBanner.classList.remove("hidden");
        const activeChTitle = chaptersData[lastIdx]?.title || "Chapter";
        resumeChName.textContent = activeChTitle.split(":")[0] || activeChTitle;

        const minutes = Math.floor(lastTime / 60);
        const seconds = Math.floor(lastTime % 60);
        resumeChTime.textContent = `${minutes}:${seconds < 10 ? "0" : ""}${seconds}`;

        activeChapterIndex = lastIdx;

        const posterChapterTitle = document.getElementById(
          "poster-chapter-title",
        );
        if (posterChapterTitle) posterChapterTitle.textContent = activeChTitle;
      }
    }

    // Attach row listeners
    document.querySelectorAll(".chapter-row").forEach((row) => {
      row.addEventListener("click", () => {
        const idx = parseInt(row.getAttribute("data-index") || "0", 10);
        playChapter(idx);
      });
    });

    // Start video from poster overlay
    document
      .getElementById("start-video-btn")
      ?.addEventListener("click", () => {
        playChapter(activeChapterIndex);
      });

    // Mark active completed
    document
      .getElementById("mark-complete-btn")
      ?.addEventListener("click", () => {
        if (progressState.completedChapters.includes(activeChapterIndex)) {
          progressState.completedChapters =
            progressState.completedChapters.filter(
              (i) => i !== activeChapterIndex,
            );
          progressState.chapterPercentages[activeChapterIndex] = 0;
        } else {
          progressState.completedChapters.push(activeChapterIndex);
          progressState.chapterPercentages[activeChapterIndex] = 100;
        }
        saveProgressToStorage();
        updateUI();
      });

    // Main CTA button trigger
    document.getElementById("main-cta-btn")?.addEventListener("click", () => {
      const playerContainer = document.getElementById("video-player-container");
      if (playerContainer) {
        playerContainer.scrollIntoView({ behavior: "smooth", block: "center" });
        playChapter(activeChapterIndex);
      }
    });

    // Reset progress trigger
    document
      .getElementById("reset-course-btn")
      ?.addEventListener("click", () => {
        if (
          confirm(
            "Are you sure you want to reset all progress for this course?",
          )
        ) {
          localStorage.removeItem(PROGRESS_KEY);
          progressState.completedChapters = [];
          progressState.chapterPositions = {};
          progressState.chapterDurations = {};
          progressState.chapterPercentages = {};
          progressState.lastActiveIndex = 0;
          activeChapterIndex = 0;

          if (player) {
            try {
              player.stopVideo();
            } catch (e) {}
          }

          const overlay = document.getElementById("video-poster-overlay");
          if (overlay) overlay.classList.remove("hidden");

          const resumeBanner = document.getElementById("resume-banner");
          if (resumeBanner) resumeBanner.classList.add("hidden");

          const posterChapterTitle = document.getElementById(
            "poster-chapter-title",
          );
          if (posterChapterTitle)
            posterChapterTitle.textContent =
              chaptersData[0]?.title || "Start Course";

          updateUI();
          updateActiveChapterRowHighlight();
        }
      });

    // Watch Later Button Logic on Course Detail Page
    const wlBtn = document.getElementById("hero-watch-later-btn");

    function updateHeroWatchLater() {
      if (!wlBtn) return;
      const wl = getWatchLater();

      if (Array.isArray(wl) && wl.includes(courseSlug)) {
        wlBtn.classList.add("text-primary");
      } else {
        wlBtn.classList.remove("text-primary");
      }
    }

    wlBtn?.addEventListener("click", () => {
      let wl = getWatchLater();

      if (wl.includes(courseSlug)) {
        wl = wl.filter((s: string) => s !== courseSlug);
      } else {
        wl.push(courseSlug);
      }

      setWatchLater(wl);
      updateHeroWatchLater();
    });

    updateHeroWatchLater();
    window.addEventListener("watchLaterChanged", updateHeroWatchLater);

    // ═══════════════════════════════════════════════════════════════
    // Picture-in-Picture — Uses Document PiP API for true always-on-top window
    // Loads pip-player.astro inside an iframe within the Document PiP window
    // Falls back to popup window for unsupported browsers
    // ═══════════════════════════════════════════════════════════════
    const pipBtn = document.getElementById("pip-toggle-btn");
    const pipText = document.getElementById("pip-btn-text");
    let pipWindow: Window | null = null;
    let pipCheckInterval: any = null;
    let pipChannel: BroadcastChannel | null = null;
    let pipClosing = false; // Guard against double-execution from pagehide + BroadcastChannel race

    function resetPipButtonState() {
      if (pipBtn) pipBtn.classList.remove("text-primary");
      if (pipCheckInterval) {
        clearInterval(pipCheckInterval);
        pipCheckInterval = null;
      }
    }

    function handlePipClose(currentTime?: number) {
      if (pipClosing) return; // Already handling close
      pipClosing = true;

      // Close the PiP window if still open
      if (pipWindow && !pipWindow.closed) {
        try {
          pipWindow.close();
        } catch (e) {}
      }

      // Clean up channel first
      if (pipChannel) {
        try {
          pipChannel.close();
        } catch (e) {}
        pipChannel = null;
      }

      // Restore the main player UI
      restoreMainPlayer();
      resetPipButtonState();
      pipWindow = null;

      // Since the main player was acting as the audio source, it is already perfectly in sync!
      // We just need to ensure it is playing (which was the behavior of the Return to Page button).
      const doResume = () => {
        if (player && typeof player.playVideo === "function") {
          try {
            player.playVideo();
          } catch (e) {}
        }
      };

      // Call it immediately and retry slightly later just in case the iframe needs a moment to render
      doResume();
      setTimeout(doResume, 300);

      // Also clean up local storage if we used it
      localStorage.removeItem("freeyt_pip_time");
    }

    // Blank out main player (hide video, show placeholder)
    function blankMainPlayer() {
      const container = document.getElementById("youtube-player");
      if (container) {
        container.style.opacity = "0";
        container.style.pointerEvents = "none";
      }
      const customControls = document.getElementById("custom-player-controls");
      if (customControls) customControls.style.display = "none";

      let placeholder = document.getElementById("video-pip-placeholder");
      if (!placeholder) {
        placeholder = document.createElement("div");
        placeholder.id = "video-pip-placeholder";
        placeholder.className =
          "absolute inset-0 bg-slate-900 flex flex-col items-center justify-center z-40 text-center px-4 transition-opacity";
        placeholder.innerHTML =
          '<h3 class="text-xl font-bold text-white mb-2 font-mono">Playing in Picture-in-Picture</h3><p class="text-white/70 font-mono text-sm max-w-sm">The video is currently playing in a floating window. Audio is synced from this tab.</p>';
        const wrapper = document.querySelector(".aspect-video");
        if (wrapper) wrapper.appendChild(placeholder);
      }
      if (placeholder) placeholder.classList.remove("hidden");
    }

    // Restore main player (show video, hide placeholder)
    function restoreMainPlayer() {
      const container = document.getElementById("youtube-player");
      if (container) {
        container.style.opacity = "1";
        container.style.pointerEvents = "auto";
      }
      const customControls = document.getElementById("custom-player-controls");
      if (customControls) customControls.style.display = "";

      const placeholder = document.getElementById("video-pip-placeholder");
      if (placeholder) placeholder.classList.add("hidden");
    }

    // Get the current playing video ID from the YouTube player
    function getCurrentVideoId(): string {
      if (player && typeof player.getVideoUrl === "function") {
        try {
          const url = player.getVideoUrl();
          const match = url.match(/[?&]v=([^&]+)/);
          if (match) return match[1];
        } catch (e) {}
      }
      const activeChapter = chaptersData[activeChapterIndex];
      return activeChapter?.videoId || courseVideoId;
    }

    // ── Main PiP open function ──
    async function openPictureInPicture() {
      if (pipWindow && !pipWindow.closed) {
        pipWindow.focus();
        return;
      }

      const videoId = getCurrentVideoId();
      if (!videoId) {
        alert("Please start playing a video first.");
        return;
      }

      let currentTime = 0;
      if (player && typeof player.getCurrentTime === "function") {
        currentTime = Math.floor(player.getCurrentTime());
      }

      const activeTitle = document.getElementById(
        "active-chapter-title-display",
      );
      const title = activeTitle?.textContent || "Course Video";
      const pipUrl = `/pip-player?v=${encodeURIComponent(videoId)}&t=${currentTime}&title=${encodeURIComponent(title)}`;

      // Reset close guard for new PiP session
      pipClosing = false;

      // Set up BroadcastChannel to listen for closing message from pip-player
      pipChannel = new BroadcastChannel("freeyt-pip-channel");
      pipChannel.addEventListener("message", (e: MessageEvent) => {
        if (e.data?.type === "pip-ready") {
          // NO LONGER pause main player! Just visually hide it so it acts as an audio source!
          blankMainPlayer();
          const pipBtnEl = document.getElementById("pip-toggle-btn");
          if (pipBtnEl) pipBtnEl.classList.add("text-primary");

          if (pipWindow) {
            try {
              pipWindow.postMessage(
                { type: "forward-command", func: "playVideo" },
                "*",
              );
            } catch (err) {}
          }
        }
        if (e.data?.type === "sync-command") {
          // Sync playback controls from PiP to the main player (audio source)
          if (player) {
            try {
              const func = e.data.func;
              const args = e.data.args || [];
              if (typeof player[func] === "function") {
                player[func](...args);
              }
            } catch (e) {}
          }
        }
        if (
          e.data?.type === "pip-closing" &&
          typeof e.data.currentTime === "number"
        ) {
          handlePipClose(e.data.currentTime);
        }
      });

      // ── Try Document Picture-in-Picture API (true always-on-top) ──
      if ("documentPictureInPicture" in window) {
        try {
          const docPip = (window as any).documentPictureInPicture;
          const pipWin: Window = await docPip.requestWindow({
            width: 640,
            height: 360,
          });

          // Style the Document PiP window body
          const style = pipWin.document.createElement("style");
          style.textContent =
            "* { margin: 0; padding: 0; } html, body { width: 100%; height: 100%; overflow: hidden; background: #000; }";
          pipWin.document.head.appendChild(style);

          // Load pip-player inside an iframe (YouTube works fine from pip-player's same-origin context)
          const frame = pipWin.document.createElement("iframe");
          frame.src = pipUrl;
          frame.style.cssText =
            "width: 100%; height: 100%; border: none; display: block;";
          frame.allow = "autoplay; encrypted-media; picture-in-picture";
          pipWin.document.body.appendChild(frame);

          pipWindow = pipWin;

          // Note: Main player is no longer paused here. We wait for pip-ready message.

          // Detect Document PiP window close (fallback if BroadcastChannel message wasn't received)
          pipWin.addEventListener("pagehide", () => {
            // Small delay to let BroadcastChannel message arrive first (it has the time)
            setTimeout(() => handlePipClose(), 200);
          });

          return; // Success — don't fall through to popup
        } catch (e) {
          console.warn("Document PiP failed, falling back to popup window:", e);
        }
      }

      // ── Fallback: popup window (not always-on-top) ──
      const popupWidth = 640;
      const popupHeight = 360;
      const left = screen.width - popupWidth - 20;
      const top = screen.height - popupHeight - 100;

      pipWindow = window.open(
        pipUrl,
        "freeyt_pip_player",
        `popup=yes,width=${popupWidth},height=${popupHeight},left=${left},top=${top}`,
      );

      if (!pipWindow) {
        if (pipChannel) {
          try {
            pipChannel.close();
          } catch (e) {}
          pipChannel = null;
        }
        const msg = document.createElement("div");
        msg.className =
          "fixed bottom-6 right-6 z-[9999] bg-canvas border-2 border-primary rounded-lg p-4 shadow-2xl max-w-sm font-mono text-sm";
        msg.innerHTML = `<div class="flex items-start gap-3"><svg class="h-5 w-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><div><p class="text-ink font-semibold mb-1">Popup Blocked</p><p class="text-mute text-xs leading-relaxed">Please allow popups for this site.</p></div><button onclick="this.closest('div.fixed').remove()" class="text-mute hover:text-ink cursor-pointer shrink-0"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button></div>`;
        document.body.appendChild(msg);
        setTimeout(() => msg.remove(), 6000);
        return;
      }

      // Note: Main player is no longer paused here. We wait for pip-ready message.

      // Also listen via postMessage for backward compat with popup
      const onPipMessage = (msg: MessageEvent) => {
        if (
          msg.data?.type === "pip-closing" &&
          typeof msg.data.currentTime === "number"
        ) {
          handlePipClose(msg.data.currentTime);
          window.removeEventListener("message", onPipMessage);
        }
      };
      window.addEventListener("message", onPipMessage);

      // Poll to detect popup window closed (fallback)
      pipCheckInterval = setInterval(() => {
        if (!pipWindow || pipWindow.closed) {
          handlePipClose();
          window.removeEventListener("message", onPipMessage);
        }
      }, 500);
    }

    pipBtn?.addEventListener("click", openPictureInPicture);

    // Main video player hover controls
    const mainPlayerContainer = document.getElementById(
      "video-player-container",
    );
    const mainControlsBar = document.getElementById("video-controls-bar");
    const customControls = document.getElementById("custom-player-controls");
    let mainHideTimeout: any = null;

    if (mainPlayerContainer) {
      mainPlayerContainer.addEventListener("mousemove", () => {
        if (mainControlsBar) {
          mainControlsBar.classList.remove("opacity-0", "pointer-events-none");
          mainControlsBar.classList.add("opacity-100", "pointer-events-auto");
        }
        if (customControls) {
          customControls.classList.remove("opacity-0", "pointer-events-none");
          customControls.classList.add("opacity-100", "pointer-events-auto");
        }

        if (mainHideTimeout) clearTimeout(mainHideTimeout);
        mainHideTimeout = setTimeout(() => {
          if (mainControlsBar) {
            mainControlsBar.classList.add("opacity-0", "pointer-events-none");
            mainControlsBar.classList.remove(
              "opacity-100",
              "pointer-events-auto",
            );
          }
          if (customControls) {
            customControls.classList.add("opacity-0", "pointer-events-none");
            customControls.classList.remove(
              "opacity-100",
              "pointer-events-auto",
            );
          }
        }, 2500);
      });

      mainPlayerContainer.addEventListener("mouseleave", () => {
        if (mainHideTimeout) clearTimeout(mainHideTimeout);
        if (mainControlsBar) {
          mainControlsBar.classList.add("opacity-0", "pointer-events-none");
          mainControlsBar.classList.remove(
            "opacity-100",
            "pointer-events-auto",
          );
        }
        if (customControls) {
          customControls.classList.add("opacity-0", "pointer-events-none");
          customControls.classList.remove("opacity-100", "pointer-events-auto");
        }
      });
    }

    // Clean up on page unload
    window.addEventListener("beforeunload", () => {
      if (pipWindow && !pipWindow.closed) {
        pipWindow.close();
      }
    });

    // Custom Player Controls Logic
    const formatTime = (secs: number) => {
      const h = Math.floor(secs / 3600);
      const m = Math.floor((secs % 3600) / 60);
      const s = Math.floor(secs % 60);
      if (h > 0) {
        return `${h}:${m < 10 ? "0" : ""}${m}:${s < 10 ? "0" : ""}${s}`;
      }
      return `${m}:${s < 10 ? "0" : ""}${s}`;
    };

    function updateCustomControls() {
      if (!player || typeof player.getCurrentTime !== "function") {
        requestAnimationFrame(updateCustomControls);
        return;
      }
      const currentTime = player.getCurrentTime();
      const duration = player.getDuration();

      const scrub = document.getElementById("player-scrub") as HTMLInputElement;
      const timeDisplay = document.getElementById("player-time-display");

      if (duration > 0 && scrub && !scrub.matches(":active")) {
        scrub.value = ((currentTime / duration) * 100).toString();
      }
      if (timeDisplay && duration > 0) {
        timeDisplay.textContent = `${formatTime(currentTime)} / ${formatTime(duration)}`;
      }

      requestAnimationFrame(updateCustomControls);
    }
    requestAnimationFrame(updateCustomControls);

    // Bind Custom Controls
    const playBtn = document.getElementById("player-play-btn");

    function togglePlayPause() {
      if (!player) {
        playChapter(activeChapterIndex);
        return;
      }
      const state = player.getPlayerState();
      if (state === 1) {
        // 1 = YT.PlayerState.PLAYING
        player.pauseVideo();
      } else {
        player.playVideo();
      }
    }

    playBtn?.addEventListener("click", togglePlayPause);

    const skipBackZone = document.getElementById("zone-skip-back");
    const skipFwdZone = document.getElementById("zone-skip-fwd");
    const playPauseZone = document.getElementById("zone-play-pause");

    skipBackZone?.addEventListener("click", togglePlayPause);
    skipFwdZone?.addEventListener("click", togglePlayPause);
    playPauseZone?.addEventListener("click", togglePlayPause);

    skipBackZone?.addEventListener("dblclick", () => {
      if (player && typeof player.getCurrentTime === "function") {
        player.seekTo(player.getCurrentTime() - 10, true);
      }
    });

    skipFwdZone?.addEventListener("dblclick", () => {
      if (player && typeof player.getCurrentTime === "function") {
        player.seekTo(player.getCurrentTime() + 10, true);
      }
    });

    document
      .getElementById("player-skip-back")
      ?.addEventListener("click", () => {
        if (player && typeof player.getCurrentTime === "function") {
          player.seekTo(player.getCurrentTime() - 10, true);
        }
      });

    document
      .getElementById("player-skip-fwd")
      ?.addEventListener("click", () => {
        if (player && typeof player.getCurrentTime === "function") {
          player.seekTo(player.getCurrentTime() + 10, true);
        }
      });

    const scrubSlider = document.getElementById(
      "player-scrub",
    ) as HTMLInputElement;
    scrubSlider?.addEventListener("input", (e) => {
      if (player && typeof player.getDuration === "function") {
        const val = parseFloat((e.target as HTMLInputElement).value);
        player.seekTo((val / 100) * player.getDuration(), true);
      }
    });

    const muteBtn = document.getElementById("player-mute-btn");
    const iconVolUp = document.getElementById("icon-vol-up");
    const iconVolMute = document.getElementById("icon-vol-mute");
    muteBtn?.addEventListener("click", () => {
      if (!player) return;
      if (player.isMuted()) {
        player.unMute();
        iconVolUp?.classList.remove("hidden");
        iconVolMute?.classList.add("hidden");
      } else {
        player.mute();
        iconVolUp?.classList.add("hidden");
        iconVolMute?.classList.remove("hidden");
      }
    });

    const volSlider = document.getElementById(
      "player-volume",
    ) as HTMLInputElement;
    volSlider?.addEventListener("input", (e) => {
      if (player) {
        const val = parseInt((e.target as HTMLInputElement).value, 10);
        player.setVolume(val);
        if (val === 0) {
          iconVolUp?.classList.add("hidden");
          iconVolMute?.classList.remove("hidden");
        } else if (player.isMuted()) {
          player.unMute();
          iconVolUp?.classList.remove("hidden");
          iconVolMute?.classList.add("hidden");
        }
      }
    });

    const rateBtn = document.getElementById("player-rate-btn");
    const rates = [1, 1.25, 1.5, 2];
    let currentRateIdx = 0;
    rateBtn?.addEventListener("click", () => {
      if (!player) return;
      currentRateIdx = (currentRateIdx + 1) % rates.length;
      const newRate = rates[currentRateIdx];
      player.setPlaybackRate(newRate);
      if (rateBtn) rateBtn.textContent = `${newRate}x`;
    });

    const fsBtn = document.getElementById("player-fullscreen-btn");
    fsBtn?.addEventListener("click", () => {
      const container = document.getElementById("video-player-wrapper");
      if (!container) return;
      if (!document.fullscreenElement) {
        container.requestFullscreen().catch((err) => {
          console.error(
            `Error attempting to enable fullscreen: ${err.message}`,
          );
        });
      } else {
        document.exitFullscreen();
      }
    });

    // Smart End Screen Buttons
    document.getElementById("play-next-btn")?.addEventListener("click", () => {
      if (endScreenInterval) clearTimeout(endScreenInterval);
      document.getElementById("smart-end-screen")?.classList.add("hidden");
      playChapter(activeChapterIndex + 1);
    });

    document
      .getElementById("cancel-next-btn")
      ?.addEventListener("click", () => {
        if (endScreenInterval) clearTimeout(endScreenInterval);
        document.getElementById("smart-end-screen")?.classList.add("hidden");
        const progressBar = document.getElementById("auto-advance-progress");
        if (progressBar) progressBar.style.width = "0%";
      });

    document
      .getElementById("replay-course-btn")
      ?.addEventListener("click", () => {
        document.getElementById("smart-end-screen")?.classList.add("hidden");
        if (player) {
          player.seekTo(0, true);
          player.playVideo();
        }
      });

    // Keyboard Shortcuts
    window.addEventListener("keydown", (e) => {
      // Ignore if typing in an input/textarea
      if (
        ["INPUT", "TEXTAREA", "SELECT"].includes(
          (e.target as HTMLElement).tagName,
        )
      )
        return;

      if (!player) return;

      switch (e.code) {
        case "Space":
          e.preventDefault();
          togglePlayPause();
          break;
        case "ArrowLeft":
          e.preventDefault();
          if (typeof player.getCurrentTime === "function") {
            player.seekTo(player.getCurrentTime() - 10, true);
          }
          break;
        case "ArrowRight":
          e.preventDefault();
          if (typeof player.getCurrentTime === "function") {
            player.seekTo(player.getCurrentTime() + 10, true);
          }
          break;
      }
    });

    // Tab switching logic for Creator Description, Practice Assets, and Syllabus
    const tabs = [
      {
        btn: document.getElementById("tab-desc-btn"),
        content: document.getElementById("module-description-content"),
      },

      {
        btn: document.getElementById("tab-syllabus-btn"),
        content: document.getElementById("module-syllabus-content"),
      },
    ];

    tabs.forEach((tab) => {
      if (tab.btn && tab.content) {
        tab.btn.addEventListener("click", () => {
          const isActive = tab.content?.classList.contains("block");

          // Reset all tabs
          tabs.forEach((t) => {
            if (t.btn && t.content) {
              t.btn.classList.remove(
                "text-primary",
                "font-bold",
                "border-primary",
                "bg-canvas-soft",
              );
              t.btn.classList.add(
                "text-mute",
                "hover:text-ink",
                "font-semibold",
                "border-transparent",
                "hover:bg-canvas-soft",
              );
              t.content.classList.remove("block");
              t.content.classList.add("hidden");
            }
          });

          // If the clicked tab wasn't active, activate it
          if (!isActive && tab.btn && tab.content) {
            tab.btn.classList.add(
              "text-primary",
              "font-bold",
              "border-primary",
              "bg-canvas-soft",
            );
            tab.btn.classList.remove(
              "text-mute",
              "hover:text-ink",
              "font-semibold",
              "border-transparent",
              "hover:bg-canvas-soft",
            );
            tab.content.classList.remove("hidden");
            tab.content.classList.add("block");
          }
        });
      }
    });

    // Load initial views
    updateUI();
    updateActiveChapterRowHighlight();
    showResumeBannerOnPoster();

    // Autostart video when user navigates to the page
    setTimeout(() => {
      playChapter(activeChapterIndex);
    }, 100);
  </script>
</Layout>
