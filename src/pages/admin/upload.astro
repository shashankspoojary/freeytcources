---
import Layout from '../../layouts/Layout.astro';

const title = "Secure Course Upload Console";
const description = "Manually ingest new courses and syllabus layouts into the curriculum directory.";
---

<Layout title={title} description={description} activePage="admin" hideSidebar={true}>

  <main class="max-w-4xl mx-auto px-6 py-12 md:py-20 min-h-[calc(100vh-140px)]">



    <!-- Admin Upload Console (Hidden Until Authenticated) -->
    <div id="admin-console" class="hidden w-full max-w-3xl space-y-8 opacity-0 transform translate-y-4 transition-all duration-500">
      
      <!-- Console Header -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-hairline pb-6">
        <div>
          <div class="inline-block font-mono text-[10px] text-primary uppercase tracking-[2.52px] mb-2 bg-primary/10 px-2.5 py-1 rounded-pill border border-primary/20">
            Authenticated Admin Session
          </div>
          <h1 class="text-3xl font-light text-ink-strong tracking-[-0.65px]">Course Ingestion Console</h1>
          <p class="text-sm text-body font-light mt-1">
            Build, review, and export AdSense-compliant course syllabus structures.
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a 
            href="/admin/submissions" 
            class="text-xs font-mono uppercase bg-canvas-soft border border-hairline hover:border-amber-500/50 text-ink hover:text-amber-500 px-3.5 py-2 rounded-sm transition-all flex items-center gap-2 cursor-pointer font-medium"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
            Submissions
          </a>

          <a 
            href="/admin/courses" 
            class="text-xs font-mono uppercase bg-canvas-soft border border-hairline hover:border-primary text-ink hover:text-primary px-3.5 py-2 rounded-sm transition-all flex items-center gap-2 cursor-pointer font-medium"
          >
            <svg class="h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Directory &rarr;
          </a>

          <button 
            id="lock-console-btn" 
            class="text-xs font-mono uppercase border border-hairline hover:border-red-500/50 hover:text-red-400 text-body px-3 py-2 rounded-sm transition-all flex items-center gap-2 cursor-pointer"
          >
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Sign Out Admin
          </button>
        </div>
      </div>

      <!-- Main Form -->
      <form id="upload-form" class="space-y-8">
        
        <!-- Section 1: Course Metadata -->
        <div class="bg-canvas-soft border border-hairline rounded-md p-6 space-y-6">
          <div class="flex items-center gap-2 mb-2 border-b border-hairline/40 pb-3">
            <span class="text-xs font-mono text-primary font-bold">01/</span>
            <h2 class="text-sm font-mono uppercase tracking-wider text-ink-strong font-semibold">Course Meta-Data</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="course-title" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Course Title</label>
              <input 
                type="text" 
                id="course-title" 
                placeholder="e.g. Advanced AI Agents Masterclass"
                class="w-full bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40"
                required
              />
            </div>

            <div>
              <label for="youtube-link" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2 flex justify-between items-center">
                <span>YouTube Playlist Link / ID</span>
                <span id="auto-fill-status" class="text-[10px] text-primary hidden truncate ml-2"></span>
              </label>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="youtube-link" 
                  placeholder="e.g. https://www.youtube.com/playlist?list=..."
                  class="flex-1 w-full bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40"
                  required
                />
                <button 
                  type="button" 
                  id="auto-fill-ai-btn" 
                  class="px-4 py-3 bg-primary text-on-primary font-mono text-xs uppercase font-bold rounded-sm hover:bg-primary-soft transition-colors cursor-pointer shrink-0 flex items-center gap-1 shadow-sm"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  Auto-Fill
                </button>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="category" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Category</label>
              <div class="relative">
                <select 
                  id="category" 
                  class="w-full appearance-none bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all cursor-pointer pr-10"
                  required
                >
                  <option value="" disabled selected>Select Category</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>

              <!-- Interactive Category Manager -->
              <div class="mt-3 bg-canvas-soft/80 border border-hairline rounded-sm p-3 space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-mute font-semibold">Category Manager</span>
                  <span id="cat-count-badge" class="text-[10px] font-mono text-primary font-bold">0 Categories</span>
                </div>

                <!-- Add Category Row -->
                <div class="flex items-center gap-2">
                  <input 
                    type="text" 
                    id="new-category-input" 
                    placeholder="Type new category name..." 
                    class="flex-1 bg-canvas border border-hairline text-ink rounded-sm px-3 py-1.5 text-xs focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/20 transition-all font-mono placeholder:text-mute/40"
                  />
                  <button 
                    type="button" 
                    id="add-category-btn" 
                    class="bg-primary text-on-primary font-mono text-xs uppercase font-bold px-3 py-1.5 rounded-sm hover:bg-primary-soft transition-colors cursor-pointer shrink-0 flex items-center gap-1"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Add
                  </button>
                </div>
                <p id="category-error-msg" class="text-[10px] font-mono text-red-400 hidden"></p>

                <!-- Removable Category Chips -->
                <div id="category-chips-container" class="flex flex-wrap gap-1.5 pt-1">
                  <!-- Dynamically populated chips -->
                </div>
              </div>
            </div>

            <div>
              <label for="author" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Author Name</label>
              <input 
                type="text" 
                id="author" 
                placeholder="e.g. Dr. Angela Thorne"
                class="w-full bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40"
                required
              />
              <div class="flex items-center gap-2.5 mt-2">
                <img id="author-avatar-preview" class="h-6 w-6 rounded-full object-cover border border-hairline hidden" />
                <span id="author-avatar-status" class="text-[10px] font-mono text-mute"></span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-hairline/40">
            <div>
              <label for="course-language" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Language</label>
              <div class="flex gap-2">
                <div class="relative flex-grow">
                  <select 
                    id="course-language" 
                    class="w-full appearance-none bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all cursor-pointer pr-10"
                    required
                  >
                    <option value="" disabled selected>Select Language</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-mute">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </div>
                </div>
                <button
                  type="button"
                  id="add-custom-lang-btn"
                  class="px-4 py-3 bg-canvas border border-hairline hover:border-primary text-xs font-mono uppercase text-body hover:text-primary rounded-sm transition-all shrink-0 cursor-pointer"
                >
                  New Language
                </button>
              </div>
            </div>

            <div>
              <label for="module-type-select" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Module Structure</label>
              <div class="relative">
                <select 
                  id="module-type-select" 
                  class="w-full appearance-none bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all cursor-pointer pr-10"
                >
                  <option value="auto" selected>Auto-Detect from Syllabus (Recommended)</option>
                  <option value="single">Crashcourse (1 Video)</option>
                  <option value="multi">Playlist/Chapters (Multiple Videos)</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="md:col-span-2 pt-2">
              <label class="flex items-center gap-3 cursor-pointer select-none">
                <input 
                  type="checkbox" 
                  id="creator-showcase-checkbox" 
                  class="h-4 w-4 rounded border-hairline text-primary focus:ring-primary bg-canvas cursor-pointer" 
                />
                <div class="flex flex-col">
                  <span class="text-xs font-mono uppercase tracking-wider text-ink font-semibold">Creator Showcase</span>
                  <span class="text-[11px] font-sans text-mute">Highlight this course in the homepage Creator Showcase section.</span>
                </div>
              </label>
            </div>

            <div id="custom-lang-container" class="hidden">
              <label for="custom-language" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Add Custom Language</label>
              <div class="flex gap-2">
                <input 
                  type="text" 
                  id="custom-language" 
                  placeholder="e.g. Spanish"
                  class="w-full bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40"
                />
                <button
                  type="button"
                  id="save-custom-lang-btn"
                  class="px-4 py-3 bg-primary text-on-primary text-xs font-mono uppercase font-bold rounded-sm hover:bg-primary-soft transition-all shrink-0 cursor-pointer"
                >
                  Add Option
                </button>
              </div>
            </div>
          </div>

          <!-- Course Tags / Tools Input Section -->
          <div class="pt-4 border-t border-hairline/40">
            <label for="tag-input" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">Course Tags / Tools (Optional)</label>
            <div class="flex gap-2 mb-3">
              <input 
                type="text" 
                id="tag-input" 
                placeholder="e.g. Python, LangChain, Next.js (Press Enter or click Add)"
                class="flex-grow bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40"
              />
              <button
                type="button"
                id="add-tag-btn"
                class="px-4 py-3 bg-canvas border border-hairline hover:border-primary text-xs font-mono uppercase text-body hover:text-primary rounded-sm transition-all shrink-0 cursor-pointer"
              >
                Add Tag
              </button>
            </div>
            
            <!-- Removable Tags Chip Badges Container -->
            <div id="tags-chips-container" class="flex flex-wrap gap-2 min-h-[36px] p-2.5 bg-canvas/40 border border-hairline/60 rounded-sm">
              <span class="text-xs font-mono text-mute/50 self-center" id="no-tags-msg">No tags added yet. Type a tag above and click Add.</span>
            </div>
          </div>
        </div>

        <!-- Section 2: Extended Summary (AdSense word-count check) -->
        <div class="bg-canvas-soft border border-hairline rounded-md p-6 space-y-6">
          <div class="flex justify-between items-center border-b border-hairline/40 pb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-primary font-bold">02/</span>
              <h2 class="text-sm font-mono uppercase tracking-wider text-ink-strong font-semibold">Extended Overview & Critique</h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono uppercase tracking-wider text-mute">AdSense Criteria:</span>
              <span id="adsense-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-mono border border-red-500/20 bg-red-500/10 text-red-400 flex items-center gap-1">
                <span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-pulse"></span>
                Incomplete (<span id="words-needed">200</span> left)
              </span>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center mb-2">
              <label for="overview" class="block text-xs font-mono uppercase tracking-wider text-mute">Extended Summary (Markdown Supported)</label>
              <span class="text-xs font-mono text-mute">
                Words: <span id="word-count" class="text-ink font-semibold">0</span> / 200 | Chars: <span id="char-count" class="text-ink">0</span>
              </span>
            </div>
            
            <textarea 
              id="overview" 
              rows="8"
              placeholder="Provide a comprehensive review of the course. Must be at least 200 words long to satisfy SEO/AdSense optimization layers. Detail the teaching style, strengths, flaws, and required tools."
              class="w-full bg-canvas border border-hairline text-ink rounded-sm px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/40 font-light leading-relaxed mb-1"
              required
            ></textarea>
            
            <div id="adsense-warning" class="mt-3 p-3 bg-red-500/5 border border-red-500/20 rounded-sm flex items-start gap-2.5 transition-all duration-300">
              <svg class="h-4 w-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <p class="text-xs text-body font-light">
                <strong class="text-ink-strong">AdSense Requirement Warning:</strong> Your overview review text is currently under 200 words. Search crawlers expect editorial substance for high-quality monetization directories.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 3: Dynamic Syllabus Modules -->
        <div class="bg-canvas-soft border border-hairline rounded-md p-6 space-y-6">
          <div class="flex justify-between items-center border-b border-hairline/40 pb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono text-primary font-bold">03/</span>
              <h2 class="text-sm font-mono uppercase tracking-wider text-ink-strong font-semibold">Syllabus & Chapter Modules</h2>
            </div>
            <span class="text-xs font-mono text-mute">
              Active Modules: <span id="module-count" class="text-primary font-bold">0</span>
            </span>
          </div>

          <!-- Modules Container -->
          <div id="modules-list" class="space-y-4">
            <!-- Dynamic rows will be inserted here by JavaScript -->
          </div>

          <!-- Add Module Control -->
          <button 
            type="button" 
            id="add-module-btn"
            class="w-full flex items-center justify-center gap-2 py-3 border border-dashed border-hairline hover:border-primary/50 text-xs font-mono uppercase text-body hover:text-primary rounded-sm transition-all cursor-pointer bg-canvas/30"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Add Course Module
          </button>
        </div>

        <!-- Form Submission Controls -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-4 border-t border-hairline">
          <button 
            type="button" 
            id="reset-form-btn"
            class="w-full sm:w-auto px-6 py-3.5 border border-hairline hover:border-red-500/30 text-xs font-mono uppercase text-body hover:text-red-400 rounded-sm transition-all cursor-pointer bg-transparent"
          >
            Reset Form
          </button>
          
          <button 
            type="submit" 
            id="admin-submit-btn"
            disabled
            class="w-full sm:w-auto bg-primary text-on-primary font-mono uppercase text-sm font-bold tracking-wider py-3.5 px-8 rounded-sm hover:bg-primary-soft transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-canvas cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
            </svg>
            Submit Course payload
          </button>
        </div>
      </form>

        <!-- Section 4: Submitted Courses Navigation Card -->
        <div class="bg-canvas-soft border border-hairline rounded-md p-6 flex flex-col sm:flex-row items-center justify-between gap-4 mt-8">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-mono text-primary font-bold">04/</span>
              <h2 class="text-sm font-mono uppercase tracking-wider text-ink-strong font-semibold">Submitted Courses Directory</h2>
            </div>
            <p class="text-xs text-body font-light">
              All active cataloged courses are managed on a dedicated directory page to handle large volumes of submissions.
            </p>
          </div>
          <a 
            href="/admin/courses" 
            class="px-5 py-3 bg-primary text-on-primary font-mono text-xs uppercase font-bold tracking-wider rounded-sm hover:bg-primary-soft transition-all flex items-center gap-2 shrink-0 shadow-md cursor-pointer"
          >
            <span>Manage Submitted Courses &rarr;</span>
          </a>
        </div>
      </div>

    </main>

  <!-- Notification Toast Alert Component -->
  <div 
    id="success-toast" 
    class="fixed bottom-6 right-6 z-50 bg-canvas border border-hairline rounded-md p-4 shadow-2xl max-w-sm flex gap-3 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 border-l-4 border-l-primary"
  >
    <div class="h-8 w-8 rounded-full bg-primary/10 border border-primary/20 text-primary flex items-center justify-center shrink-0">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <div>
      <h3 class="text-sm font-mono uppercase tracking-wider text-ink-strong font-semibold">Submission Success</h3>
      <p class="text-xs text-body font-light mt-0.5 leading-relaxed">
        Operation completed successfully.
      </p>
    </div>
    <button 
      id="close-toast-btn"
      class="text-mute hover:text-ink transition-colors ml-2 self-start cursor-pointer focus:outline-none bg-transparent border-none"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</Layout>

<script>
  import { db, auth } from '../../lib/firebase.js';
  import { doc, setDoc, collection, query, where, getDocs, getDoc } from 'firebase/firestore';
  import { onAuthStateChanged, signOut } from 'firebase/auth';

  const PUBLIC_ADMIN_UID = import.meta.env.PUBLIC_ADMIN_UID || 'L3hLhdVxWBRkPk4GQg5KIZGFrx63';
  const adminSubmitBtn = document.getElementById('admin-submit-btn') as HTMLButtonElement;

  // DOM Elements

  const adminConsole = document.getElementById('admin-console');
  const lockConsoleBtn = document.getElementById('lock-console-btn');
  const uploadForm = document.getElementById('upload-form') as HTMLFormElement;
  const resetFormBtn = document.getElementById('reset-form-btn');
  
  // Overview counter inputs
  const overviewInput = document.getElementById('overview') as HTMLTextAreaElement;
  const wordCountDisplay = document.getElementById('word-count');
  const charCountDisplay = document.getElementById('char-count');
  const adsenseBadge = document.getElementById('adsense-badge');
  const adsenseWarning = document.getElementById('adsense-warning');
  
  // Dynamic Modules
  const modulesList = document.getElementById('modules-list');
  const addModuleBtn = document.getElementById('add-module-btn');
  const moduleCountDisplay = document.getElementById('module-count');
  
  // Toast
  const successToast = document.getElementById('success-toast');
  const closeToastBtn = document.getElementById('close-toast-btn');

  // Language Elements
  const languageSelect = document.getElementById('course-language') as HTMLSelectElement;
  const customLangContainer = document.getElementById('custom-lang-container');
  const addCustomLangBtn = document.getElementById('add-custom-lang-btn');
  const customLangInput = document.getElementById('custom-language') as HTMLInputElement;
  const saveCustomLangBtn = document.getElementById('save-custom-lang-btn');
  const LANGS_KEY = 'freeyt_available_languages';

  // Manual Tags Elements
  const tagInput = document.getElementById('tag-input') as HTMLInputElement;
  const addTagBtn = document.getElementById('add-tag-btn');
  const tagsChipsContainer = document.getElementById('tags-chips-container');
  let currentTags: string[] = [];

  // Edit Mode State
  let isEditingMode = false;
  let editOriginalSlug = '';
  let extractedIsEmbeddable = true;

  function renderTagChips() {
    if (!tagsChipsContainer) return;
    tagsChipsContainer.innerHTML = '';
    
    if (currentTags.length === 0) {
      tagsChipsContainer.innerHTML = `<span class="text-xs font-mono text-mute/50 self-center" id="no-tags-msg">No tags added yet. Type a tag above and click Add.</span>`;
      return;
    }

    currentTags.forEach((tag, idx) => {
      const chip = document.createElement('div');
      chip.className = 'inline-flex items-center gap-1.5 px-3 py-1 bg-canvas border border-primary/40 text-primary rounded-sm text-xs font-mono shadow-sm';
      chip.innerHTML = `
        <span>${tag}</span>
        <button type="button" class="remove-tag-btn hover:text-red-400 focus:outline-none cursor-pointer text-sm font-bold ml-1" data-idx="${idx}" title="Remove tag">&times;</button>
      `;
      
      chip.querySelector('.remove-tag-btn')?.addEventListener('click', () => {
        currentTags.splice(idx, 1);
        renderTagChips();
      });

      tagsChipsContainer.appendChild(chip);
    });
  }

  function addTagFromInput() {
    if (!tagInput) return;
    const val = tagInput.value.trim();
    if (val) {
      const splitTags = val.split(/[,;\n]+/).map(t => t.trim()).filter(Boolean);
      splitTags.forEach(t => {
        if (!currentTags.includes(t)) {
          currentTags.push(t);
        }
      });
      tagInput.value = '';
      renderTagChips();
    }
  }

  addTagBtn?.addEventListener('click', addTagFromInput);
  tagInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addTagFromInput();
    }
  });
  tagInput?.addEventListener('keyup', (e) => {
    if (e.key === ',' || e.key === ';') {
      addTagFromInput();
    }
  });
  tagInput?.addEventListener('paste', () => {
    setTimeout(addTagFromInput, 10);
  });

  // Category Storage & Manager Integration
  const DEFAULT_CATEGORIES = ["AI Engineering", "Video Editing", "Coding Skills"];
  const CAT_STORAGE_KEY = 'freeyt_categories';

  function getStoredCategories(): string[] {
    try {
      const raw = localStorage.getItem(CAT_STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : null;
      if (Array.isArray(parsed) && parsed.length > 0) return parsed;
    } catch (e) {}
    localStorage.setItem(CAT_STORAGE_KEY, JSON.stringify(DEFAULT_CATEGORIES));
    return DEFAULT_CATEGORIES;
  }

  function saveStoredCategories(cats: string[]) {
    localStorage.setItem(CAT_STORAGE_KEY, JSON.stringify(cats));
    window.dispatchEvent(new CustomEvent('categoriesChanged', { detail: cats }));
  }

  const categorySelect = document.getElementById('category') as HTMLSelectElement;
  const newCatInput = document.getElementById('new-category-input') as HTMLInputElement;
  const addCatBtn = document.getElementById('add-category-btn');
  const catChipsContainer = document.getElementById('category-chips-container');
  const catCountBadge = document.getElementById('cat-count-badge');
  const catErrorMsg = document.getElementById('category-error-msg');

  function renderCategoryManager() {
    const cats = getStoredCategories();
    
    if (catCountBadge) {
      catCountBadge.textContent = `${cats.length} Categories`;
    }

    if (categorySelect) {
      const currentSelected = categorySelect.value;
      categorySelect.innerHTML = '<option value="" disabled>Select Category</option>';
      cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c;
        opt.textContent = c;
        if (c === currentSelected) {
          opt.selected = true;
        }
        categorySelect.appendChild(opt);
      });
      if (!currentSelected) {
        categorySelect.value = "";
      }
    }

    if (catChipsContainer) {
      catChipsContainer.innerHTML = '';
      cats.forEach(cat => {
        const chip = document.createElement('div');
        chip.className = 'inline-flex items-center gap-1 px-2.5 py-1 bg-canvas border border-hairline hover:border-primary/40 text-ink rounded-sm text-xs font-mono transition-colors group';
        chip.innerHTML = `
          <span>${cat}</span>
          <button type="button" class="remove-category-chip-btn text-mute hover:text-red-400 focus:outline-none cursor-pointer text-xs font-bold ml-1 transition-colors" data-category="${cat}" title="Remove category">&times;</button>
        `;

        chip.querySelector('.remove-category-chip-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          removeCategory(cat);
        });

        catChipsContainer.appendChild(chip);
      });
    }
  }

  function addCategoryFromInput() {
    if (!newCatInput) return;
    const rawVal = newCatInput.value.trim();
    if (!rawVal) {
      showCatError("Please enter a category name.");
      return;
    }

    const currentCats = getStoredCategories();
    const exists = currentCats.some(c => c.toLowerCase() === rawVal.toLowerCase());
    if (exists) {
      showCatError(`Category '${rawVal}' already exists.`);
      return;
    }

    hideCatError();
    const updated = [...currentCats, rawVal];
    saveStoredCategories(updated);
    renderCategoryManager();

    if (categorySelect) {
      categorySelect.value = rawVal;
    }

    newCatInput.value = '';
    
    if (typeof successToast !== 'undefined' && successToast) {
      const toastTitle = successToast.querySelector('h3');
      const toastDesc = successToast.querySelector('p');
      if (toastTitle) toastTitle.textContent = "Category Added";
      if (toastDesc) toastDesc.textContent = `New category '${rawVal}' has been added successfully.`;
      triggerToast();
    }
  }

  function removeCategory(catToRemove: string) {
    const currentCats = getStoredCategories();
    if (currentCats.length <= 1) {
      showCatError("At least one category must remain.");
      return;
    }

    hideCatError();
    const updated = currentCats.filter(c => c !== catToRemove);
    saveStoredCategories(updated);
    renderCategoryManager();

    if (typeof successToast !== 'undefined' && successToast) {
      const toastTitle = successToast.querySelector('h3');
      const toastDesc = successToast.querySelector('p');
      if (toastTitle) toastTitle.textContent = "Category Removed";
      if (toastDesc) toastDesc.textContent = `Category '${catToRemove}' has been removed.`;
      triggerToast();
    }
  }

  function showCatError(msg: string) {
    if (catErrorMsg) {
      catErrorMsg.textContent = msg;
      catErrorMsg.classList.remove('hidden');
    }
  }

  function hideCatError() {
    if (catErrorMsg) {
      catErrorMsg.classList.add('hidden');
    }
  }

  addCatBtn?.addEventListener('click', addCategoryFromInput);
  newCatInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addCategoryFromInput();
    }
  });

  window.addEventListener('categoriesChanged', renderCategoryManager);
  window.addEventListener('storage', (e) => {
    if (e.key === CAT_STORAGE_KEY) renderCategoryManager();
  });

  // YouTube Channel Auto-extraction Elements
  const authorAvatarPreview = document.getElementById('author-avatar-preview') as HTMLImageElement;
  const authorAvatarStatus = document.getElementById('author-avatar-status');
  const youtubeLinkInput = document.getElementById('youtube-link') as HTMLInputElement;
  const authorInput = document.getElementById('author') as HTMLInputElement;

  let extractedCreatorLogo = '';
  let extractedChannelId = '';
  let extractedSubscribers = '';
  let extractedViews = 12450;
  let extractedPublishDate = '';

  function redirectToLoginImmediately() {
    window.location.replace('/404');
  }

  function verifyAdminAuthSession() {
    if (!auth) {
      redirectToLoginImmediately();
      return;
    }

    onAuthStateChanged(auth, (user) => {
      if (user && user.uid === PUBLIC_ADMIN_UID) {
        grantAdminAccess();
      } else {
        redirectToLoginImmediately();
      }
    });
  }

  async function grantAdminAccess() {
    if (adminSubmitBtn) adminSubmitBtn.disabled = false;
    adminConsole?.classList.remove('hidden');
    setTimeout(() => {
      adminConsole?.classList.add('opacity-100', 'translate-y-0');
    }, 20);

    const urlParams = new URLSearchParams(window.location.search);
    const editSlug = urlParams.get('edit');
    if (editSlug && db) {
      isEditingMode = true;
      editOriginalSlug = editSlug;
      if (adminSubmitBtn) {
        adminSubmitBtn.innerHTML = `
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Update Course Payload
        `;
      }
      const pageTitle = document.querySelector('h1');
      if (pageTitle) pageTitle.textContent = "Edit Course Payload";
      
      try {
        const docRef = doc(db, "courses", editSlug);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
          const data = docSnap.data();
          const titleInput = document.getElementById('course-title') as HTMLInputElement;
          if (titleInput) titleInput.value = data.title || '';
          
          if (youtubeLinkInput) {
            youtubeLinkInput.value = data.youtubeUrl || (data.sampleVideoId ? `https://youtube.com/watch?v=${data.sampleVideoId}` : '');
          }
          
          if (authorInput) authorInput.value = data.author || data.creatorName || '';
          if (overviewInput) {
            overviewInput.value = data.overview || data.description || '';
            updateCounters();
          }
          
          if (data.category && categorySelect) {
            const cats = getStoredCategories();
            if (!cats.includes(data.category)) {
              cats.push(data.category);
              saveStoredCategories(cats);
              renderCategoryManager();
            }
            categorySelect.value = data.category;
          }
          
          if (data.language && languageSelect) {
            const langs = getAvailableLanguages();
            if (!langs.includes(data.language)) {
              langs.push(data.language);
              saveAvailableLanguages(langs);
              populateLanguageSelect();
            }
            languageSelect.value = data.language;
          }
          
          const loadedTags = data.tools || data.tags;
          if (loadedTags && Array.isArray(loadedTags)) {
            currentTags = [...loadedTags];
            renderTagChips();
          }
          


          const moduleTypeSelect = document.getElementById('module-type-select') as HTMLSelectElement;
          if (moduleTypeSelect && data.moduleType) {
            moduleTypeSelect.value = data.moduleType;
          }
          
          extractedCreatorLogo = data.creatorLogo || '';
          extractedChannelId = data.channelId || '';
          extractedSubscribers = data.creatorSubscribers || data.subscribers || '';
          extractedViews = data.views || 12450;
          extractedPublishDate = data.publishDate || '';
          extractedIsEmbeddable = data.isEmbeddable !== false;
          
          if (extractedCreatorLogo && authorAvatarPreview) {
            authorAvatarPreview.src = extractedCreatorLogo;
            authorAvatarPreview.classList.remove('hidden');
          }
          
          if (data.chapters && Array.isArray(data.chapters)) {
            if (modulesList) modulesList.innerHTML = '';
            moduleIndex = 0;
            data.chapters.forEach((ch: any) => {
               createModuleRow(ch.title, ch.duration || ch.description || '', ch.videoId || '');
               // After row creation, populate the new fields
               const lastRow = modulesList?.lastElementChild;
               if (lastRow) {
                 const cDescInput = lastRow.querySelector('.module-creator-desc-input') as HTMLTextAreaElement;
                 if (cDescInput) cDescInput.value = ch.creatorDescription || '';
                }
            });
            updateModuleCount();
          }
        }
      } catch(e) {
        console.error("Failed to fetch course for edit:", e);
      }
    }
  }

  // Handle Admin Sign Out
  lockConsoleBtn?.addEventListener('click', async () => {
    if (auth) {
      try {
        await signOut(auth);
      } catch (e) {
        console.error(e);
      }
    }
    localStorage.removeItem('freeyt_user_auth');
    window.location.href = '/login';
  });

  // Live overview validation
  function updateCounters() {
    const text = overviewInput.value.trim();
    const words = text ? text.split(/\s+/).filter(Boolean) : [];
    const wordCount = words.length;
    const charCount = text.length;

    if (wordCountDisplay) wordCountDisplay.textContent = String(wordCount);
    if (charCountDisplay) charCountDisplay.textContent = String(charCount);

    const minWords = 200;
    if (wordCount >= minWords) {
      if (adsenseBadge) {
        adsenseBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono border border-primary/20 bg-primary/10 text-primary flex items-center gap-1";
        adsenseBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-primary"></span> Meets AdSense criteria`;
      }
      adsenseWarning?.classList.add('hidden');
    } else {
      const wordsLeft = minWords - wordCount;
      if (adsenseBadge) {
        adsenseBadge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-mono border border-red-500/20 bg-red-500/10 text-red-400 flex items-center gap-1";
        adsenseBadge.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-red-500 animate-pulse"></span> Incomplete (<span id="words-needed">${wordsLeft}</span> left)`;
      }
      adsenseWarning?.classList.remove('hidden');
    }
  }

  overviewInput?.addEventListener('input', updateCounters);

  // Dynamic modules management
  let moduleIndex = 0;

  function createModuleRow(titleText = '', descText = '', videoText = '') {
    moduleIndex++;
    const rowId = `module-row-${moduleIndex}`;
    
    const row = document.createElement('div');
    row.id = rowId;
    row.className = "group border border-hairline bg-canvas/40 p-4 rounded-sm space-y-4 relative hover:border-hairline-soft transition-colors";
    
    row.innerHTML = `
      <div class="flex justify-between items-center">
        <span class="text-[10px] font-mono uppercase text-mute">Module Row #${moduleIndex}</span>
        <button 
          type="button" 
          class="remove-module-btn text-mute hover:text-red-400 text-xs font-mono flex items-center gap-1 transition-colors cursor-pointer bg-transparent border-none"
          data-target="${rowId}"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Remove
        </button>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-1">
          <label class="block text-[10px] font-mono uppercase tracking-wider text-mute mb-1.5">Chapter Title</label>
          <input 
            type="text" 
            placeholder="e.g. Module 1: Core Fundamentals" 
            class="module-title-input w-full bg-canvas border border-hairline text-ink rounded-sm px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/30 font-medium"
            required
          />
        </div>
        <div class="md:col-span-1">
          <label class="block text-[10px] font-mono uppercase tracking-wider text-mute mb-1.5">Module Duration</label>
          <input 
            type="text" 
            placeholder="e.g. 45 mins" 
            class="module-desc-input w-full bg-canvas border border-hairline text-ink rounded-sm px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/30 font-light"
            required
          />
        </div>
        <div class="md:col-span-1">
          <label class="block text-[10px] font-mono uppercase tracking-wider text-mute mb-1.5">YouTube Video ID / URL (Optional)</label>
          <input 
            type="text" 
            placeholder="e.g. BrsNcNS_5AM" 
            class="module-video-input w-full bg-canvas border border-hairline text-ink rounded-sm px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/30 font-light"
          />
        </div>
      </div>
      
      <div class="border-t border-hairline/40 pt-4 mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] font-mono uppercase tracking-wider text-mute mb-1.5">Creator Description / Module Notes</label>
          <textarea 
            class="module-creator-desc-input w-full bg-canvas border border-hairline text-ink rounded-sm px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-mute/30 min-h-[100px]"
            placeholder="Add detailed notes or creator description here..."></textarea>
        </div>
        </div>
      </div>
    `;


    const removeBtn = row.querySelector('.remove-module-btn');
    removeBtn?.addEventListener('click', () => {
      row.remove();
      updateModuleCount();
    });

    modulesList?.appendChild(row);
    updateModuleCount();

    if (titleText) {
      const titleInput = row.querySelector('.module-title-input') as HTMLInputElement;
      if (titleInput) titleInput.value = titleText;
    }
    if (descText) {
      const descInput = row.querySelector('.module-desc-input') as HTMLInputElement;
      if (descInput) descInput.value = descText;
    }
    if (videoText) {
      const videoInput = row.querySelector('.module-video-input') as HTMLInputElement;
      if (videoInput) videoInput.value = videoText;
    }
  }

  function updateModuleCount() {
    if (modulesList && moduleCountDisplay) {
      const count = modulesList.children.length;
      moduleCountDisplay.textContent = String(count);
    }
  }

  addModuleBtn?.addEventListener('click', () => createModuleRow());

  // Toast controls
  let toastTimeout: number;
  
  function triggerToast() {
    if (successToast) {
      successToast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
      successToast.classList.add('translate-y-0', 'opacity-100');
      
      clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(dismissToast, 4000);
    }
  }

  function dismissToast() {
    if (successToast) {
      successToast.classList.remove('translate-y-0', 'opacity-100');
      successToast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
    }
  }

  closeToastBtn?.addEventListener('click', dismissToast);

  // Form Reset
  resetFormBtn?.addEventListener('click', () => {
    if (confirm('Are you sure you want to discard all form inputs?')) {
      uploadForm.reset();
      if (modulesList) {
        modulesList.innerHTML = '';
      }
      moduleIndex = 0;
      extractedCreatorLogo = '';
      extractedChannelId = '';
      extractedSubscribers = '';
      extractedViews = 12450;
      extractedIsEmbeddable = true;
      if (authorAvatarPreview) authorAvatarPreview.classList.add('hidden');
      if (authorAvatarStatus) authorAvatarStatus.textContent = '';
      createModuleRow();
      updateCounters();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Form Submit
  uploadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const titleVal = (document.getElementById('course-title') as HTMLInputElement).value;
    const ytVal = (document.getElementById('youtube-link') as HTMLInputElement).value;

    if (!isEditingMode) {
      try {
        const dupRes = await fetch('/api/check-duplicate-course', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: ytVal.trim() })
        });
        if (dupRes.ok) {
          const dupData = await dupRes.json();
          if (dupData.isDuplicate) {
            alert("Error: This course is already in the database. Cannot submit duplicate course.");
            return;
          }
        }
      } catch (err) {
        console.warn("Could not check duplicate status on submit:", err);
      }
    }

    const catVal = (document.getElementById('category') as HTMLSelectElement).value;
    const authorVal = (document.getElementById('author') as HTMLInputElement).value;
    const langVal = (document.getElementById('course-language') as HTMLSelectElement).value;
    const overviewVal = overviewInput.value;

    const modules: Array<{ title: string; description: string; videoId: string; creatorDescription?: string }> = [];
    const moduleRows = modulesList?.children || [];
    for (let i = 0; i < moduleRows.length; i++) {
      const row = moduleRows[i];
      const titleInput = row.querySelector('.module-title-input') as HTMLInputElement;
      const descInput = row.querySelector('.module-desc-input') as HTMLInputElement;
      const videoInput = row.querySelector('.module-video-input') as HTMLInputElement;
      const creatorDescInput = row.querySelector('.module-creator-desc-input') as HTMLTextAreaElement;
      

      if (titleInput && descInput) {
        modules.push({
          title: titleInput.value.trim(),
          description: descInput.value.trim(),
          videoId: videoInput ? videoInput.value.trim() : '',
          creatorDescription: creatorDescInput ? creatorDescInput.value.trim() : ''
        });
      }
    }

    let slug = titleVal.toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)+/g, '');
      
    if (isEditingMode && editOriginalSlug) {
      slug = editOriginalSlug; // Keep the original slug to avoid creating duplicates
    }

    function getYoutubeId(url: string) {
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : '';
    }
    let sampleVideoId = getYoutubeId(ytVal);

    const chapters = modules.map(m => {
      let chVideoId = '';
      if (m.videoId) {
        chVideoId = m.videoId.includes('http') ? m.videoId : `https://youtu.be/${m.videoId}`;
      } else {
        chVideoId = sampleVideoId ? `https://youtu.be/${sampleVideoId}` : '';
      }
      return {
        title: m.title,
        duration: m.description || '15 mins',
        videoId: chVideoId || 'https://youtu.be/dQw4w9WgXcQ',
        creatorDescription: m.creatorDescription || ''
      };
    });

    if (!sampleVideoId && chapters.length > 0 && chapters[0].videoId && chapters[0].videoId !== 'dQw4w9WgXcQ') {
      sampleVideoId = chapters[0].videoId;
    }
    if (!sampleVideoId) {
      sampleVideoId = 'dQw4w9WgXcQ';
    }

    const tools = currentTags.length > 0 ? currentTags : [catVal || "General"];

    const selectedModuleType = (document.getElementById('module-type-select') as HTMLSelectElement)?.value || 'auto';
    const computedModuleType = selectedModuleType === 'auto' ? (chapters.length === 1 ? 'single' : 'multi') : selectedModuleType;

    const coursePayload = {
      id: Date.now(),
      slug,
      title: titleVal.trim(),
      description: overviewVal.trim().slice(0, 120) + "...",
      category: catVal,
      language: langVal,
      rating: 5.0,
      votes: 1,
      publishDate: extractedPublishDate || new Date().toISOString().split('T')[0],
      duration: "1h 30m",
      author: authorVal.trim(),
      creatorName: authorVal.trim(),
      creatorLogo: extractedCreatorLogo || "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=120&h=120",
      channelId: extractedChannelId || '',
      creatorSubscribers: extractedSubscribers || 'Verified Channel',
      views: extractedViews || 12450,
      type: "free",
      sampleVideoId,
      youtubeUrl: ytVal.trim(),
      tools,
      moduleType: computedModuleType,
      overview: overviewVal.trim(),
      chapters,
      isEmbeddable: extractedIsEmbeddable,
      isCreatorSubmission: (document.getElementById('creator-showcase-checkbox') as HTMLInputElement)?.checked || false,
      showcaseFeatured: (document.getElementById('creator-showcase-checkbox') as HTMLInputElement)?.checked || false
    };

    console.log("Writing payload to Firestore:", coursePayload);

    if (db) {
      try {
        const docRef = doc(db, "courses", slug);
        await setDoc(docRef, coursePayload);
        console.log("✅ Document successfully written to Firestore!");
        
        uploadForm.reset();
        if (modulesList) {
          modulesList.innerHTML = '';
        }
        extractedCreatorLogo = '';
        extractedChannelId = '';
        extractedSubscribers = '';
        extractedViews = 12450;
        extractedPublishDate = '';
        extractedIsEmbeddable = true;
        currentTags = [];
        renderTagChips();
        if (authorAvatarPreview) authorAvatarPreview.classList.add('hidden');
        if (authorAvatarStatus) authorAvatarStatus.textContent = '';
        createModuleRow();
        updateCounters();
        
        if (successToast) {
          const toastTitle = successToast.querySelector('h3');
          const toastDesc = successToast.querySelector('p');
          if (toastTitle) toastTitle.textContent = isEditingMode ? "Update Success" : "Submission Success";
          if (toastDesc) toastDesc.textContent = isEditingMode ? `Course '${slug}' has been successfully updated.` : `Course '${slug}' has been dynamically catalogued to Firestore.`;
        }

        triggerToast();
        
        if (isEditingMode) {
          setTimeout(() => {
            window.location.href = '/admin/courses';
          }, 1500);
        }
      } catch (err) {
        console.error("❌ Firestore Write Failed:", err);
        alert("Failed to write to database: " + (err instanceof Error ? err.message : err));
      }
    } else {
      console.warn("⚠️ Firestore is offline. Simulating local mock success.");
      triggerToast();
    }
  });

  // Language Selector logic
  function getAvailableLanguages() {
    try {
      const raw = localStorage.getItem(LANGS_KEY);
      return raw ? JSON.parse(raw) : ["English", "Hindi"];
    } catch (e) {
      return ["English", "Hindi"];
    }
  }

  function saveAvailableLanguages(langs: string[]) {
    localStorage.setItem(LANGS_KEY, JSON.stringify(langs));
  }

  function populateLanguageSelect() {
    if (!languageSelect) return;
    const langs = getAvailableLanguages();
    const selectedVal = languageSelect.value;
    
    languageSelect.innerHTML = `<option value="" disabled ${selectedVal === "" ? "selected" : ""}>Select Language</option>`;
    langs.forEach((lang: string) => {
      const option = document.createElement('option');
      option.value = lang;
      option.textContent = lang;
      if (lang === selectedVal) option.selected = true;
      languageSelect.appendChild(option);
    });
  }

  addCustomLangBtn?.addEventListener('click', () => {
    customLangContainer?.classList.toggle('hidden');
    if (customLangContainer && !customLangContainer.classList.contains('hidden')) {
      customLangInput?.focus();
    }
  });

  saveCustomLangBtn?.addEventListener('click', () => {
    if (!customLangInput || !languageSelect) return;
    const newLang = customLangInput.value.trim();
    if (!newLang) return;
    
    const langs = getAvailableLanguages();
    if (!langs.includes(newLang)) {
      langs.push(newLang);
      saveAvailableLanguages(langs);
    }
    
    populateLanguageSelect();
    languageSelect.value = newLang;
    customLangInput.value = '';
    customLangContainer?.classList.add('hidden');
  });

  // Extract YouTube channel info
  async function fetchChannelInfo(urlOrId: string) {
    if (!urlOrId || !authorAvatarStatus) return;
    
    authorAvatarStatus.textContent = "⌛ Fetching channel info...";
    authorAvatarStatus.className = "text-[10px] font-mono text-primary animate-pulse";
    
    try {
      const res = await fetch(`/api/youtube-info?url=${encodeURIComponent(urlOrId)}`);
      if (!res.ok) {
        throw new Error('Failed to resolve channel info');
      }
      const data = await res.json();
      
      let isDuplicate = false;
      try {
        if (db && !isEditingMode) {
          const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
          const match = urlOrId.match(regExp);
          const videoId = (match && match[2].length === 11) ? match[2] : urlOrId;
          
          const qVid = query(collection(db, "courses"), where("sampleVideoId", "==", videoId));
          const snap = await getDocs(qVid);
          if (!snap.empty) {
            isDuplicate = true;
            alert("Error: A course with this exact YouTube video already exists in the database. Duplicate submissions are not allowed.");
          }
        }
      } catch (err) {
        console.warn("Could not verify duplicates:", err);
      }
      
      extractedIsEmbeddable = data.isEmbeddable !== false;

      if (data.isEmbeddable === false) {
        authorAvatarStatus.textContent = "Notice: This video cannot be embedded inside the app. It will be published to the 'External Roadmaps' directory.";
        authorAvatarStatus.className = "text-[10px] font-mono text-amber-500 font-bold";
      }
      
      if (data.channelName) {
        if (authorInput) {
          authorInput.value = data.channelName;
        }
        extractedCreatorLogo = data.creatorLogo;
        extractedChannelId = data.channelId;
        extractedSubscribers = data.subscribers || 'Verified Channel';
        extractedViews = data.views || 12450;
        extractedPublishDate = data.publishDate || '';
        
        if (authorAvatarPreview) {
          authorAvatarPreview.src = data.creatorLogo;
          authorAvatarPreview.classList.remove('hidden');
        }
        
        if (data.isEmbeddable !== false) {
          let statusMsg = isDuplicate ? "⚠️ DUPLICATE! ✅ Resolved!" : "✅ Resolved!";
          if (data.subscribers) statusMsg += ` (${data.subscribers})`;
          if (data.views) statusMsg += ` • ${Number(data.views).toLocaleString()} video views`;
          authorAvatarStatus.textContent = statusMsg;
          authorAvatarStatus.className = isDuplicate ? "text-[10px] font-mono text-amber-500 font-bold" : "text-[10px] font-mono text-green-400";
        }
      } else {
        authorAvatarStatus.textContent = "⚠️ Could not resolve channel info.";
        authorAvatarStatus.className = "text-[10px] font-mono text-mute";
      }
    } catch (e) {
      console.warn("Failed to fetch channel info:", e);
      authorAvatarStatus.textContent = "❌ Failed to fetch channel details.";
      authorAvatarStatus.className = "text-[10px] font-mono text-red-400";
    }
  }

  youtubeLinkInput?.addEventListener('change', () => {
    const val = youtubeLinkInput.value.trim();
    if (val) {
      const isPlaylist = val.includes('playlist?list=') || val.startsWith('PL');
      if (isPlaylist) {
        if (authorAvatarStatus) {
          authorAvatarStatus.textContent = "⌛ Playlist detected. Please enter video ID in Module 1 to load channel info.";
          authorAvatarStatus.className = "text-[10px] font-mono text-primary";
        }
      } else {
        fetchChannelInfo(val);
      }
    }
  });

  modulesList?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    if (target && target.classList.contains('module-video-input')) {
      const row = target.closest('[id^="module-row-"]');
      if (row) {
        const rows = Array.from(modulesList.children);
        const index = rows.indexOf(row);
        if (index === 0) {
          const val = target.value.trim();
          const mainUrlVal = youtubeLinkInput?.value.trim() || '';
          const isMainPlaylist = mainUrlVal.includes('playlist?list=') || mainUrlVal.startsWith('PL');
          if (val && (isMainPlaylist || !mainUrlVal)) {
            fetchChannelInfo(val);
          }
        }
      }
    }
  });

  // Auto-Fill Logic
  const autoFillBtn = document.getElementById('auto-fill-ai-btn') as HTMLButtonElement;
  const autoFillStatus = document.getElementById('auto-fill-status');

  autoFillBtn?.addEventListener('click', async () => {
    const url = youtubeLinkInput.value.trim();
    if (!url) {
      alert("Please enter a valid YouTube URL first.");
      return;
    }

    if (!isEditingMode) {
      try {
        const dupRes = await fetch('/api/check-duplicate-course', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        if (dupRes.ok) {
          const dupData = await dupRes.json();
          if (dupData.isDuplicate) {
            alert("Error: This course is already in the database. Cannot add duplicate course.");
            return;
          }
        }
      } catch (err) {
        console.warn("Could not check duplicate status:", err);
      }
    }

    if (autoFillStatus) {
      autoFillStatus.textContent = "Extracting YouTube metadata...";
      autoFillStatus.classList.remove('hidden', 'text-red-400');
      autoFillStatus.classList.add('text-primary', 'animate-pulse');
    }
    autoFillBtn.disabled = true;

    try {
      const res = await fetch('/api/auto-import-course', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });
      const data = await res.json();
      
      if (!res.ok) throw new Error(data.error || 'Failed to extract');

      // Populate Title
      const titleInput = document.getElementById('course-title') as HTMLInputElement;
      if (titleInput) titleInput.value = data.title;

      // Populate Overview
      if (overviewInput) {
        overviewInput.value = data.overview;
        updateCounters();
      }

      // Handle tags
      data.tags.forEach((tag: string) => {
        if (!currentTags.includes(tag)) currentTags.push(tag);
      });
      data.tools.forEach((tool: string) => {
        if (!currentTags.includes(tool)) currentTags.push(tool);
      });
      renderTagChips();

      // Clear existing modules and populate new ones
      if (modulesList) modulesList.innerHTML = '';
      moduleIndex = 0;
      data.modules.forEach((mod: any) => {
        createModuleRow(mod.title, mod.duration, mod.videoId);
        const lastRow = modulesList?.lastElementChild;
        if (lastRow) {
          const cDescInput = lastRow.querySelector('.module-creator-desc-input') as HTMLTextAreaElement;
          if (cDescInput) cDescInput.value = mod.creatorDescription || '';
        }
      });
      updateModuleCount();

      // Deep Duplicate Check: Check all video IDs to ensure none already exist in the database
      if (!isEditingMode && data.modules && data.modules.length > 0) {
        const extractedVideoIds = data.modules.map((m: any) => m.videoId).filter(Boolean);
        if (extractedVideoIds.length > 0) {
           try {
              const deepDupRes = await fetch('/api/check-duplicate-course', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({ url, videoIds: extractedVideoIds })
              });
              if (deepDupRes.ok) {
                 const deepDupData = await deepDupRes.json();
                 if (deepDupData.isDuplicate) {
                    alert("Error: One or more videos from this playlist already exist as part of a curated course on our website. Cannot add overlapping course.");
                    if (autoFillStatus) {
                        autoFillStatus.textContent = "Overlapping Duplicate Found!";
                        autoFillStatus.classList.remove('animate-pulse', 'text-primary');
                        autoFillStatus.classList.add('text-red-400');
                    }
                    uploadForm.reset();
                    if (modulesList) modulesList.innerHTML = '';
                    return;
                 }
              }
           } catch (e) {
              console.warn("Could not perform deep duplicate check:", e);
           }
        }
      }

      // Trigger standard channel info fetch which will handle author, views, logo, embeddable status
      let channelInfoUrl = url;
      if (data.modules && data.modules.length > 0) {
        channelInfoUrl = data.modules[0].videoId;
      }
      await fetchChannelInfo(channelInfoUrl);

      if (autoFillStatus) {
        autoFillStatus.textContent = "Auto-fill complete!";
        autoFillStatus.classList.remove('animate-pulse', 'text-red-400');
        autoFillStatus.classList.add('text-green-400');
        setTimeout(() => autoFillStatus.classList.add('hidden'), 5000);
      }

    } catch (err: any) {
      if (autoFillStatus) {
        autoFillStatus.textContent = "Error: " + err.message;
        autoFillStatus.classList.remove('text-primary', 'animate-pulse');
        autoFillStatus.classList.add('text-red-400');
      }
    } finally {
      autoFillBtn.disabled = false;
    }
  });

  // Initialization
  verifyAdminAuthSession();
  renderCategoryManager();
  populateLanguageSelect();
  if (modulesList && modulesList.children.length === 0) {
    createModuleRow();
  }
  updateCounters();
</script>
