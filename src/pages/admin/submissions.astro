---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin Submissions Queue | FreeYTCourses" description="Review course submissions from creators." activePage="admin" hideSidebar={true}>
  <main class="max-w-6xl mx-auto px-6 py-16 min-h-[calc(100vh-140px)]">
    <!-- Admin Submissions Console (Hidden Until Authenticated) -->
    <div id="admin-console" class="hidden w-full space-y-8 opacity-0 transform translate-y-4 transition-all duration-500">
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-hairline pb-6 mb-10">
      <div>
        <div class="inline-block font-mono text-[10px] text-primary uppercase tracking-[2.52px] mb-2 bg-primary/10 px-2.5 py-1 rounded-pill border border-primary/20">
          Authenticated Admin Session
        </div>
        <h1 class="text-3xl font-light text-ink-strong tracking-[-0.65px] mb-1">Creator Submissions Queue</h1>
        <p class="text-body text-sm font-light">Review, approve, or reject pending course submissions.</p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/admin/courses" 
          class="text-xs font-mono uppercase bg-canvas-soft border border-hairline hover:border-primary text-ink hover:text-primary px-3.5 py-2.5 rounded-sm transition-all flex items-center gap-2 cursor-pointer font-medium"
        >
          <svg class="h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          Directory
        </a>

        <a 
          href="/admin/upload" 
          class="text-xs font-mono uppercase border border-primary/50 text-primary hover:bg-primary hover:text-on-primary px-3.5 py-2.5 rounded-sm transition-all flex items-center gap-2 cursor-pointer font-bold"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Add New
        </a>

        <button 
          id="lock-console-btn" 
          class="text-xs font-mono uppercase border border-hairline hover:border-red-500/50 hover:text-red-400 text-body px-3.5 py-2.5 rounded-sm transition-all flex items-center gap-2 cursor-pointer"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sign Out Admin
        </button>
      </div>
    </div>

      <div id="submissions-container" class="space-y-6">
        <div id="loading-state" class="text-center py-12 text-mute animate-pulse">
          Loading pending submissions...
        </div>
        <!-- Submissions injected here -->
      </div>
    </div>
  </main>
</Layout>

<script>
  import { db, auth } from '../../lib/firebase.js';
  import { collection, query, where, getDocs, doc, updateDoc, setDoc, serverTimestamp } from 'firebase/firestore';
  import { onAuthStateChanged, signOut } from 'firebase/auth';

  const PUBLIC_ADMIN_UID = import.meta.env.PUBLIC_ADMIN_UID || 'L3hLhdVxWBRkPk4GQg5KIZGFrx63';

  const container = document.getElementById('submissions-container');
  const loadingState = document.getElementById('loading-state');
  const adminConsole = document.getElementById('admin-console');
  const lockConsoleBtn = document.getElementById('lock-console-btn');

  lockConsoleBtn?.addEventListener('click', async () => {
    try {
      if (auth) await signOut(auth);
      redirectToLoginImmediately();
    } catch (e) {
      console.error("Logout failed", e);
    }
  });

  function redirectToLoginImmediately() {
    window.location.replace('/404');
  }

  function verifyAdminAuthSession() {
    if (!auth) {
      redirectToLoginImmediately();
      return;
    }

    onAuthStateChanged(auth, (user) => {
      if (user && user.uid === PUBLIC_ADMIN_UID) {
        grantAdminAccess();
      } else {
        redirectToLoginImmediately();
      }
    });
  }

  function grantAdminAccess() {
    adminConsole?.classList.remove('hidden');
    // slight delay to allow display:block to apply before animating opacity
    setTimeout(() => {
      adminConsole?.classList.remove('opacity-0', 'translate-y-4');
      adminConsole?.classList.add('opacity-100', 'translate-y-0');
    }, 10);
    
    loadSubmissions();
  }

  async function loadSubmissions() {
    if (!db) {
      if (loadingState) loadingState.textContent = 'Firestore is not initialized.';
      return;
    }
    if (!container) return;

    try {
      const q = query(collection(db, 'courseSubmissions'), where('status', '==', 'pending'));
      const snapshot = await getDocs(q);
      
      if (loadingState) loadingState.remove();
      container.innerHTML = '';

      if (snapshot.empty) {
        container.innerHTML = '<div class="text-center py-12 text-mute bg-canvas-soft rounded-md border border-hairline">No pending submissions found.</div>';
        return;
      }

      snapshot.forEach((submissionDoc) => {
        const sub = submissionDoc.data();
        const subId = submissionDoc.id;

        const card = document.createElement('div');
        card.className = 'bg-canvas border border-hairline rounded-md p-6 shadow-sm flex flex-col md:flex-row gap-6';
        
        card.innerHTML = `
          <div class="flex-1 space-y-4">
            <div>
              <span class="text-xs font-mono uppercase bg-primary/10 text-primary px-2 py-1 rounded-sm mb-2 inline-block">Pending Review</span>
              ${sub.requestsShowcase ? '<span class="text-xs font-mono uppercase bg-green-500/10 text-green-700 px-2 py-1 rounded-sm mb-2 inline-block ml-2 border border-green-500/20" title="The creator explicitly requested to be in the Creator Showcase">✨ Requested Showcase</span>' : ''}
              <h3 class="text-lg font-bold text-ink-strong truncate" title="${sub.url}">${sub.url}</h3>
              <p class="text-sm text-body">Category: <span class="font-semibold text-ink">${sub.typedCategory || 'None'}</span></p>
              <p class="text-sm text-body">Creator Email: ${sub.creatorEmail || 'Unknown'}</p>
              <p class="text-xs text-mute mt-1">Submitted: ${sub.submittedAt ? new Date(sub.submittedAt.toMillis()).toLocaleString() : 'N/A'}</p>
            </div>
            
            <div class="metadata-preview bg-canvas-soft border border-hairline p-4 rounded-md text-sm hidden">
               <!-- YouTube metadata injected here -->
            </div>

            <div class="flex items-center gap-2 mt-4">
               <input type="checkbox" id="featureInShowcase-${subId}" class="h-4 w-4 text-primary rounded border-hairline cursor-pointer" ${sub.requestsShowcase ? 'checked' : ''} />
               <label for="featureInShowcase-${subId}" class="text-sm font-semibold text-ink-strong cursor-pointer">Feature in Creator Homepage Section</label>
            </div>
            
            <div class="flex gap-3 pt-4 border-t border-hairline">
              <button data-id="${subId}" class="fetch-btn bg-canvas-soft hover:bg-canvas border border-hairline px-4 py-2 rounded text-sm font-medium transition-colors">Fetch YouTube Data</button>
              <button data-id="${subId}" class="accept-btn bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors hidden">Accept Course</button>
              <button data-id="${subId}" class="reject-btn bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded text-sm font-medium transition-colors">Reject Course</button>
            </div>
          </div>
        `;
        
        container.appendChild(card);
        
        // Fetch button logic
        const fetchBtn = card.querySelector('.fetch-btn') as HTMLButtonElement;
        const acceptBtn = card.querySelector('.accept-btn') as HTMLButtonElement;
        const rejectBtn = card.querySelector('.reject-btn') as HTMLButtonElement;
        const metadataDiv = card.querySelector('.metadata-preview') as HTMLDivElement;
        let fetchedCourseData: any = null;

        fetchBtn.addEventListener('click', async () => {
          fetchBtn.disabled = true;
          fetchBtn.textContent = 'Fetching...';
          try {
            const res = await fetch('/api/auto-import-course', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ url: sub.url })
            });
            if (!res.ok) throw new Error('Fetch failed');
            fetchedCourseData = await res.json();
            
            metadataDiv.classList.remove('hidden');
            metadataDiv.innerHTML = `
              <div class="flex gap-4">
                <img src="${fetchedCourseData.thumbnail}" alt="Thumbnail" class="w-32 h-20 object-cover rounded border border-hairline" />
                <div>
                  <p class="font-bold text-ink truncate">${fetchedCourseData.title}</p>
                  <p class="text-xs text-body mt-1">Channel: ${fetchedCourseData.creatorName}</p>
                  <p class="text-xs text-body mt-1">Duration: ${fetchedCourseData.modules?.[0]?.duration || 'Unknown'}</p>
                  <p class="text-xs mt-1 ${fetchedCourseData.isEmbeddable ? 'text-green-600' : 'text-red-600 font-bold'}">
                    ${fetchedCourseData.isEmbeddable ? '✅ Embeddable' : '❌ Not Embeddable'}
                  </p>
                </div>
              </div>
            `;
            
            fetchBtn.classList.add('hidden');
            if (fetchedCourseData.isEmbeddable) {
              acceptBtn.classList.remove('hidden');
            }
          } catch (e) {
            console.error(e);
            metadataDiv.classList.remove('hidden');
            metadataDiv.innerHTML = '<p class="text-red-500">Failed to fetch YouTube metadata.</p>';
            fetchBtn.disabled = false;
            fetchBtn.textContent = 'Retry Fetch';
          }
        });

        // Accept logic
        acceptBtn.addEventListener('click', async () => {
          if (!fetchedCourseData || !db) return;
          acceptBtn.disabled = true;
          acceptBtn.textContent = 'Accepting...';
          const isShowcase = (card.querySelector(`#featureInShowcase-${subId}`) as HTMLInputElement).checked;

          try {
            // Write to courses
            const courseSlug = fetchedCourseData.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            // We use the slug as ID or let Firestore generate one, but typically we want a clean ID
            // Just use addDoc to courses collection or setDoc if we want slug as ID. In this app, ID is auto-generated usually.
            
            // To ensure unique slug, we append random chars
            const finalSlug = courseSlug + '-' + Math.floor(Math.random() * 10000);

            const courseRef = doc(collection(db, 'courses'));
            await setDoc(courseRef, {
              ...fetchedCourseData,
              slug: finalSlug,
              category: sub.typedCategory,
              type: 'free',
              isCreatorSubmission: true,
              creatorSubmittedAt: serverTimestamp(),
              showcaseFeatured: isShowcase
            });

            // Update submission status
            await updateDoc(doc(db, 'courseSubmissions', subId), {
              status: 'approved'
            });

            // Send Email Notification
            if (sub.creatorEmail) {
              fetch('/api/send-submission-email', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: sub.creatorEmail, status: 'approved', courseUrl: sub.url, courseTitle: fetchedCourseData.title })
              }).catch(err => console.error('Failed to send email:', err));
            }

            card.remove();
          } catch (e) {
            console.error(e);
            alert('Failed to accept course.');
            acceptBtn.disabled = false;
            acceptBtn.textContent = 'Accept Course';
          }
        });

        // Reject logic
        rejectBtn.addEventListener('click', async () => {
          if (!db) return;
          if (!confirm('Are you sure you want to reject this submission?')) return;
          rejectBtn.disabled = true;
          rejectBtn.textContent = 'Rejecting...';
          try {
            await updateDoc(doc(db, 'courseSubmissions', subId), {
              status: 'rejected'
            });

            // Send Email Notification
            if (sub.creatorEmail) {
              fetch('/api/send-submission-email', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: sub.creatorEmail, status: 'rejected', courseUrl: sub.url, courseTitle: fetchedCourseData?.title })
              }).catch(err => console.error('Failed to send email:', err));
            }

            card.remove();
          } catch (e) {
            console.error(e);
            alert('Failed to reject course.');
            rejectBtn.disabled = false;
            rejectBtn.textContent = 'Reject Course';
          }
        });
      });
    } catch (err) {
      console.error(err);
      if (loadingState) loadingState.textContent = 'Error loading submissions.';
    }
  }

  // Initial load via Auth Verification
  verifyAdminAuthSession();
</script>
