---
import Layout from '../layouts/Layout.astro';
import { getAllCourses, getYoutubeThumbnail } from '../lib/firebase.js';

const allCourses = await getAllCourses();
const externalCourses = allCourses.filter(course => course.isEmbeddable === false);

// Dynamically compute the set of unique languages present in external courses
const languages = Array.from(new Set(externalCourses.map(c => c.language || "English").filter(Boolean)));

const title = "External Roadmaps - Free YouTube Courses";
const description = "A collection of high-quality learning roadmaps hosted externally on YouTube.";
---

<Layout title={title} description={description} activePage="external">
  <main class="max-w-6xl mx-auto px-6 py-8 md:py-12">
    <!-- Top Header -->
    <div class="mb-8 pb-4 border-b border-hairline flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-2xl font-light text-ink-strong tracking-tight flex items-center gap-3">
          External Roadmaps
        </h1>
        <p class="text-xs font-mono text-mute mt-1">High-quality courses available exclusively on YouTube due to creator embedding preferences.</p>
      </div>
    </div>

    {externalCourses.length === 0 ? (
      <div class="text-center py-20 bg-canvas-soft border border-hairline rounded-md">
        <svg class="h-12 w-12 text-mute mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-body font-mono text-sm">No external roadmaps found.</p>
      </div>
    ) : (
      <>
        <!-- Filters & Sort Controls Bar (Dropdown Selects) -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 p-4 bg-canvas-soft/40 border border-hairline rounded-md">
          <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-4 w-full md:w-auto">
            
            <!-- Skill / Category Filter Dropdown -->
            <div class="flex items-center gap-2">
              <label for="skill-filter-select" class="text-xs font-mono uppercase tracking-wider text-mute font-semibold shrink-0">Filter Skill:</label>
              <div class="relative flex-1 sm:flex-initial">
                <select 
                  id="skill-filter-select" 
                  class="w-full sm:w-48 appearance-none bg-canvas border border-hairline text-ink rounded-sm pl-3.5 pr-9 py-2 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer"
                >
                  <option value="All" selected>All Courses</option>
                  <option value="AI Engineering">AI Engineering</option>
                  <option value="Video Editing">Video Editing</option>
                  <option value="Coding Skills">Coding Skills</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Language Filter Dropdown -->
            <div class="flex items-center gap-2">
              <label for="language-filter-select" class="text-xs font-mono uppercase tracking-wider text-mute font-semibold shrink-0">Language:</label>
              <div class="relative flex-1 sm:flex-initial">
                <select 
                  id="language-filter-select" 
                  class="w-full sm:w-44 appearance-none bg-canvas border border-hairline text-ink rounded-sm pl-3.5 pr-9 py-2 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer"
                >
                  <option value="All" selected>All Languages</option>
                  {languages.map((lang) => (
                    <option value={lang}>{lang}</option>
                  ))}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Module Structure Filter Dropdown -->
            <div class="flex items-center gap-2">
              <label for="module-filter-select" class="text-xs font-mono uppercase tracking-wider text-mute font-semibold shrink-0">Modules:</label>
              <div class="relative flex-1 sm:flex-initial">
                <select 
                  id="module-filter-select" 
                  class="w-full sm:w-44 appearance-none bg-canvas border border-hairline text-ink rounded-sm pl-3.5 pr-9 py-2 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer"
                >
                  <option value="All" selected>All Modules</option>
                  <option value="single">Crashcourse (1)</option>
                  <option value="multi">Playlist/Chapters (2+)</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-mute">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

          </div>

          <!-- Sort By Dropdown -->
          <div class="flex items-center gap-2 w-full md:w-auto justify-start md:justify-end">
            <label for="sort-filter-select" class="text-xs font-mono uppercase tracking-wider text-mute font-semibold shrink-0">Sort By:</label>
            <div class="relative flex-1 sm:flex-initial">
              <select 
                id="sort-filter-select" 
                class="w-full sm:w-56 appearance-none bg-canvas border border-hairline text-ink rounded-sm pl-3.5 pr-9 py-2 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer"
              >
                <option value="most-watched" selected>Most Watched on Site</option>
                <option value="latest">Latest</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-mute">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <div id="course-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {externalCourses.map((course) => (
            <article 
              class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-amber-500/40 transition-all duration-300 relative overflow-hidden h-full"
              data-category={course.category}
              data-language={course.language || 'English'}
              data-module-type={course.moduleType || (course.chapters && course.chapters.length === 1 ? 'single' : 'multi')}
              data-views={course.views}
              data-date={course.publishDate}
              data-slug={course.slug}
            >
              
              <!-- Thumbnail -->
              <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
                <img 
                  src={course.thumbnail || getYoutubeThumbnail(course.sampleVideoId)} 
                  alt={`${course.title} thumbnail`} 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-sm font-semibold shadow-md bg-amber-500/90 text-on-primary border border-amber-500/20 backdrop-blur-sm">
                  External
                </span>
              </div>

              <!-- Content -->
              <div class="p-6 flex flex-col justify-between flex-grow">
                <div class="mb-4">
                  <div class="flex items-center gap-2 mb-3">
                    <div class="h-6 w-6 rounded-full bg-canvas border border-hairline overflow-hidden shrink-0">
                      <img src={course.creatorLogo} alt={course.creatorName} class="h-full w-full object-cover" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=random&color=fff';" />
                    </div>
                    <span class="text-xs font-mono text-mute truncate">{course.creatorName}</span>
                  </div>
                  
                  <h3 class="text-base font-semibold text-ink-strong leading-snug mb-2 group-hover:text-amber-500 transition-colors line-clamp-2">
                    {course.title}
                  </h3>
                  
                  <p class="text-xs text-body font-light line-clamp-2">
                    {course.description}
                  </p>
                </div>

                <!-- Tools -->
                <div class="mb-5 flex flex-wrap gap-1.5">
                  {course.tools && course.tools.slice(0, 3).map((tool) => (
                    <span class="text-[9px] font-mono uppercase bg-canvas border border-hairline text-mute px-1.5 py-0.5 rounded-sm">
                      {tool}
                    </span>
                  ))}
                  {course.tools && course.tools.length > 3 && (
                    <span class="text-[9px] font-mono uppercase text-mute self-center">
                      +{course.tools.length - 3}
                    </span>
                  )}
                </div>

                <!-- Watch Button -->
                <a 
                  href={course.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto w-full flex items-center justify-center gap-2 py-2.5 bg-canvas border border-hairline hover:border-amber-500/50 hover:bg-amber-500/5 text-ink hover:text-amber-600 text-xs font-mono uppercase font-semibold rounded-sm transition-all shadow-sm"
                >
                  Watch on YouTube
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div id="empty-state" class="hidden text-center py-20 bg-canvas-soft border border-hairline rounded-md">
          <svg class="h-12 w-12 text-mute mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-body font-mono text-sm">No external roadmaps found matching your filters.</p>
        </div>
      </>
    )}
  </main>
</Layout>

<script>
  import { getCourseSiteViews } from '../lib/userStorage.js';

  // Dropdown Filter Elements
  const skillSelect = document.getElementById('skill-filter-select') as HTMLSelectElement;
  const languageSelect = document.getElementById('language-filter-select') as HTMLSelectElement;
  const moduleSelect = document.getElementById('module-filter-select') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-filter-select') as HTMLSelectElement;

  const courseGrid = document.getElementById('course-grid');
  const emptyState = document.getElementById('empty-state');
  
  let activeFilter = 'All';
  let activeLanguage = 'All';
  let activeModuleType = 'All';
  let activeSort = 'most-watched';

  function calculateCourseRank(card: HTMLElement): number {
    const slug = card.getAttribute('data-slug') || '';
    const viewsAttr = card.getAttribute('data-views') || '0';
    const baseViews = parseInt(viewsAttr, 10) || 0;
    const siteViews = getCourseSiteViews(slug);
    
    const siteViewsScore = Math.min((siteViews || 0) * 10, 50);
    return baseViews + siteViewsScore;
  }

  function applyFiltersAndSort() {
    if (!courseGrid) return;
    const cards = Array.from(courseGrid.querySelectorAll('article.course-card')) as HTMLElement[];

    let visibleCount = 0;
    const scoredCards: { card: HTMLElement; score: number }[] = [];

    cards.forEach((card) => {
      const cat = card.getAttribute('data-category');
      const lang = card.getAttribute('data-language') || 'English';
      const modType = card.getAttribute('data-module-type') || 'multi';

      const matchesCategory = activeFilter === 'All' || cat === activeFilter;
      const matchesLanguage = activeLanguage === 'All' || lang === activeLanguage;
      const matchesModuleType = activeModuleType === 'All' || modType === activeModuleType;

      if (matchesCategory && matchesLanguage && matchesModuleType) {
        card.classList.remove('hidden');
        const score = calculateCourseRank(card);
        scoredCards.push({ card, score });
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      courseGrid.classList.add('hidden');
    } else {
      if (emptyState) emptyState.classList.add('hidden');
      courseGrid.classList.remove('hidden');
    }

    scoredCards.sort((a, b) => {
      if (activeSort === 'latest') {
        const dateA = new Date(a.card.getAttribute('data-date') || 0).getTime();
        const dateB = new Date(b.card.getAttribute('data-date') || 0).getTime();
        return dateB - dateA;
      } else {
        // most-watched
        return b.score - a.score;
      }
    });

    scoredCards.forEach((item) => {
      courseGrid.appendChild(item.card);
    });
  }

  skillSelect?.addEventListener('change', (e) => {
    activeFilter = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  languageSelect?.addEventListener('change', (e) => {
    activeLanguage = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });
  
  moduleSelect?.addEventListener('change', (e) => {
    activeModuleType = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  sortSelect?.addEventListener('change', (e) => {
    activeSort = (e.target as HTMLSelectElement).value;
    applyFiltersAndSort();
  });

  // Populate Category dynamically
  function populateCategoryOptions() {
    if (!skillSelect) return;
    try {
      const raw = localStorage.getItem('freeyt_categories');
      const cats = raw ? JSON.parse(raw) : ["AI Engineering", "Video Editing", "Coding Skills"];
      const cur = activeFilter;

      skillSelect.innerHTML = '<option value="All">All Courses</option>';
      cats.forEach((cat: string) => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.textContent = cat;
        if (cat === cur) opt.selected = true;
        skillSelect.appendChild(opt);
      });
      if (!cats.includes(cur) && cur !== 'All') {
        skillSelect.value = 'All';
        activeFilter = 'All';
      }
    } catch (e) {}
  }
  
  window.addEventListener('categoriesChanged', () => {
    populateCategoryOptions();
    applyFiltersAndSort();
  });

  window.addEventListener('storage', (e) => {
    if (e.key === 'freeyt_categories') {
      populateCategoryOptions();
      applyFiltersAndSort();
    }
  });

  populateCategoryOptions();
  applyFiltersAndSort();
</script>
