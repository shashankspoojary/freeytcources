---
import Layout from '../layouts/Layout.astro';
import { getAllCourses, getYoutubeThumbnail, getCreatorSlug } from '../lib/firebase.js';

export const seoTopicsConfig: Record<string, {
  slug: string;
  pageUrl: string;
  title: string;
  seoTitle: string;
  seoDescription: string;
  h1: string;
  badge: string;
  topicName: string;
  keywords: string[];
  categoryMatch: string[];
  introText: string;
  prerequisites: string;
  estimatedHours: string;
  faqs: Array<{ question: string; answer: string }>;
}> = {
  "react": {
    slug: "react",
    pageUrl: "/best-free-react-course",
    title: "Best Free React Course (2026)",
    seoTitle: "Best Free React Course (2026) - Top YouTube Tutorials & Syllabi",
    seoDescription: "Master React.js for free with handpicked YouTube courses, step-by-step component roadmaps, and full project tutorials from top creators.",
    h1: "Best Free React Courses & Learning Roadmaps",
    badge: "React & Next.js 2026",
    topicName: "React.js",
    keywords: ["react", "react.js", "next.js", "jsx", "hooks", "frontend"],
    categoryMatch: ["Coding Skills", "Web Development"],
    introText: "React remains the world's most popular JavaScript library for building modern web applications. We have curated top free YouTube React courses featuring component architecture, hooks, state management, and full-stack Next.js integration.",
    prerequisites: "HTML, CSS, Modern JavaScript (ES6+)",
    estimatedHours: "20-40 Hours",
    faqs: [
      {
        question: "Can I master React for free using YouTube courses?",
        answer: "Absolutely. Top software engineers and creators publish complete 10+ hour React masterclasses on YouTube covering components, state, hooks, and project deployment for free."
      },
      {
        question: "What is the best way to start learning React in 2026?",
        answer: "Start with modern JavaScript ES6 fundamentals, then learn React JSX syntax, props, useState, useEffect, and component modularity before moving to Next.js or state management libraries."
      },
      {
        question: "Do these courses include real-world projects?",
        answer: "Yes, all curated React tutorials on FreeYTCourses include hands-on project builds such as interactive dashboards, e-commerce apps, and AI-powered web interfaces."
      }
    ]
  },
  "python": {
    slug: "python",
    pageUrl: "/best-free-python-course",
    title: "Best Free Python Course (2026)",
    seoTitle: "Best Free Python Course (2026) - Complete Beginner to Advanced",
    seoDescription: "Learn Python programming for free. Curated YouTube courses covering syntax, OOP, data structures, automation, and AI development.",
    h1: "Best Free Python Courses & Full Tutorials",
    badge: "Python 3 2026",
    topicName: "Python",
    keywords: ["python", "python 3", "scripting", "backend", "pandas"],
    categoryMatch: ["Coding Skills", "Python", "Software Engineering"],
    introText: "Python is the ultimate programming language for artificial intelligence, web development, data science, and automation. Access handpicked free YouTube Python courses designed for absolute beginners and advanced developers.",
    prerequisites: "No prior programming experience required",
    estimatedHours: "15-50 Hours",
    faqs: [
      {
        question: "Is Python difficult to learn for beginners?",
        answer: "No, Python is widely considered the most beginner-friendly programming language due to its clean, readable syntax that resembles plain English."
      },
      {
        question: "What career paths open up after learning Python?",
        answer: "Python skills open doors to AI Engineering, Data Science, Machine Learning, Web Backend Development (Django/FastAPI), and DevOps Automation."
      }
    ]
  },
  "ai": {
    slug: "ai",
    pageUrl: "/best-free-ai-course",
    title: "Best Free AI Course (2026)",
    seoTitle: "Best Free AI Course (2026) - Master AI Engineering & LLMs",
    seoDescription: "Discover top free YouTube AI Engineering courses. Master LLMs, LangChain, PyTorch, Prompt Engineering, and RAG pipelines for free.",
    h1: "Best Free Artificial Intelligence & AI Engineering Courses",
    badge: "AI & LLMs 2026",
    topicName: "AI Engineering",
    keywords: ["ai", "artificial intelligence", "langchain", "pytorch", "llm", "prompt engineering"],
    categoryMatch: ["AI Engineering", "Machine Learning", "Deep Learning"],
    introText: "Artificial Intelligence and Generative AI are transforming the tech landscape. Our editorial team curated the highest-rated free YouTube AI tutorials covering LLM agentic workflows, PyTorch deep learning, and vector databases.",
    prerequisites: "Basic Python programming understanding",
    estimatedHours: "25-60 Hours",
    faqs: [
      {
        question: "What is the difference between AI Engineering and Data Science?",
        answer: "AI Engineering focuses on building autonomous systems, fine-tuning LLMs, and integrating AI APIs into production software, whereas Data Science focuses on statistical analysis."
      },
      {
        question: "Are these AI courses suitable for developers?",
        answer: "Yes, our curated courses emphasize hands-on code, vector databases (ChromaDB/Pinecone), agent tool-calling, and real PyTorch/LangChain implementations."
      }
    ]
  },
  "dsa": {
    slug: "dsa",
    pageUrl: "/best-free-dsa-course",
    title: "Best Free DSA Course (2026)",
    seoTitle: "Best Free DSA Course (2026) - Data Structures & Algorithms",
    seoDescription: "Master Data Structures & Algorithms for free. Complete YouTube video roadmaps for tech interviews, LeetCode problem solving, and big tech coding prep.",
    h1: "Best Free DSA (Data Structures & Algorithms) Courses",
    badge: "DSA & Interview Prep",
    topicName: "Data Structures & Algorithms",
    keywords: ["dsa", "data structures", "algorithms", "leetcode", "arrays", "trees", "graphs"],
    categoryMatch: ["Coding Skills", "Computer Science"],
    introText: "Data Structures and Algorithms form the foundation of computer science and technical interview preparation for top tech companies. Access handpicked YouTube DSA series covering arrays, linked lists, trees, graphs, and dynamic programming.",
    prerequisites: "Familiarity with any programming language (Python, C++, Java, or JavaScript)",
    estimatedHours: "40-80 Hours",
    faqs: [
      {
        question: "Which programming language is best for learning DSA?",
        answer: "C++, Java, and Python are the most popular choices. C++ and Java offer strong memory management understanding, while Python allows fast pseudo-code implementation during interviews."
      },
      {
        question: "How long does it take to master DSA for coding interviews?",
        answer: "With consistent daily practice (1-2 hours), most learners build strong DSA fundamentals in 3 to 6 months."
      }
    ]
  },
  "java": {
    slug: "java",
    pageUrl: "/best-free-java-course",
    title: "Best Free Java Course (2026)",
    seoTitle: "Best Free Java Course (2026) - Master Java & Spring Boot Free",
    seoDescription: "Learn Java programming for free. Handpicked YouTube tutorials covering OOP principles, Java syntax, Spring Boot microservices, and enterprise development.",
    h1: "Best Free Java Programming Courses",
    badge: "Java & Enterprise",
    topicName: "Java",
    keywords: ["java", "spring boot", "oop", "backend"],
    categoryMatch: ["Coding Skills", "Backend Development"],
    introText: "Java is one of the most widely used enterprise programming languages in the world. Master core Java, object-oriented programming (OOP), collections, and Spring Boot for free with top YouTube courses.",
    prerequisites: "No prior experience required for basic Java courses",
    estimatedHours: "30-60 Hours",
    faqs: [
      {
        question: "Is Java still relevant in 2026?",
        answer: "Yes, Java remains a dominant enterprise language powering banking, Android development, cloud backends, and large-scale microservices."
      },
      {
        question: "What projects should I build with Java?",
        answer: "Start with CLI utilities, then build REST APIs with Spring Boot, relational database integrations (Hibernate/JPA), and full-stack web applications."
      }
    ]
  }
};

const { slug } = Astro.params;
const topicKey = slug ? slug.toLowerCase().replace(/^react-?course$/, 'react') : '';
const topic = seoTopicsConfig[topicKey] || seoTopicsConfig['react'];

if (!topicKey || !seoTopicsConfig[topicKey]) {
  // If slug is not recognized, fallback to react guide
}

const allCourses = await getAllCourses();

// Filter courses matching the topic
const matchingCourses = allCourses.filter((course) => {
  const titleLower = course.title.toLowerCase();
  const catLower = course.category.toLowerCase();
  const toolsLower = (course.tools || []).map(t => t.toLowerCase());
  const overviewLower = (course.overview || '').toLowerCase();

  return topic.keywords.some(kw => 
    titleLower.includes(kw) || 
    catLower.includes(kw) || 
    toolsLower.includes(kw) || 
    overviewLower.includes(kw)
  );
});

const displayCourses = matchingCourses.length > 0 ? matchingCourses : allCourses.slice(0, 4);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": topic.h1,
  "description": topic.seoDescription,
  "itemListElement": displayCourses.map((c, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Course",
      "name": c.title,
      "description": c.description || (c.overview ? c.overview.slice(0, 160) : c.title),
      "provider": {
        "@type": "Organization",
        "name": c.creatorName
      }
    }
  }))
};
---

<Layout 
  title={topic.seoTitle} 
  description={topic.seoDescription}
  ogImage="/og-banner.jpg"
  ogType="website"
>
  <!-- Schema.org JSON-LD Script -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Hero Banner Section -->
    <header class="bg-gradient-to-b from-canvas-soft via-canvas to-canvas-soft border border-hairline rounded-md p-6 sm:p-10 mb-12 relative overflow-hidden">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-3xl space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 border border-primary/30 bg-primary/10 px-3 py-1 rounded-pill">
          <span class="h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          <span class="font-mono text-xs text-primary uppercase font-bold tracking-wider">
            {topic.badge}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink-strong tracking-tight leading-tight">
          {topic.h1}
        </h1>

        <p class="text-sm sm:text-base text-body font-light leading-relaxed">
          {topic.introText}
        </p>

        <!-- Topic Metadata Chips -->
        <div class="pt-4 flex flex-wrap gap-4 text-xs font-mono text-mute border-t border-hairline/60">
          <div class="flex items-center gap-1.5 bg-canvas/60 px-3 py-1.5 rounded border border-hairline">
            <span class="text-primary font-bold">Prerequisites:</span>
            <span class="text-ink">{topic.prerequisites}</span>
          </div>
          <div class="flex items-center gap-1.5 bg-canvas/60 px-3 py-1.5 rounded border border-hairline">
            <span class="text-primary font-bold">Est. Time:</span>
            <span class="text-ink">{topic.estimatedHours}</span>
          </div>
          <div class="flex items-center gap-1.5 bg-canvas/60 px-3 py-1.5 rounded border border-hairline">
            <span class="text-primary font-bold">Cost:</span>
            <span class="text-primary uppercase font-bold">100% Free</span>
          </div>
        </div>
      </div>
    </header>

    <!-- SEO Category Navigation Switcher -->
    <nav class="mb-10 border-b border-hairline pb-4 flex items-center gap-2 overflow-x-auto" aria-label="SEO Guides">
      <span class="text-xs font-mono uppercase text-mute font-bold shrink-0 mr-2">Top Free Guides:</span>
      {Object.values(seoTopicsConfig).map((item) => (
        <a 
          href={item.pageUrl} 
          class={`text-xs font-mono px-3.5 py-1.5 rounded-sm transition-all shrink-0 cursor-pointer border ${item.slug === topic.slug ? 'bg-primary text-on-primary font-bold border-primary' : 'bg-canvas-soft text-body hover:text-ink hover:border-primary/40 border-hairline'}`}
        >
          {item.title}
        </a>
      ))}
    </nav>

    <!-- Section Heading -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 border-b border-hairline pb-4">
      <div>
        <h2 class="text-xl font-bold text-ink-strong font-mono uppercase tracking-wider">
          Curated {topic.topicName} Courses ({displayCourses.length})
        </h2>
        <p class="text-xs text-mute font-light mt-1">
          Handpicked step-by-step YouTube masterclasses & video roadmaps.
        </p>
      </div>

      <a 
        href="/courses" 
        class="text-xs font-mono text-primary hover:underline flex items-center gap-1 shrink-0"
      >
        View All Courses &rarr;
      </a>
    </div>

    <!-- Course Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {displayCourses.map((course) => (
        <article 
          class="course-card group bg-canvas-soft border border-hairline rounded-md flex flex-col justify-between hover:border-primary/45 transition-all duration-300 relative overflow-hidden h-full cursor-pointer"
          data-slug={course.slug}
        >
          <!-- Thumbnail -->
          <div class="relative aspect-video w-full overflow-hidden border-b border-hairline bg-canvas">
            <img 
              src={getYoutubeThumbnail(course.sampleVideoId)} 
              alt={`${course.title} thumbnail`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <!-- Always-Visible Watch Later Button Overlay -->
            <button 
              type="button" 
              class="watch-later-toggle-btn absolute top-2.5 left-2.5 z-30 bg-canvas/95 hover:bg-primary hover:text-on-primary text-ink px-2.5 py-1 rounded-sm transition-all shadow-md focus:outline-none cursor-pointer border border-hairline hover:border-primary flex items-center gap-1.5 text-[11px] font-mono"
              data-slug={course.slug}
              title="Save to Watch Later"
            >
              <svg class="h-3.5 w-3.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="wl-label pointer-events-none">Watch later</span>
            </button>
            <span class={`absolute top-3 right-3 text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-sm font-semibold shadow-md ${course.type === 'paid' ? 'bg-amber-400 text-on-primary border border-amber-500/20' : 'bg-primary text-on-primary border border-primary-soft/20'}`}>
              {course.type || 'free'}
            </span>
            <!-- Modules Count Overlay Badge -->
            <div class="absolute bottom-2.5 right-2.5 z-20 bg-canvas/90 backdrop-blur-sm text-ink-strong border border-hairline px-2 py-0.5 rounded-sm text-[10px] font-mono flex items-center gap-1.5 shadow-md">
              <svg class="h-3 w-3 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>{course.chapters?.length || 1} Modules</span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col justify-between flex-grow">
            <div>
              <div class="flex justify-between items-center mb-3">
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] font-mono uppercase bg-canvas border border-hairline px-2.5 py-0.5 rounded-pill text-body">
                    {course.category}
                  </span>
                  <span class="text-[10px] font-mono uppercase bg-canvas border border-hairline/85 px-2 py-0.5 rounded-sm text-mute">
                    {course.language || 'English'}
                  </span>
                </div>
                <span class="text-xs font-mono text-mute">{course.duration}</span>
              </div>

              <h3 class="text-base font-semibold text-ink-strong mb-2.5 group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                <a href={`/courses/${course.slug}`} class="focus:outline-none after:absolute after:inset-0">
                  {course.title}
                </a>
              </h3>

              <a href={`/creators/${getCreatorSlug(course.creatorName)}`} class="flex items-center gap-2 hover:text-primary transition-colors group/creator shrink-0 relative z-30">
                <img 
                  src={course.creatorLogo} 
                  alt={course.creatorName} 
                  class="h-6 w-6 rounded-full object-cover border border-hairline shrink-0"
                />
                <div class="flex flex-col">
                  <span class="text-xs font-mono text-mute group-hover/creator:text-primary transition-colors leading-none">{course.creatorName}</span>
                  <span class="text-[9px] font-mono text-mute/50 leading-none mt-1">{course.creatorSubscribers || "Verified Channel"}</span>
                </div>
              </a>
            </div>

            <!-- Card Footer with Watch Now Button -->
            <div class="pt-3.5 border-t border-hairline flex justify-between items-center text-[11px] font-mono text-mute mt-4">
              <span class="text-xs text-mute font-mono">Curated Course</span>
              <a 
                href={`/courses/${course.slug}`}
                class="inline-flex items-center gap-1.5 bg-primary/10 hover:bg-primary border border-primary/30 hover:border-primary text-primary hover:text-on-primary px-3.5 py-1.5 rounded-sm text-xs font-mono font-bold uppercase transition-all duration-200 cursor-pointer relative z-30 shrink-0 shadow-sm group/btn"
              >
                <span>Watch Now</span>
                <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Editorial Guide & Learning Roadmap Section (SEO Content Layer) -->
    <section class="bg-canvas-soft border border-hairline rounded-md p-6 sm:p-10 mb-16 space-y-8">
      <div class="border-b border-hairline pb-4">
        <h2 class="text-2xl font-bold text-ink-strong tracking-tight">
          How to Master {topic.topicName} for Free in 2026
        </h2>
        <p class="text-xs font-mono text-mute mt-1">
          Editorial guide & step-by-step self-learning roadmap.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-body leading-relaxed font-light">
        <div class="space-y-3 bg-canvas/40 p-5 rounded border border-hairline">
          <div class="flex items-center gap-2 text-primary font-mono font-bold text-xs uppercase">
            <span class="h-6 w-6 rounded-full bg-primary/10 flex items-center justify-center">1</span>
            <span>Step 1: Core Fundamentals</span>
          </div>
          <p class="text-xs">
            Start by mastering the core syntax, essential concepts, and prerequisites before jumping into frameworks or complex projects.
          </p>
        </div>

        <div class="space-y-3 bg-canvas/40 p-5 rounded border border-hairline">
          <div class="flex items-center gap-2 text-primary font-mono font-bold text-xs uppercase">
            <span class="h-6 w-6 rounded-full bg-primary/10 flex items-center justify-center">2</span>
            <span>Step 2: Hands-On Practice</span>
          </div>
          <p class="text-xs">
            Follow the modular YouTube course lessons side-by-side in your code editor. Build smaller mini-projects as you progress.
          </p>
        </div>

        <div class="space-y-3 bg-canvas/40 p-5 rounded border border-hairline">
          <div class="flex items-center gap-2 text-primary font-mono font-bold text-xs uppercase">
            <span class="h-6 w-6 rounded-full bg-primary/10 flex items-center justify-center">3</span>
            <span>Step 3: Capstone Portfolio</span>
          </div>
          <p class="text-xs">
            Combine your skills to build a complete real-world application or project portfolio ready to showcase to recruiters.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="max-w-4xl mx-auto space-y-6 mb-16">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-ink-strong tracking-tight">
          Frequently Asked Questions ({topic.topicName})
        </h2>
        <p class="text-xs text-mute font-mono uppercase tracking-wider">
          Got questions about learning {topic.topicName}?
        </p>
      </div>

      <div class="space-y-4">
        {topic.faqs.map((faq) => (
          <details class="group bg-canvas-soft border border-hairline rounded-md p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-ink-strong text-sm">
              <span>{faq.question}</span>
              <span class="ml-4 shrink-0 text-mute group-open:-rotate-180 transition-transform">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-xs text-body leading-relaxed font-light border-t border-hairline/40 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>

  </main>
</Layout>
